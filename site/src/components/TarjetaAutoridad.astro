---
import { cargoDeAutoridad, nombreComuna, nombrePartido, fotoAutoridad, type Autoridad } from '../lib/datos';

interface Props {
	autoridad: Autoridad;
}

const { autoridad: a } = Astro.props;
const foto = fotoAutoridad(a.id);
const partido = a.partido ? nombrePartido(a.partido) : null;

function iniciales(nombre: string) {
	const partes = nombre.split(' ').filter(Boolean);
	return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
}
---

<li
	class="fila-autoridad rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
	data-cargo={a.cargo}
	data-comuna={a.comuna ?? ''}
	data-partido={partido ?? ''}
	data-circunscripcion={a.circunscripcion ?? ''}
>
	<a href={`/autoridades/${a.id}/`} class="flex items-start gap-3">
		{foto ? (
			<img src={foto} alt={a.nombre_completo} class="h-10 w-10 shrink-0 rounded-full border-2 border-slate-100 object-cover" />
		) : (
			<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-slate-100 bg-brand-50 text-sm font-bold text-brand-700">
				{iniciales(a.nombre_completo)}
			</span>
		)}
		<span>
			<p class="font-semibold text-slate-900">{a.nombre_completo}</p>
			<p class="mt-1 text-sm text-slate-600">
				{cargoDeAutoridad(a)}
				{a.comuna && ` · ${nombreComuna(a.comuna)}`}
				{partido && ` · ${partido}`}
			</p>
		</span>
	</a>
</li>
