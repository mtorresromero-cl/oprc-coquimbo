---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Datos abiertos sobre autoridades, parlamentarios y transparencia municipal de la Región de Coquimbo.',
} = Astro.props;

const DATOS_ITEMS = [
	{ href: '/autoridades/', label: 'Autoridades' },
	{ href: '/municipios/', label: 'Municipios' },
	{ href: '/parlamentarios/', label: 'Parlamentarios' },
	{ href: '/consejo-regional/', label: 'Consejo Regional' },
	{ href: '/dashboard/', label: 'Dashboard de Participación' },
	{ href: '/mapa/', label: 'Mapa de la Región' },
];

const NAV = [
	{ href: '/infografias/', label: 'Infografías' },
	{ href: '/herramientas/', label: 'Herramientas' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/nosotros/', label: 'Nosotros' },
	{ href: '/contacto/', label: 'Contacto' },
];

const REDES = [
	{ nombre: 'Instagram', url: 'https://instagram.com/oprcoquimbo' },
	{ nombre: 'Facebook', url: 'https://facebook.com/oprcoquimbo' },
	{ nombre: 'Twitter', url: 'https://twitter.com/oprcoquimbo' },
];

const path = Astro.url.pathname;
function activo(href: string) {
	return href === '/' ? path === '/' : path.startsWith(href);
}
const datosActivo = DATOS_ITEMS.some((item) => activo(item.href));
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og-image.png" />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-900">
		<div class="bg-slate-900 text-slate-300">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2 text-xs">
				<a href="mailto:contacto@oprcoquimbo.cl" class="hover:text-white">contacto@oprcoquimbo.cl</a>
				<div class="flex gap-4">
					{REDES.map((r) => (
						<a href={r.url} target="_blank" rel="noopener" class="hover:text-white">{r.nombre}</a>
					))}
				</div>
			</div>
		</div>

		<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
			<div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<a href="/" class="flex items-center">
					<img src="/logo-oprc-color.png" alt="OPRC — Observatorio Político Región de Coquimbo" class="h-12 w-auto sm:h-14" />
				</a>
				<nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold tracking-wide text-slate-600 uppercase">
					<details class="group relative">
						<summary
							class={`flex cursor-pointer list-none items-center gap-1 transition-colors hover:text-brand-600 [&::-webkit-details-marker]:hidden ${
								datosActivo ? 'text-brand-600' : ''
							}`}
						>
							Datos <span class="text-[10px]">▾</span>
						</summary>
						<div class="absolute left-0 top-full z-10 mt-3 w-48 rounded-md border border-slate-100 bg-white py-1 normal-case shadow-lg">
							{DATOS_ITEMS.map((item) => (
								<a
									href={item.href}
									class={`block px-4 py-2 text-sm font-medium tracking-normal hover:bg-brand-50 ${activo(item.href) ? 'text-brand-700' : 'text-slate-700'}`}
								>
									{item.label}
								</a>
							))}
						</div>
					</details>
					{NAV.map((item) => (
						<a
							href={item.href}
							class={`transition-colors hover:text-brand-600 ${activo(item.href) ? 'text-brand-600' : ''}`}
						>
							{item.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<div class="flex-1">
			<slot />
		</div>

		<footer class="bg-slate-900 text-slate-400">
			<div class="mx-auto max-w-6xl px-6 py-12">
				<div class="grid gap-10 sm:grid-cols-3">
					<div>
						<img src="/logo-oprc-blanco.png" alt="OPRC" class="h-16 w-auto" />
						<p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
							Información y herramientas de análisis, seguimiento e investigación en materia
							política, trabajo de autoridades, elecciones y partidos políticos de la Región de
							Coquimbo.
						</p>
					</div>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">Secciones</p>
						<ul class="mt-3 space-y-2 text-sm">
							{DATOS_ITEMS.map((item) => (
								<li><a href={item.href} class="hover:text-white">{item.label}</a></li>
							))}
							<li><a href="/nosotros/" class="hover:text-white">Nosotros</a></li>
						</ul>
					</div>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">Contacto</p>
						<ul class="mt-3 space-y-2 text-sm">
							<li><a href="mailto:contacto@oprcoquimbo.cl" class="hover:text-white">contacto@oprcoquimbo.cl</a></li>
							{REDES.map((r) => (
								<li><a href={r.url} target="_blank" rel="noopener" class="hover:text-white">{r.nombre}</a></li>
							))}
							<li>
								<a
									href="https://github.com/mtorresromero-cl/oprc-coquimbo"
									target="_blank"
									rel="noopener"
									class="hover:text-white"
								>
									Código en GitHub
								</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="mt-10 border-t border-slate-800 pt-6 text-xs text-slate-500">
					Datos públicos recopilados de fuentes oficiales (SERVEL, Cámara de Diputados, Senado,
					Portal de Transparencia). Proyecto independiente, sin fines de lucro.
				</div>
			</div>
		</footer>
	</body>
</html>
