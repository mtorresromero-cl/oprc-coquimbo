---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Datos abiertos sobre autoridades, parlamentarios y transparencia municipal de la Región de Coquimbo.',
} = Astro.props;

const DATOS_ITEMS = [
	{ href: '/autoridades/', label: 'Autoridades' },
	{ href: '/municipios/', label: 'Municipios' },
	{ href: '/consejo-regional/', label: 'Consejo Regional' },
	{ href: '/parlamentarios/', label: 'Parlamentarios' },
	{ href: '/herramientas/electoral/', label: 'Electorales' },
	{ href: '/mapa/', label: 'Mapa de la Región' },
];

const annoActual = new Date().getFullYear();

const NAV = [
	{ href: '/infografias/', label: 'Infografías' },
	{ href: '/herramientas/', label: 'Herramientas' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/nosotros/', label: 'Nosotros' },
	{ href: '/contacto/', label: 'Contacto' },
];

const ELECTORAL_ITEMS = [
	{ href: '/herramientas/electoral/resultados/', label: 'Resultados Electorales' },
	{ href: '/herramientas/participacion-electoral/', label: 'Participación Electoral' },
	{ href: '/herramientas/electoral/plebiscitos/', label: 'Plebiscitos' },
	{ href: '/herramientas/electoral/comuna/', label: 'Explorador por Comuna' },
	{ href: '/herramientas/electoral/comparador/', label: 'Comparador entre Comunas' },
	{ href: '/herramientas/electoral/padron/', label: 'Padrón Electoral' },
];

const REDES = [
	{ nombre: 'Instagram', url: 'https://instagram.com/oprcoquimbo', icono: 'instagram' },
	{ nombre: 'Facebook', url: 'https://facebook.com/oprcoquimbo', icono: 'facebook' },
	{ nombre: 'X (Twitter)', url: 'https://x.com/oprcoquimbo', icono: 'x' },
];

// mismos íconos que usa clavepolitica.redcomunales.cl (otro sitio de
// Red Comunales), copiados directamente de su HTML para mantener
// consistencia visual entre ambos sitios.
const ICONOS_REDES_SVG: Record<string, { viewBox: string; path: string }> = {
	instagram: {
		viewBox: '0 0 448 512',
		path: "M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z",
	},
	facebook: {
		viewBox: '0 0 512 512',
		path: 'M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z',
	},
	x: {
		viewBox: '0 0 24 24',
		path: 'M18.244 2.25H21.552L14.325 10.51L22.827 21.75H16.17L10.956 14.933L4.99 21.75H1.68L9.41 12.915L1.254 2.25H8.08L12.793 8.481L18.244 2.25ZM17.083 19.77H18.916L7.084 4.126H5.117L17.083 19.77Z',
	},
};

const path = Astro.url.pathname;
function activo(href: string) {
	return href === '/' ? path === '/' : path.startsWith(href);
}
const datosActivo = DATOS_ITEMS.some((item) => activo(item.href));
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og-image.png" />
		<meta property="og:type" content="website" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FQ0D5ZJBZW"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-FQ0D5ZJBZW');
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-900">
		<div class="bg-slate-900 text-slate-300">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-[18.4px] gap-y-[4.6px] px-6 py-[9.2px] text-[13.8px]">
				<a href="mailto:contacto@oprcoquimbo.cl" class="hover:text-white">contacto@oprcoquimbo.cl</a>
				<div class="flex gap-[18.4px]">
					{REDES.map((r) => (
						<a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre} class="hover:text-white">
							<svg viewBox={ICONOS_REDES_SVG[r.icono].viewBox} fill="currentColor" class="h-[18.4px] w-[18.4px]">
							<path d={ICONOS_REDES_SVG[r.icono].path} />
						</svg>
						</a>
					))}
				</div>
			</div>
		</div>

		<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
			<div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<a href="/" class="flex items-center">
					<img src="/logo-oprc-color.png" alt="OPRC — Observatorio Político Región de Coquimbo" class="h-12 w-auto sm:h-14" />
				</a>
				<nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold tracking-wide text-slate-600 uppercase">
					<details class="group relative" id="datos-dropdown">
						<summary
							class={`flex cursor-pointer list-none items-center gap-1 transition-colors hover:text-brand-600 [&::-webkit-details-marker]:hidden ${
								datosActivo ? 'text-brand-600' : ''
							}`}
						>
							Datos <span class="text-[10px]">▾</span>
						</summary>
						<div class="absolute left-0 top-full z-10 mt-3 w-48 rounded-md border border-slate-100 bg-white py-1 normal-case shadow-lg">
							{DATOS_ITEMS.map((item) => (
								<a
									href={item.href}
									class={`block px-4 py-2 text-sm font-medium tracking-normal hover:bg-brand-50 ${activo(item.href) ? 'text-brand-700' : 'text-slate-700'}`}
								>
									{item.label}
								</a>
							))}
						</div>
					</details>
					{NAV.map((item) => (
						<a
							href={item.href}
							class={`transition-colors hover:text-brand-600 ${activo(item.href) ? 'text-brand-600' : ''}`}
						>
							{item.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<div class="flex-1 pb-10 sm:pb-16">
			<slot />
			{datosActivo && (
				<div class="mx-auto mt-14 max-w-6xl px-6">
					<div class="flex flex-col items-start justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 sm:flex-row sm:items-center">
						<p>¿Hay un error en los datos de esta página? Avísanos y lo revisamos.</p>
						<a
							href={`/contacto/?asunto=error-datos&pagina=${encodeURIComponent(path)}`}
							class="shrink-0 rounded-md bg-amber-600 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-700"
						>
							Reportar un error
						</a>
					</div>
				</div>
			)}
		</div>

		<footer class="bg-slate-900 text-slate-400">
			<div class="mx-auto max-w-6xl px-6 py-12">
				<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5">
					<div class="sm:col-span-2 lg:col-span-2">
						<a href="/">
							<img src="/logo-oprc-blanco.png" alt="OPRC" class="h-12 w-auto sm:h-14" />
						</a>
						<p class="mt-4 max-w-xs text-[13px] leading-relaxed text-slate-400">
							Información y herramientas de análisis, seguimiento e investigación en materia
							política, trabajo de autoridades, elecciones y partidos políticos de la Región de
							Coquimbo.
						</p>
						<div class="mt-8">
							<a href="mailto:contacto@oprcoquimbo.cl" class="text-sm hover:text-white">contacto@oprcoquimbo.cl</a>
							<div class="mt-3 flex gap-4">
								{REDES.map((r) => (
									<a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre} class="text-slate-400 hover:text-white">
										<svg viewBox={ICONOS_REDES_SVG[r.icono].viewBox} fill="currentColor" class="h-5 w-5">
										<path d={ICONOS_REDES_SVG[r.icono].path} />
									</svg>
									</a>
								))}
							</div>
						</div>
					</div>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">Secciones</p>
						<ul class="mt-3 space-y-2 text-sm">
							{NAV.map((item) => (
								<li><a href={item.href} class="hover:text-white">{item.label}</a></li>
							))}
						</ul>
					</div>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">Datos</p>
						<ul class="mt-3 space-y-2 text-sm">
							{DATOS_ITEMS.map((item) => (
								<li><a href={item.href} class="hover:text-white">{item.label}</a></li>
							))}
							<li>
								<a
									href="https://github.com/mtorresromero-cl/oprc-coquimbo"
									target="_blank"
									rel="noopener"
									class="hover:text-white"
								>
									GitHub
								</a>
							</li>
						</ul>
					</div>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-200 uppercase">Archivo Electoral</p>
						<ul class="mt-3 space-y-2 text-sm">
							{ELECTORAL_ITEMS.map((item) => (
								<li><a href={item.href} class="hover:text-white">{item.label}</a></li>
							))}
						</ul>
					</div>
				</div>
				<div class="mt-10 border-t border-slate-800 pt-6 text-xs text-slate-500">
					<p>&copy; {annoActual} OPRC — Observatorio Político Región de Coquimbo. Todos los derechos reservados.</p>
					<p class="mt-2">
						Sitio creado por Miguel Torres Romero. Datos verificados cruzando fuentes oficiales;
						análisis y desarrollo con apoyo de IA. Proyecto independiente, sin fines de lucro.
					</p>
				</div>
			</div>
		</footer>

		<script>
			// en desktop, el menú "Datos" se abre/cierra con el mouse — en
			// touch (sin hover real) se deja el comportamiento nativo de
			// <details> por click, que es el único que funciona ahí
			const dd = document.getElementById('datos-dropdown') as HTMLDetailsElement | null;
			if (dd && window.matchMedia('(hover: hover)').matches) {
				let cerrar: ReturnType<typeof setTimeout>;
				dd.addEventListener('mouseenter', () => {
					clearTimeout(cerrar);
					dd.open = true;
				});
				dd.addEventListener('mouseleave', () => {
					cerrar = setTimeout(() => { dd.open = false; }, 150);
				});
			}
		</script>
	</body>
</html>
