---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Datos abiertos sobre autoridades, parlamentarios y transparencia municipal de la Región de Coquimbo.',
} = Astro.props;

const DATOS_ITEMS = [
	{ href: '/autoridades/', label: 'Autoridades' },
	{ href: '/municipios/', label: 'Municipios' },
	{ href: '/parlamentarios/', label: 'Parlamentarios' },
];

const NAV = [
	{ href: '/infografias/', label: 'Infografías' },
	{ href: '/herramientas/', label: 'Herramientas' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/nosotros/', label: 'Nosotros' },
	{ href: '/contacto/', label: 'Contacto' },
];

const path = Astro.url.pathname;
function activo(href: string) {
	return href === '/' ? path === '/' : path.startsWith(href);
}
const datosActivo = DATOS_ITEMS.some((item) => activo(item.href));
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og-image.png" />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-900">
		<header class="bg-brand-600">
			<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
				<a href="/" class="flex items-center gap-2">
					<img src="/logo-oprc-blanco.png" alt="OPRC" class="h-7 w-auto" />
					<span class="hidden text-xs font-medium text-brand-100 sm:inline">
						Región de Coquimbo
					</span>
				</a>
				<nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
					<details class="group relative">
						<summary
							class={`cursor-pointer list-none transition-colors hover:text-white [&::-webkit-details-marker]:hidden ${
								datosActivo ? 'text-white underline underline-offset-4' : 'text-brand-100'
							}`}
						>
							Datos <span class="text-xs">▾</span>
						</summary>
						<div class="absolute left-0 top-full z-10 mt-2 w-48 rounded-md bg-white py-1 text-slate-900 shadow-lg ring-1 ring-black/5">
							{DATOS_ITEMS.map((item) => (
								<a
									href={item.href}
									class={`block px-4 py-2 text-sm hover:bg-brand-50 ${activo(item.href) ? 'font-semibold text-brand-700' : ''}`}
								>
									{item.label}
								</a>
							))}
						</div>
					</details>
					{NAV.map((item) => (
						<a
							href={item.href}
							class={`transition-colors hover:text-white ${
								activo(item.href) ? 'text-white underline underline-offset-4' : 'text-brand-100'
							}`}
						>
							{item.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<div class="flex-1">
			<slot />
		</div>

		<footer class="border-t border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-5xl px-6 py-8 text-sm text-slate-500">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<img src="/logo-oprc-color.png" alt="OPRC" class="h-6 w-auto opacity-80" />
					<p class="max-w-md text-xs leading-relaxed">
						Datos públicos recopilados de fuentes oficiales (SERVEL, Cámara de Diputados, Senado,
						Portal de Transparencia). Proyecto independiente, sin fines de lucro.
					</p>
					<a
						href="https://github.com/mtorresromero-cl/oprc-coquimbo"
						target="_blank"
						rel="noopener"
						class="text-xs font-medium text-slate-600 hover:text-brand-600 hover:underline"
					>
						Código en GitHub
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
