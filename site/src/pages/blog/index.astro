---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

function formatoFecha(fecha: Date) {
	return fecha.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Blog — OPRC" description="Análisis y artículos del Observatorio Político Región de Coquimbo.">
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Observatorio Político Región de Coquimbo</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">Blog</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Análisis y artículos del Observatorio Político Región de Coquimbo sobre la actualidad
				política y administrativa de la región.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		{posts.length === 0 && (
			<div class="rounded-xl border-2 border-dashed border-slate-200 px-6 py-16 text-center">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-8 w-8 text-slate-300">
					<path d="M14 3v5a2 2 0 0 0 2 2h5M6 3h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
					<path d="M9 13h6M9 17h4"></path>
				</svg>
				<p class="mt-4 text-base font-semibold text-slate-700">Todavía no hay publicaciones</p>
				<p class="mt-1.5 text-sm text-slate-500">
					Estamos preparando los primeros análisis. Vuelve pronto.
				</p>
			</div>
		)}

		<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => (
				<li class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md">
					<a href={`/blog/${post.id}/`}>
						<p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">{formatoFecha(post.data.fecha)}</p>
						<h2 class="mt-2 text-lg font-bold tracking-tight text-slate-900">{post.data.titulo}</h2>
						<p class="mt-2 text-base leading-relaxed text-slate-600">{post.data.resumen}</p>
						<span class="mt-4 inline-block text-sm font-semibold text-brand-600">Leer más &rarr;</span>
					</a>
				</li>
			))}
		</ul>
	</main>
</Layout>
