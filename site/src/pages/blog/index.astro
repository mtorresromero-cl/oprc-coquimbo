---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

function formatoFecha(fecha: Date) {
	return fecha.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Blog — OPRC" description="Análisis y artículos del Observatorio Político Región de Coquimbo.">
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Blog</h1>
			<p class="mt-2 max-w-2xl text-slate-600">Análisis y artículos del Observatorio Político Región de Coquimbo.</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		{posts.length === 0 && (
			<p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-base text-slate-500">
				Todavía no hay publicaciones. Vuelve pronto.
			</p>
		)}

		<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => (
				<li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md">
					<a href={`/blog/${post.id}/`}>
						<p class="text-xs text-slate-500">{formatoFecha(post.data.fecha)}</p>
						<h2 class="mt-1 text-lg font-semibold text-slate-900">{post.data.titulo}</h2>
						<p class="mt-2 text-base text-slate-600">{post.data.resumen}</p>
					</a>
				</li>
			))}
		</ul>
	</main>
</Layout>
