---
import Layout from '../layouts/Layout.astro';

const capacidades = [
	'Investigación y Análisis',
	'Comunicación y Estrategia',
	'Desarrollo de Estudios y Reportes',
	'Divulgación y Participación Ciudadana',
];

const loQueHacen = [
	{
		emoji: '📥',
		titulo: 'Acceso a Información Pública',
		texto: 'Analizamos y organizamos datos relevantes sobre el quehacer político en la Región de Coquimbo. Nuestro objetivo es ofrecer información accesible y comprensible para que la ciudadanía tome decisiones informadas.',
		tono: 'blue',
	},
	{
		emoji: '📊',
		titulo: 'Evaluación de Gestión y Desempeño',
		texto: 'Hacemos seguimiento al trabajo de autoridades y representantes regionales, midiendo su impacto y cumplimiento de compromisos. A través de nuestros estudios y reportes, promovemos la rendición de cuentas.',
		tono: 'emerald',
	},
	{
		emoji: '📡',
		titulo: 'Monitoreo en Tiempo Real',
		texto: 'Aportamos análisis actualizado de los principales acontecimientos políticos y administrativos de la región. Nuestro monitoreo permite identificar tendencias y cambios clave en la gestión pública.',
		tono: 'violet',
		enVivo: true,
	},
	{
		emoji: '🌐',
		titulo: 'Gestión y Participación Ciudadana',
		texto: 'Facilitamos herramientas para el control ciudadano y el debate informado. Creemos en la participación activa como pilar fundamental para una democracia más fuerte y transparente.',
		tono: 'amber',
	},
];

const TONOS: Record<string, { bg: string; ring: string }> = {
	blue: { bg: 'bg-blue-50', ring: 'ring-blue-100' },
	emerald: { bg: 'bg-emerald-50', ring: 'ring-emerald-100' },
	violet: { bg: 'bg-violet-50', ring: 'ring-violet-100' },
	amber: { bg: 'bg-amber-50', ring: 'ring-amber-100' },
};
---

<Layout
	title="Nosotros — OPRC"
	description="Quiénes somos: el Observatorio Político Región de Coquimbo, su misión, financiamiento y metodología."
>
	<div class="relative overflow-hidden bg-brand-50">
		<div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 animate-blob rounded-full bg-brand-100/70 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-32 left-10 h-72 w-72 animate-blob rounded-full bg-brand-200/50 blur-3xl [animation-delay:-4s]"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-16">
			<p class="text-sm font-semibold tracking-widest text-brand-600 uppercase">Nosotros</p>
			<h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
				Quiénes somos
			</h1>
			<p class="mt-4 max-w-2xl text-lg text-slate-600">
				Cómo nos financiamos y la metodología detrás de los datos que publicamos.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-14">
		<div class="grid gap-10 lg:grid-cols-[1fr_18rem]">
			<div>
				<section>
					<p class="leading-relaxed text-slate-700">
						El Observatorio Político Región de Coquimbo nació en 2019 con el objetivo de brindar
						información y herramientas de análisis sobre la política regional. Nuestro trabajo se
						centra en el seguimiento, investigación y previsión de elecciones, partidos políticos y
						la labor de autoridades, promoviendo una visión crítica e informada que permita
						comprender y actuar en el escenario político local.
					</p>
					<p class="mt-4 leading-relaxed text-slate-700">
						Nos ponemos al servicio de la comunidad a través de una plataforma dinámica e
						interactiva, monitoreando y analizando la gestión comunal y legislativa. Difundimos
						esta información en formatos accesibles y abiertos para fomentar el conocimiento, el
						control ciudadano y el debate sobre la labor de quienes nos representan.
					</p>
					<p class="mt-4 leading-relaxed text-slate-700">
						Aspiramos a ser un espacio de orientación, capacitación y asesoramiento en la gestión
						de políticas públicas, conectando sus contenidos con la comunidad y los diversos
						actores de la región.
					</p>
					<p class="mt-4 leading-relaxed text-slate-700">
						El Observatorio es dirigido por <strong class="font-semibold text-slate-900">Miguel Torres Romero</strong>,
						Cientista Político y Mg. (c) en Investigación en Ciencias Sociales de la Universidad de
						Buenos Aires, Argentina, con experiencia en investigación y análisis político.
					</p>
				</section>

				<section class="mt-10 rounded-2xl bg-amber-50 p-6 ring-1 ring-amber-100 sm:p-8">
					<div class="flex items-center gap-3">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xl">🔒</span>
						<h2 class="text-lg font-semibold text-slate-900">Transparencia y Autofinanciamiento</h2>
					</div>
					<p class="mt-4 leading-relaxed text-slate-700">
						El Observatorio es un proyecto independiente y autofinanciado. No recibimos fondos de
						partidos políticos ni de entidades gubernamentales, asegurando así un análisis objetivo
						y libre de intereses externos. Nuestro trabajo es posible gracias al aporte de sus
						integrantes y colaboraciones voluntarias.
					</p>
				</section>

				<section class="mt-6 rounded-2xl bg-blue-50 p-6 ring-1 ring-blue-100 sm:p-8">
					<div class="flex items-center gap-3">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100 text-xl">📊</span>
						<h2 class="text-lg font-semibold text-slate-900">Acceso a Datos y Metodología</h2>
					</div>
					<p class="mt-4 leading-relaxed text-slate-700">
						Creemos en la transparencia del análisis político. Por ello, ponemos a disposición de
						la ciudadanía nuestras fuentes de información, bases de datos y metodologías de
						análisis. Nuestro enfoque se basa en la recopilación rigurosa de datos públicos,
						informes oficiales y seguimiento de indicadores clave para ofrecer estudios
						fundamentados y verificables.
					</p>
				</section>

				<section class="mt-10">
					<p class="text-sm font-semibold tracking-widest text-brand-600 uppercase">📌 Lo que hacemos</p>
					<p class="mt-2 max-w-2xl leading-relaxed text-slate-700">
						🔍 Analizamos, monitoreamos y difundimos información clave sobre la política en la
						Región de Coquimbo. Buscamos fortalecer la transparencia, la participación ciudadana y
						el control democrático a través de datos y análisis accesibles.
					</p>
					<div class="mt-6 grid gap-4 sm:grid-cols-2">
						{loQueHacen.map((item) => (
							<div class={`relative rounded-xl p-5 ring-1 ${TONOS[item.tono].bg} ${TONOS[item.tono].ring}`}>
								{item.enVivo && (
									<span class="absolute right-4 top-4 flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wide text-violet-600">
										<span class="relative flex h-2 w-2">
											<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet-500 opacity-75"></span>
											<span class="relative inline-flex h-2 w-2 rounded-full bg-violet-600"></span>
										</span>
										En vivo
									</span>
								)}
								<span class="text-2xl">{item.emoji}</span>
								<p class="mt-2 font-semibold text-slate-900">{item.titulo}</p>
								<p class="mt-1 text-sm leading-relaxed text-slate-600">{item.texto}</p>
							</div>
						))}
					</div>
				</section>
			</div>

			<aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Director</p>
					<p class="mt-2 font-semibold text-slate-900">Miguel Torres Romero</p>
					<p class="mt-1 text-sm text-slate-600">
						Cientista Político, Mg. (c) en Investigación en Ciencias Sociales (Universidad de
						Buenos Aires, Argentina).
					</p>
				</div>

				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Capacidades</p>
					<ul class="mt-3 flex flex-wrap gap-2">
						{capacidades.map((c) => (
							<li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">{c}</li>
						))}
					</ul>
				</div>

				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm text-sm">
					<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Contacto</p>
					<a href="mailto:contacto@oprcoquimbo.cl" class="mt-2 block text-brand-600 hover:underline">
						contacto@oprcoquimbo.cl
					</a>
					<div class="mt-2 flex gap-3 text-brand-600">
						<a href="https://instagram.com/oprcoquimbo" target="_blank" rel="noopener" class="hover:underline">Instagram</a>
						<a href="https://facebook.com/oprcoquimbo" target="_blank" rel="noopener" class="hover:underline">Facebook</a>
						<a href="https://twitter.com/oprcoquimbo" target="_blank" rel="noopener" class="hover:underline">Twitter</a>
					</div>
				</div>
			</aside>
		</div>
	</main>

	<style>
		@keyframes blob-float {
			0%, 100% { transform: translate(0, 0) scale(1); }
			33% { transform: translate(20px, -15px) scale(1.08); }
			66% { transform: translate(-15px, 10px) scale(0.95); }
		}
		.animate-blob {
			animation: blob-float 14s ease-in-out infinite;
		}
		@media (prefers-reduced-motion: reduce) {
			.animate-blob {
				animation: none;
			}
		}
	</style>
</Layout>
