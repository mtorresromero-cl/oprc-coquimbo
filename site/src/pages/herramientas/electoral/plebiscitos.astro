---
import Layout from '../../../layouts/Layout.astro';
import { comunas, participacionElectoral, resultadosElectorales } from '../../../lib/datos';
import comunasGeojson from '../../../../../data/processed/comunas-geojson.json';

const COMUNA_ORDEN = [
	'la-higuera', 'la-serena', 'coquimbo', 'vicuna', 'paihuano', 'andacollo',
	'rio-hurtado', 'monte-patria', 'ovalle', 'punitaqui', 'combarbala',
	'canela', 'illapel', 'salamanca', 'los-vilos',
];
const ORDEN_COMUNA_IDX = Object.fromEntries(COMUNA_ORDEN.map((id, i) => [id, i]));
const comunasOrdenadas = [...comunas].sort(
	(a, b) => (ORDEN_COMUNA_IDX[a.id] ?? 99) - (ORDEN_COMUNA_IDX[b.id] ?? 99)
);

const PLEBISCITOS = [
	{
		slug: 'entrada_2020',
		eleccionTipo: 'plebiscito_constitucion',
		anno: 2020,
		titulo: 'Plebiscito Nacional 2020 — ¿Nueva Constitución?',
		etiquetaBoton: '2020 — ¿Nueva Constitución?',
		opcionA: 'APRUEBO',
		opcionB: 'RECHAZO',
	},
	{
		slug: 'organo_2020',
		eleccionTipo: 'plebiscito_tipo_organo',
		anno: 2020,
		titulo: 'Plebiscito Nacional 2020 — Tipo de órgano redactor',
		etiquetaBoton: '2020 — Tipo de órgano',
		opcionA: 'CONVENCION CONSTITUCIONAL',
		opcionB: 'CONVENCION MIXTA CONSTITUCIONAL',
	},
	{
		slug: 'salida_2022',
		eleccionTipo: 'plebiscito_constitucional',
		anno: 2022,
		titulo: 'Plebiscito Constitucional (salida) 2022',
		etiquetaBoton: '2022 — Salida',
		// a diferencia del de 2023, la papeleta de 2022 usó las mismas
		// palabras que el plebiscito de entrada 2020 (Apruebo/Rechazo), no
		// "A favor/En contra" — es una diferencia real, no un typo.
		opcionA: 'APRUEBO',
		opcionB: 'RECHAZO',
	},
	{
		slug: 'salida_2023',
		eleccionTipo: 'plebiscito_constitucional',
		anno: 2023,
		titulo: 'Plebiscito Constitucional (salida) 2023',
		etiquetaBoton: '2023 — Salida',
		opcionA: 'A FAVOR',
		opcionB: 'EN CONTRA',
	},
];

function buscaPadron(eleccionTipo: string, anno: number) {
	const registros = participacionElectoral.filter(
		(p) => p.anno === anno && p.tipos_relacionados.split(',').includes(eleccionTipo)
	);
	if (registros.length === 0) return null;
	const inscritos = registros.reduce((s, p) => s + p.inscritos, 0);
	const votantes = registros.reduce((s, p) => s + p.votantes, 0);
	return { inscritos, votantes, participacion_pct: inscritos ? (votantes / inscritos) * 100 : 0 };
}

const datosPlebiscitos = PLEBISCITOS.map((p) => {
	const filas = resultadosElectorales.filter((r) => r.eleccion_tipo === p.eleccionTipo && r.anno === p.anno);
	const porComuna = comunasOrdenadas.map((c) => {
		const deComuna = filas.filter((r) => r.comuna_id === c.id);
		const a = deComuna.find((r) => r.candidato === p.opcionA);
		const b = deComuna.find((r) => r.candidato === p.opcionB);
		const votosA = a?.votos ?? 0;
		const votosB = b?.votos ?? 0;
		const total = votosA + votosB;
		return {
			id: c.id,
			nombre: c.nombre,
			pctA: total ? (votosA / total) * 100 : 0,
			pctB: total ? (votosB / total) * 100 : 0,
			votosA,
			votosB,
		};
	});
	const totalA = porComuna.reduce((s, x) => s + x.votosA, 0);
	const totalB = porComuna.reduce((s, x) => s + x.votosB, 0);
	const totalRegion = totalA + totalB;
	const padron = buscaPadron(p.eleccionTipo, p.anno);
	return {
		...p,
		porComuna,
		region: {
			pctA: totalRegion ? (totalA / totalRegion) * 100 : 0,
			pctB: totalRegion ? (totalB / totalRegion) * 100 : 0,
			votosA: totalA,
			votosB: totalB,
		},
		padron,
	};
});
---

<Layout
	title="Plebiscitos — OPRC"
	description="Cómo votó cada comuna de la Región de Coquimbo en los plebiscitos nacionales de 2020, 2022 y 2023."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/herramientas/electoral/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">&larr; Herramienta Electoral</a>
			<p class="mt-4 text-sm font-semibold tracking-widest text-brand-300 uppercase">Herramientas · Electoral</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">Plebiscitos</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Cómo votó cada comuna de la Región de Coquimbo en los plebiscitos nacionales de 2020, 2022
				y 2023.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<p class="max-w-3xl text-sm text-slate-500">
			El plebiscito de 1988 (el que puso fin al régimen militar) no está en esta página: la única
			fuente que tenemos para elecciones tan antiguas, el sitio histórico del SERVEL, no publica
			datos de años anteriores a 1989.
		</p>

		<div class="mt-6 flex flex-wrap gap-2">
			{datosPlebiscitos.map((p, i) => (
				<button
					type="button"
					data-slug={p.slug}
					class:list={[
						'boton-plebiscito rounded-md px-4 py-2 text-sm font-semibold',
						i === 0 ? 'activo' : '',
					]}
				>
					{p.etiquetaBoton}
				</button>
			))}
		</div>

		<div id="resumen" class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
			<h2 id="resumen-titulo" class="text-lg font-bold tracking-tight text-slate-900"></h2>
			<p id="resumen-padron" class="text-sm text-slate-500"></p>

			<div class="mt-4 space-y-3">
				<div>
					<div class="flex items-baseline justify-between">
						<span id="etiqueta-a" class="text-sm font-medium text-slate-700"></span>
						<span id="cifras-a" class="text-sm font-semibold text-slate-900"></span>
					</div>
					<div class="mt-1 h-5 rounded bg-slate-100">
						<div id="barra-a" class="h-5 rounded" style="background-color:#1565c0"></div>
					</div>
				</div>
				<div>
					<div class="flex items-baseline justify-between">
						<span id="etiqueta-b" class="text-sm font-medium text-slate-700"></span>
						<span id="cifras-b" class="text-sm font-semibold text-slate-900"></span>
					</div>
					<div class="mt-1 h-5 rounded bg-slate-100">
						<div id="barra-b" class="h-5 rounded" style="background-color:#c62828"></div>
					</div>
				</div>
			</div>
		</div>

		<div id="mapa-plebiscito" class="mt-6 h-[500px] w-full overflow-hidden rounded-xl border border-slate-200 shadow-sm"></div>
		<p class="mt-2 text-xs text-slate-400">
			Intensidad del color = qué tan amplio fue el margen en esa comuna. Límites administrativos de
			<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener" class="hover:underline">OpenStreetMap</a>.
		</p>

		<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
			<table class="w-full min-w-[480px] text-left text-sm">
				<thead>
					<tr class="border-b border-slate-100 text-xs tracking-wide text-slate-400 uppercase">
						<th scope="col" class="px-4 py-3 font-semibold">Comuna</th>
						<th id="th-a" scope="col" class="px-4 py-3 text-right font-semibold"></th>
						<th id="th-b" scope="col" class="px-4 py-3 text-right font-semibold"></th>
						<th scope="col" class="px-4 py-3 text-right font-semibold">Ganó</th>
					</tr>
				</thead>
				<tbody id="tabla-comunas"></tbody>
			</table>
		</div>
	</main>

	<script type="application/json" id="geojson-data" set:html={JSON.stringify(comunasGeojson)} />
	<script type="application/json" id="plebiscitos-data" set:html={JSON.stringify(datosPlebiscitos)} />

	<script>
		import 'leaflet/dist/leaflet.css';
		import L from 'leaflet';

		interface FilaComuna {
			id: string;
			nombre: string;
			pctA: number;
			pctB: number;
			votosA: number;
			votosB: number;
		}
		interface Plebiscito {
			slug: string;
			titulo: string;
			opcionA: string;
			opcionB: string;
			porComuna: FilaComuna[];
			region: { pctA: number; pctB: number; votosA: number; votosB: number };
			padron: { inscritos: number; votantes: number; participacion_pct: number } | null;
		}

		const geojson = JSON.parse(document.getElementById('geojson-data')!.textContent!);
		const plebiscitos: Plebiscito[] = JSON.parse(document.getElementById('plebiscitos-data')!.textContent!);
		const porSlug = new Map(plebiscitos.map((p) => [p.slug, p]));

		const AZUL = '#1565c0';
		const ROJO = '#c62828';

		function tituloOpcion(s: string) {
			return s
				.toLowerCase()
				.split(' ')
				.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
				.join(' ');
		}

		function colorFila(fila: FilaComuna) {
			const ganaA = fila.pctA >= fila.pctB;
			const margen = Math.abs(fila.pctA - fila.pctB); // 0-100
			const intensidad = 0.25 + 0.65 * Math.min(margen / 40, 1);
			return { color: ganaA ? AZUL : ROJO, intensidad };
		}

		const map = L.map('mapa-plebiscito', { scrollWheelZoom: false }).setView([-30.6, -70.9], 8);
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
			maxZoom: 12,
		}).addTo(map);

		let plebiscitoActivo = plebiscitos[0];

		function filaDe(comunaId: string): FilaComuna {
			return plebiscitoActivo.porComuna.find((f) => f.id === comunaId)!;
		}

		function estiloComuna(feature: any) {
			const fila = filaDe(feature.properties.id);
			const { color, intensidad } = colorFila(fila);
			return { color: '#1e293b', weight: 1, fillColor: color, fillOpacity: intensidad };
		}

		function popupHtml(feature: any): string {
			const fila = filaDe(feature.properties.id);
			return `<strong>${feature.properties.nombre}</strong><br>${tituloOpcion(plebiscitoActivo.opcionA)}: ${fila.pctA.toFixed(1)}%<br>${tituloOpcion(plebiscitoActivo.opcionB)}: ${fila.pctB.toFixed(1)}%`;
		}

		const capa = L.geoJSON(geojson, {
			style: estiloComuna,
			onEachFeature: (feature, layer) => {
				layer.bindPopup(popupHtml(feature));
				layer.on('mouseover', () => (layer as L.Path).setStyle({ weight: 3 }));
				layer.on('mouseout', () => (layer as L.Path).setStyle({ weight: 1 }));
			},
		}).addTo(map);

		function render() {
			const p = plebiscitoActivo;
			document.getElementById('resumen-titulo')!.textContent = p.titulo;
			document.getElementById('resumen-padron')!.textContent = p.padron
				? `Inscritos: ${p.padron.inscritos.toLocaleString('es-CL')} · Votantes: ${p.padron.votantes.toLocaleString('es-CL')} (${p.padron.participacion_pct.toFixed(1)}%)`
				: '';

			document.getElementById('etiqueta-a')!.textContent = tituloOpcion(p.opcionA);
			document.getElementById('etiqueta-b')!.textContent = tituloOpcion(p.opcionB);
			document.getElementById('cifras-a')!.textContent = `${p.region.pctA.toFixed(1)}% · ${p.region.votosA.toLocaleString('es-CL')}`;
			document.getElementById('cifras-b')!.textContent = `${p.region.pctB.toFixed(1)}% · ${p.region.votosB.toLocaleString('es-CL')}`;
			(document.getElementById('barra-a') as HTMLElement).style.width = `${p.region.pctA}%`;
			(document.getElementById('barra-b') as HTMLElement).style.width = `${p.region.pctB}%`;

			document.getElementById('th-a')!.textContent = tituloOpcion(p.opcionA);
			document.getElementById('th-b')!.textContent = tituloOpcion(p.opcionB);

			const tbody = document.getElementById('tabla-comunas')!;
			tbody.innerHTML = '';
			const filas = [...p.porComuna].sort((a, b) => b.pctA - a.pctA);
			for (const f of filas) {
				const gana = f.pctA >= f.pctB;
				const tr = document.createElement('tr');
				tr.className = 'border-b border-slate-50 last:border-0';
				tr.innerHTML = `
					<td class="px-4 py-2.5 font-medium text-slate-700">${f.nombre}</td>
					<td class="px-4 py-2.5 text-right text-slate-500">${f.pctA.toFixed(1)}%</td>
					<td class="px-4 py-2.5 text-right text-slate-500">${f.pctB.toFixed(1)}%</td>
					<td class="px-4 py-2.5 text-right font-semibold" style="color:${gana ? AZUL : ROJO}">${tituloOpcion(gana ? p.opcionA : p.opcionB)}</td>
				`;
				tbody.appendChild(tr);
			}

			capa.setStyle(estiloComuna);
			capa.eachLayer((layer: any) => layer.setPopupContent(popupHtml(layer.feature)));
		}

		document.querySelectorAll<HTMLButtonElement>('.boton-plebiscito').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.boton-plebiscito').forEach((b) => b.classList.remove('activo'));
				btn.classList.add('activo');
				plebiscitoActivo = porSlug.get(btn.dataset.slug!)!;
				render();
			});
		});

		render();
	</script>

	<style>
		.boton-plebiscito {
			background-color: #f1f5f9;
			color: #475569;
		}
		.boton-plebiscito.activo {
			background-color: var(--color-brand-600);
			color: #fff;
		}
	</style>
</Layout>
