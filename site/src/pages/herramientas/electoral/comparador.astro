---
import Layout from '../../../layouts/Layout.astro';
import { comunas, participacionElectoral, resultadosElectorales } from '../../../lib/datos';
import { colorPartido, formatoPartido, nombreCanonicoPartido } from '../../../lib/colores-electorales';
import { COLOR_COMUNA } from '../../../lib/colores-comunas';

const COMUNA_ORDEN = [
	'la-higuera', 'la-serena', 'coquimbo', 'vicuna', 'paihuano', 'andacollo',
	'rio-hurtado', 'monte-patria', 'ovalle', 'punitaqui', 'combarbala',
	'canela', 'illapel', 'salamanca', 'los-vilos',
];
const ORDEN_COMUNA_IDX = Object.fromEntries(COMUNA_ORDEN.map((id, i) => [id, i]));
const comunasOrdenadas = [...comunas].sort(
	(a, b) => (ORDEN_COMUNA_IDX[a.id] ?? 99) - (ORDEN_COMUNA_IDX[b.id] ?? 99)
);

const ORDEN_JORNADA = [
	'municipal_2012', 'parlamentaria_presidencial_2013', 'presidencial_2v_2013', 'municipal_2016',
	'parlamentaria_presidencial_2017', 'presidencial_2v_2017', 'plebiscito_2020', 'megaeleccion_2021',
	'gobernador_2v_2021', 'parlamentaria_presidencial_2021', 'presidencial_2v_2021', 'plebiscito_2022',
	'plebiscito_2023', 'municipal_2024', 'gobernador_2v_2024', 'parlamentaria_presidencial_2025',
	'presidencial_2v_2025',
];
const ETIQUETA_EJE: Record<string, string> = {
	municipal_2012: '2012', parlamentaria_presidencial_2013: '2013 (nov)', presidencial_2v_2013: '2013 (dic)',
	municipal_2016: '2016', parlamentaria_presidencial_2017: '2017 (nov)', presidencial_2v_2017: '2017 (dic)',
	plebiscito_2020: '2020', megaeleccion_2021: '2021 (may)', gobernador_2v_2021: '2021 (jun)',
	parlamentaria_presidencial_2021: '2021 (nov)', presidencial_2v_2021: '2021 (dic)', plebiscito_2022: '2022',
	plebiscito_2023: '2023', municipal_2024: '2024 (oct)', gobernador_2v_2024: '2024 (nov)',
	parlamentaria_presidencial_2025: '2025 (nov)', presidencial_2v_2025: '2025 (dic)',
};

const aniosMunicipales = Array.from(
	new Set(resultadosElectorales.filter((r) => r.eleccion_tipo === 'municipal').map((r) => r.anno))
).sort((a, b) => a - b);
const ultimoAnnoMunicipal = aniosMunicipales[aniosMunicipales.length - 1];

const comparativa = comunasOrdenadas.map((c) => {
	const participacionComuna = ORDEN_JORNADA.map((j) =>
		participacionElectoral.find((p) => p.jornada === j && p.comuna_id === c.id)
	).filter((p) => p !== undefined);
	const ultima = participacionComuna[participacionComuna.length - 1];
	const penultima = participacionComuna[participacionComuna.length - 2];
	const inicial = participacionComuna[0];
	const crecimientoPadron =
		ultima && inicial ? ((ultima.inscritos - inicial.inscritos) / inicial.inscritos) * 100 : null;

	const alcaldesElectos = resultadosElectorales.filter(
		(r) => r.eleccion_tipo === 'municipal' && r.cargo === 'Alcalde' && r.comuna_id === c.id && r.electo
	);
	const conteoPartido = new Map<string, number>();
	for (const a of alcaldesElectos) {
		const nombre = nombreCanonicoPartido(a.partido);
		conteoPartido.set(nombre, (conteoPartido.get(nombre) ?? 0) + 1);
	}
	const dominante = [...conteoPartido.entries()].sort((a, b) => b[1] - a[1])[0];

	const alcaldeUltimaEleccion = resultadosElectorales
		.filter((r) => r.eleccion_tipo === 'municipal' && r.cargo === 'Alcalde' && r.comuna_id === c.id && r.anno === ultimoAnnoMunicipal)
		.sort((a, b) => b.votos - a.votos);
	const margen =
		alcaldeUltimaEleccion.length >= 2
			? (alcaldeUltimaEleccion[0].porcentaje ?? 0) - (alcaldeUltimaEleccion[1].porcentaje ?? 0)
			: null;

	const concejalesActuales = resultadosElectorales.filter(
		(r) => r.eleccion_tipo === 'municipal' && r.cargo === 'Concejal' && r.comuna_id === c.id && r.anno === ultimoAnnoMunicipal && r.electo
	);
	const conteoConcejales = new Map<string, number>();
	for (const cc of concejalesActuales) {
		const nombre = nombreCanonicoPartido(cc.partido);
		conteoConcejales.set(nombre, (conteoConcejales.get(nombre) ?? 0) + 1);
	}
	const concejalesPorPartido = [...conteoConcejales.entries()]
		.sort((a, b) => b[1] - a[1])
		.map(([partido, n]) => ({ partido, n, color: colorPartido(partido) }));

	return {
		id: c.id,
		nombre: c.nombre,
		color: COLOR_COMUNA[c.id],
		inscritos: ultima?.inscritos ?? null,
		crecimientoPadron,
		participacionUltima: ultima?.participacion_pct ?? null,
		tendenciaParticipacion: ultima && penultima ? ultima.participacion_pct - penultima.participacion_pct : null,
		partidoDominante: dominante ? { nombre: dominante[0], veces: dominante[1], color: colorPartido(dominante[0]) } : null,
		totalElecciones: alcaldesElectos.length,
		margenUltimaEleccion: margen,
		concejalesPorPartido,
		totalConcejales: concejalesActuales.length,
		serieParticipacion: ORDEN_JORNADA.map((j, i) => {
			const p = participacionElectoral.find((x) => x.jornada === j && x.comuna_id === c.id);
			return p ? { i, pct: p.participacion_pct } : null;
		}).filter((p) => p !== null),
	};
});

// --- Geometría del gráfico de líneas superpuestas ---
const CHART_W = 760;
const CHART_H = 240;
const PAD_L = 40;
const PAD_R = 12;
const PAD_T = 16;
const PAD_B = 46;
const PLOT_W = CHART_W - PAD_L - PAD_R;
const PLOT_H = CHART_H - PAD_T - PAD_B;
const xFor = (i: number) => PAD_L + (i / (ORDEN_JORNADA.length - 1)) * PLOT_W;
const yFor = (pct: number) => PAD_T + (1 - pct / 100) * PLOT_H;
const EJE_Y = [0, 50, 100];

const SELECCION_INICIAL: string[] = [];
---

<Layout
	title="Comparador entre Comunas — OPRC"
	description="Compara padrón, participación, partido dominante y competitividad electoral entre comunas de la Región de Coquimbo."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/herramientas/electoral/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">&larr; Archivo Electoral</a>
			<p class="mt-4 text-sm font-semibold tracking-widest text-brand-300 uppercase">Herramientas · Electoral</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">Comparador entre Comunas</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Elige 2 o 3 comunas y compara padrón, participación, partido dominante y qué tan reñida fue
				su última elección municipal.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<p class="max-w-3xl text-sm text-slate-500">
			No incluye votos nulos/blancos como indicador de descontento: esos datos existen en los
			archivos originales de SERVEL pero no los extrajimos todavía — quedan pendientes para más
			adelante.
		</p>

		<div class="mt-6">
			<p class="text-sm font-semibold text-slate-900">Elige hasta 3 comunas</p>
			<div id="chips-comuna" class="mt-3 flex flex-wrap gap-2">
				{comunasOrdenadas.map((c) => (
					<button
						type="button"
						class="chip-comuna rounded-full border px-3 py-1.5 text-sm font-medium"
						data-comuna={c.id}
						data-activo={SELECCION_INICIAL.includes(c.id) ? 'true' : 'false'}
						style={`border-color:${SELECCION_INICIAL.includes(c.id) ? COLOR_COMUNA[c.id] : '#cbd5e1'};color:${SELECCION_INICIAL.includes(c.id) ? COLOR_COMUNA[c.id] : '#334155'}`}
					>
						{c.nombre}
					</button>
				))}
			</div>
			<p id="aviso-max" class="mt-2 hidden text-xs text-amber-600">Solo puedes comparar hasta 3 comunas a la vez.</p>
		</div>

		<p id="sin-seleccion" class="mt-6 hidden rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
			Elige al menos una comuna arriba para comparar.
		</p>

		<div id="bloque-comparativa" class="hidden">

		<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
			<table class="w-full min-w-[560px] text-left text-sm">
				<thead>
					<tr class="border-b border-slate-100">
						<th scope="col" class="px-4 py-3 text-xs font-semibold tracking-wide text-slate-400 uppercase">Métrica</th>
					</tr>
				</thead>
				<tbody id="tabla-comparativa"></tbody>
			</table>
		</div>

		<section class="mt-8">
			<h2 class="text-lg font-bold tracking-tight text-slate-900">Evolución de la participación</h2>
			<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full min-w-[520px]" id="grafico-comparador">
					{EJE_Y.map((v) => (
						<g>
							<line x1={PAD_L} x2={CHART_W - PAD_R} y1={yFor(v)} y2={yFor(v)} stroke="#e2e8f0" stroke-width="1" />
							<text x={PAD_L - 8} y={yFor(v) + 4} text-anchor="end" font-size="10" fill="#64748b">{v}%</text>
						</g>
					))}
					{ORDEN_JORNADA.map((j, i) => (
						<text
							x={xFor(i)}
							y={CHART_H - PAD_B + 16}
							text-anchor="end"
							font-size="10"
							fill="#64748b"
							transform={`rotate(-35 ${xFor(i)} ${CHART_H - PAD_B + 16})`}
						>
							{ETIQUETA_EJE[j]}
						</text>
					))}
					{comparativa.map((c) => (
						<g class="serie-comuna" data-comuna={c.id} style={SELECCION_INICIAL.includes(c.id) ? '' : 'display:none'}>
							<polyline
								points={c.serieParticipacion.map((p) => `${xFor(p.i)},${yFor(p.pct)}`).join(' ')}
								fill="none"
								stroke={c.color}
								stroke-width="2.5"
							/>
							{c.serieParticipacion.map((p) => (
								<circle cx={xFor(p.i)} cy={yFor(p.pct)} r="3.5" fill={c.color} stroke="white" stroke-width="1" />
							))}
						</g>
					))}
				</svg>
			</div>
		</section>
		</div>
	</main>

	<script type="application/json" id="comparativa-data" set:html={JSON.stringify(comparativa)} />

	<script>
		interface Fila {
			id: string;
			nombre: string;
			color: string;
			inscritos: number | null;
			crecimientoPadron: number | null;
			participacionUltima: number | null;
			tendenciaParticipacion: number | null;
			partidoDominante: { nombre: string; veces: number; color: string } | null;
			totalElecciones: number;
			margenUltimaEleccion: number | null;
			concejalesPorPartido: { partido: string; n: number; color: string }[];
			totalConcejales: number;
		}

		const datos: Fila[] = JSON.parse(document.getElementById('comparativa-data')!.textContent!);
		const porId = new Map(datos.map((d) => [d.id, d]));

		const chips = document.querySelectorAll<HTMLButtonElement>('.chip-comuna');
		const avisoMax = document.getElementById('aviso-max')!;
		const tabla = document.getElementById('tabla-comparativa')!;
		const sinSeleccion = document.getElementById('sin-seleccion')!;
		const bloqueComparativa = document.getElementById('bloque-comparativa')!;

		function seleccionActual(): string[] {
			return Array.from(chips)
				.filter((c) => c.dataset.activo === 'true')
				.map((c) => c.dataset.comuna!);
		}

		function actualizaVisibilidad() {
			const hay = seleccionActual().length > 0;
			sinSeleccion.classList.toggle('hidden', hay);
			bloqueComparativa.classList.toggle('hidden', !hay);
		}

		function celdaVacia(valor: string | number | null | undefined): string {
			return valor === null || valor === undefined ? '—' : String(valor);
		}

		function renderTabla() {
			const seleccion = seleccionActual();
			const filas = seleccion.map((id) => porId.get(id)!);

			const encabezado = document.querySelector('thead tr')!;
			encabezado.innerHTML =
				'<th scope="col" class="px-4 py-3 text-xs font-semibold tracking-wide text-slate-400 uppercase">Métrica</th>' +
				filas
					.map(
						(f) =>
							`<th scope="col" class="px-4 py-3 text-left"><span class="inline-flex items-center gap-1.5 text-sm font-bold text-slate-900"><span class="h-2.5 w-2.5 rounded-full" style="background-color:${f.color}"></span>${f.nombre}</span></th>`
					)
					.join('');

			function filaMetrica(etiqueta: string, celdas: (f: Fila) => string) {
				return `<tr class="border-b border-slate-50 last:border-0"><td class="px-4 py-3 font-medium text-slate-500">${etiqueta}</td>${filas
					.map((f) => `<td class="px-4 py-3">${celdas(f)}</td>`)
					.join('')}</tr>`;
			}

			tabla.innerHTML =
				filaMetrica(
					'Inscritos (padrón)',
					(f) =>
						`<span class="font-semibold text-slate-900">${celdaVacia(f.inscritos?.toLocaleString('es-CL'))}</span>` +
						(f.crecimientoPadron !== null
							? `<span class="ml-2 text-xs text-slate-400">${f.crecimientoPadron >= 0 ? '+' : ''}${f.crecimientoPadron.toFixed(0)}% desde 2012</span>`
							: '')
				) +
				filaMetrica(
					'Participación (última elección)',
					(f) =>
						`<span class="font-semibold text-slate-900">${f.participacionUltima !== null ? f.participacionUltima.toFixed(1) + '%' : '—'}</span>` +
						(f.tendenciaParticipacion !== null
							? `<span class="ml-2 text-xs ${f.tendenciaParticipacion >= 0 ? 'text-emerald-600' : 'text-red-700'}">${f.tendenciaParticipacion >= 0 ? '▲' : '▼'} ${Math.abs(f.tendenciaParticipacion).toFixed(1)} pts</span>`
							: '')
				) +
				filaMetrica('Partido que más ha ganado la alcaldía', (f) =>
					f.partidoDominante
						? `<span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full" style="background-color:${f.partidoDominante.color}"></span>${f.partidoDominante.nombre}</span><span class="ml-2 text-xs text-slate-400">${f.partidoDominante.veces} de ${f.totalElecciones} elecciones</span>`
						: '—'
				) +
				filaMetrica(
					'Competitividad (última elección de alcalde)',
					(f) =>
						f.margenUltimaEleccion !== null
							? `<span class="font-semibold text-slate-900">${f.margenUltimaEleccion.toFixed(1)} pts</span><span class="ml-2 text-xs text-slate-400">de diferencia entre 1° y 2° lugar</span>`
							: '—'
				) +
				filaMetrica('Concejales actuales por partido', (f) => {
					if (f.concejalesPorPartido.length === 0) return '—';
					const barra = f.concejalesPorPartido
						.map(
							(cp, i) =>
								`<div class="h-4${i < f.concejalesPorPartido.length - 1 ? ' border-r border-white' : ''}" style="width:${(cp.n / f.totalConcejales) * 100}%;background-color:${cp.color}" title="${cp.partido}: ${cp.n}"></div>`
						)
						.join('');
					const lista = f.concejalesPorPartido
						.map(
							(cp) =>
								`<span class="inline-flex items-center gap-1 text-xs text-slate-500"><span class="h-2 w-2 rounded-full" style="background-color:${cp.color}"></span>${cp.partido} (${cp.n})</span>`
						)
						.join(' ');
					return `<div class="flex h-4 overflow-hidden rounded">${barra}</div><div class="mt-1.5 flex flex-wrap gap-x-2 gap-y-1">${lista}</div>`;
				});
		}

		function actualizaGrafico() {
			const seleccion = new Set(seleccionActual());
			document.querySelectorAll<HTMLElement>('.serie-comuna').forEach((g) => {
				g.style.display = seleccion.has(g.dataset.comuna!) ? '' : 'none';
			});
		}

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				const activo = chip.dataset.activo === 'true';
				if (!activo && seleccionActual().length >= 3) {
					avisoMax.classList.remove('hidden');
					return;
				}
				avisoMax.classList.add('hidden');
				chip.dataset.activo = activo ? 'false' : 'true';
				const color = porId.get(chip.dataset.comuna!)!.color;
				chip.style.borderColor = activo ? '#cbd5e1' : color;
				chip.style.color = activo ? '#334155' : color;
				renderTabla();
				actualizaGrafico();
				actualizaVisibilidad();
			});
		});

		renderTabla();
		actualizaGrafico();
		actualizaVisibilidad();
	</script>
</Layout>
