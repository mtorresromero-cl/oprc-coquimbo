---
import Layout from '../../../layouts/Layout.astro';
import { comunas, padronDemografico } from '../../../lib/datos';

const COMUNA_ORDEN = [
	'la-higuera', 'la-serena', 'coquimbo', 'vicuna', 'paihuano', 'andacollo',
	'rio-hurtado', 'monte-patria', 'ovalle', 'punitaqui', 'combarbala',
	'canela', 'illapel', 'salamanca', 'los-vilos',
];
const ORDEN_COMUNA_IDX = Object.fromEntries(COMUNA_ORDEN.map((id, i) => [id, i]));
const comunasOrdenadas = [...comunas].sort(
	(a, b) => (ORDEN_COMUNA_IDX[a.id] ?? 99) - (ORDEN_COMUNA_IDX[b.id] ?? 99)
);

// plebiscito_2020 no tiene hoja de "Descripción votantes" para Chile en
// ninguno de sus dos archivos (solo para el voto en el extranjero) — hueco
// real de la fuente, no un error de procesamiento.
const ORDEN_JORNADA = [
	'municipal_2012', 'parlamentaria_presidencial_2013', 'municipal_2016',
	'parlamentaria_presidencial_2017', 'megaeleccion_2021', 'parlamentaria_presidencial_2021',
	'plebiscito_2022', 'plebiscito_2023', 'municipal_2024', 'parlamentaria_presidencial_2025',
];
const ETIQUETA_EJE: Record<string, string> = {
	municipal_2012: '2012', parlamentaria_presidencial_2013: '2013', municipal_2016: '2016',
	parlamentaria_presidencial_2017: '2017', megaeleccion_2021: '2021 (may)',
	parlamentaria_presidencial_2021: '2021 (nov)', plebiscito_2022: '2022', plebiscito_2023: '2023',
	municipal_2024: '2024', parlamentaria_presidencial_2025: '2025',
};
const ULTIMA_JORNADA = ORDEN_JORNADA[ORDEN_JORNADA.length - 1];
const RANGO_ORDEN = ['18-19', '20-29', '30-39', '40-49', '50-59', '60-69', '70-79', '80+'];

function calculaPerfil(filasAmbito: typeof padronDemografico) {
	const porJornada = (j: string) => filasAmbito.filter((r) => r.jornada === j);

	const serieExtranjero = ORDEN_JORNADA.map((j, i) => {
		const filas = porJornada(j);
		const total = filas.reduce((s, r) => s + r.votantes, 0);
		const extranjero = filas.filter((r) => r.extranjero).reduce((s, r) => s + r.votantes, 0);
		return total ? { i, pct: (extranjero / total) * 100 } : null;
	}).filter((p) => p !== null);

	const filasUltima = porJornada(ULTIMA_JORNADA);
	const hombres = filasUltima.filter((r) => r.sexo === 'HOMBRES').reduce((s, r) => s + r.votantes, 0);
	const mujeres = filasUltima.filter((r) => r.sexo === 'MUJERES').reduce((s, r) => s + r.votantes, 0);
	const totalUltima = hombres + mujeres;

	const rangos = RANGO_ORDEN.map((r) => ({
		rango: r,
		votantes: filasUltima.filter((f) => f.rango_etario === r).reduce((s, f) => s + f.votantes, 0),
	}));
	const maxRango = Math.max(...rangos.map((r) => r.votantes), 1);

	return {
		serieExtranjero,
		hombresPct: totalUltima ? (hombres / totalUltima) * 100 : 0,
		mujeresPct: totalUltima ? (mujeres / totalUltima) * 100 : 0,
		totalUltima,
		rangos,
		maxRango,
	};
}

const perfilRegion = calculaPerfil(padronDemografico);
const perfilesComuna = comunasOrdenadas.map((c) => ({
	comuna: c,
	perfil: calculaPerfil(padronDemografico.filter((r) => r.comuna_id === c.id)),
}));

// --- Geometría del gráfico de extranjeros en el tiempo ---
const CHART_W = 720;
const CHART_H = 200;
const PAD_L = 40;
const PAD_R = 12;
const PAD_T = 16;
const PAD_B = 46;
const PLOT_W = CHART_W - PAD_L - PAD_R;
const PLOT_H = CHART_H - PAD_T - PAD_B;
const xFor = (i: number) => PAD_L + (i / (ORDEN_JORNADA.length - 1)) * PLOT_W;
// escala no lineal simple (raíz cuadrada) porque casi todos los valores son
// menores a 2% — con escala lineal 0-100 la línea sería invisible.
const MAX_PCT = 6;
const yFor = (pct: number) => PAD_T + (1 - Math.min(pct, MAX_PCT) / MAX_PCT) * PLOT_H;
const EJE_Y = [0, 2, 4, 6];
---

<Layout
	title="Padrón Electoral — OPRC"
	description="Quiénes fueron a votar en la Región de Coquimbo: composición por sexo, edad y nacionalidad, 2012-2025."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/herramientas/electoral/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">&larr; Archivo Electoral</a>
			<p class="mt-4 text-sm font-semibold tracking-widest text-brand-300 uppercase">Herramientas · Electoral</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">Padrón Electoral</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Quiénes fueron efectivamente a votar en la Región de Coquimbo: composición por sexo, edad
				y nacionalidad, 2012-2025.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<p class="max-w-3xl text-sm text-slate-500">
			Esto describe a quienes <strong>votaron</strong> cada jornada (no a todo el padrón de
			inscritos). Sale de la misma fuente que <a href="/herramientas/participacion-electoral/" class="font-medium text-brand-600 hover:underline">Participación Electoral</a>,
			desglosada por mesa. La jornada del plebiscito de octubre 2020 no está: ninguno de sus dos
			archivos trae este desglose para el voto dentro de Chile.
		</p>

		<div class="mt-6">
			<label for="sel-ambito" class="block text-sm font-semibold text-slate-900">Ámbito</label>
			<select
				id="sel-ambito"
				class="mt-2 w-full max-w-xs rounded-md border border-slate-300 px-3 py-2.5 text-sm focus:border-brand-500 focus:outline-none"
			>
				<option value="region">Toda la región</option>
				{comunasOrdenadas.map((c) => <option value={c.id}>{c.nombre}</option>)}
			</select>
		</div>

		{[{ id: 'region', comuna: null, perfil: perfilRegion }, ...perfilesComuna.map((p) => ({ id: p.comuna.id, comuna: p.comuna, perfil: p.perfil }))].map(
			({ id, perfil }) => (
				<div class="vista-ambito mt-8" data-ambito={id} style={id === 'region' ? '' : 'display:none'}>
					<div class="grid gap-6 lg:grid-cols-2">
						<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
							<h2 class="text-sm font-bold tracking-wide text-slate-500 uppercase">
								Quién votó — {ULTIMA_JORNADA === 'parlamentaria_presidencial_2025' ? '2025' : ULTIMA_JORNADA}
							</h2>
							<p class="mt-3 text-xs font-semibold text-slate-400 uppercase">Sexo</p>
							<div class="mt-1.5 flex h-6 overflow-hidden rounded">
								<div class="flex h-6 items-center justify-center text-xs font-semibold text-white" style={`width:${perfil.hombresPct}%;background-color:#457b9d`}>
									{perfil.hombresPct > 12 ? `${perfil.hombresPct.toFixed(0)}%` : ''}
								</div>
								<div class="flex h-6 items-center justify-center text-xs font-semibold text-white" style={`width:${perfil.mujeresPct}%;background-color:#e63946`}>
									{perfil.mujeresPct > 12 ? `${perfil.mujeresPct.toFixed(0)}%` : ''}
								</div>
							</div>
							<p class="mt-1.5 text-xs text-slate-400">
								<span class="mr-1 inline-block h-2.5 w-2.5 rounded-full align-middle" style="background-color:#457b9d"></span>
								Hombres {perfil.hombresPct.toFixed(1)}%
								<span class="mx-2">·</span>
								<span class="mr-1 inline-block h-2.5 w-2.5 rounded-full align-middle" style="background-color:#e63946"></span>
								Mujeres {perfil.mujeresPct.toFixed(1)}%
							</p>

							<p class="mt-5 text-xs font-semibold text-slate-400 uppercase">Rango etario</p>
							<div class="mt-2 space-y-1.5">
								{perfil.rangos.map((r) => (
									<div class="flex items-center gap-2">
										<span class="w-12 shrink-0 text-xs text-slate-500">{r.rango}</span>
										<div class="h-3.5 flex-1 rounded bg-slate-100">
											<div class="h-3.5 rounded bg-brand-600" style={`width:${(r.votantes / perfil.maxRango) * 100}%`}></div>
										</div>
										<span class="w-16 shrink-0 text-right text-xs text-slate-500">{r.votantes.toLocaleString('es-CL')}</span>
									</div>
								))}
							</div>
						</div>

						<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
							<h2 class="text-sm font-bold tracking-wide text-slate-500 uppercase">Votantes extranjeros</h2>
							<p class="mt-1 text-xs text-slate-500">Porcentaje de quienes votaron declarando una nacionalidad distinta a Chile.</p>
							<svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="mt-3 w-full">
								{EJE_Y.map((v) => (
									<g>
										<line x1={PAD_L} x2={CHART_W - PAD_R} y1={yFor(v)} y2={yFor(v)} stroke="#e2e8f0" stroke-width="1" />
										<text x={PAD_L - 8} y={yFor(v) + 4} text-anchor="end" font-size="10" fill="#64748b">{v}%</text>
									</g>
								))}
								{ORDEN_JORNADA.map((j, i) => (
									<text
										x={xFor(i)}
										y={CHART_H - PAD_B + 16}
										text-anchor="end"
										font-size="10"
										fill="#64748b"
										transform={`rotate(-35 ${xFor(i)} ${CHART_H - PAD_B + 16})`}
									>
										{ETIQUETA_EJE[j]}
									</text>
								))}
								<polyline
									points={perfil.serieExtranjero.map((p) => `${xFor(p.i)},${yFor(p.pct)}`).join(' ')}
									fill="none"
									stroke="#aa0000"
									stroke-width="2.5"
								/>
								{perfil.serieExtranjero.map((p) => (
									<>
										<circle cx={xFor(p.i)} cy={yFor(p.pct)} r="4" fill="#aa0000" stroke="white" stroke-width="1.5" />
										<text x={xFor(p.i)} y={yFor(p.pct) - 10} text-anchor="middle" font-size="10" fill="#334155">
											{p.pct.toFixed(2)}%
										</text>
									</>
								))}
							</svg>
						</div>
					</div>
				</div>
			)
		)}
	</main>

	<script>
		const selector = document.getElementById('sel-ambito') as HTMLSelectElement;
		const vistas = document.querySelectorAll<HTMLElement>('.vista-ambito');
		selector.addEventListener('change', () => {
			vistas.forEach((v) => (v.style.display = v.dataset.ambito === selector.value ? '' : 'none'));
		});
	</script>
</Layout>
