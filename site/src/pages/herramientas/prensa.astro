import Layout from '../../layouts/Layout.astro';
import { analisisPrensa, nombreComuna } from '../../lib/datos';

const {
	top_palabras_por_medio,
	top_palabras_total,
	top_palabras_por_semana,
	tendencia,
	tendencia_por_medio,
	coocurrencia,
	menciones_por_comuna,
	total_articulos,
	total_palabras_corpus,
} = analisisPrensa;

const medios = Object.keys(top_palabras_por_medio).sort((a, b) => a.localeCompare(b, 'es'));

const menCom = menciones_por_comuna.map((m) => ({
	id: m.comuna_id,
	nombre: nombreComuna(m.comuna_id) ?? m.comuna_id,
	n: m.n,
}));

// convierte "2026-W31" a la fecha del lunes de esa semana ISO, para
// mostrar rangos de fecha reales en vez de solo un número de semana que
// no dice nada por sí solo
function lunesDeSemanaISO(anno: number, semana: number): Date {
	const enero4 = new Date(Date.UTC(anno, 0, 4));
	const diaSemana = enero4.getUTCDay() || 7; // lunes=1 .. domingo=7
	const lunesSemana1 = new Date(enero4);
	lunesSemana1.setUTCDate(enero4.getUTCDate() - diaSemana + 1);
	const resultado = new Date(lunesSemana1);
	resultado.setUTCDate(lunesSemana1.getUTCDate() + (semana - 1) * 7);
	return resultado;
}
const FORMATO_CORTO = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short' });
const rangosSemana = tendencia.semanas.map((s) => {
	const [anno, semana] = s.split('-W').map(Number);
	const lunes = lunesDeSemanaISO(anno, semana);
	const domingo = new Date(lunes);
	domingo.setUTCDate(lunes.getUTCDate() + 6);
	return { lunes, domingo, etiqueta: FORMATO_CORTO.format(lunes) };
});
const FORMATO_LARGO = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
const rangoTotalTexto =
	rangosSemana.length > 0
		? `Datos desde el ${FORMATO_LARGO.format(rangosSemana[0].lunes)} hasta el ${FORMATO_LARGO.format(rangosSemana[rangosSemana.length - 1].domingo)}.`
		: '';

// --- gráfico de tendencia: bump chart real — el eje Y es el lugar que
// ocupa cada palabra esa semana (1° = la más mencionada esa semana entre
// las 8 seguidas), no su frecuencia cruda. Un gráfico de magnitud con 8
// líneas casi paralelas es difícil de leer y poco vistoso; el ranking
// hace que las líneas se crucen cuando una palabra le gana el lugar a
// otra, que es justo lo que hace interesante a un bump chart. La
// frecuencia real se conserva por punto para el tooltip ---
const COLORES_TENDENCIA = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7', '#e34948'];
const palabrasGrafico = tendencia.palabras.slice(0, 8);
const CHART_W = 900;
const CHART_H = 320;
const PAD_L = 40;
const PAD_R = 16;
const PAD_T = 20;
const PAD_B = 34;
const PLOT_W = CHART_W - PAD_L - PAD_R;
const PLOT_H = CHART_H - PAD_T - PAD_B;
const xForTendencia = (i: number) =>
	tendencia.semanas.length > 1 ? PAD_L + (i / (tendencia.semanas.length - 1)) * PLOT_W : PAD_L + PLOT_W / 2;
const yForBump = (rank: number) =>
	palabrasGrafico.length > 1
		? PAD_T + ((rank - 1) / (palabrasGrafico.length - 1)) * PLOT_H
		: PAD_T + PLOT_H / 2;
const EJE_Y_TENDENCIA = palabrasGrafico.map((_p, i) => i + 1);
// empate de frecuencia se resuelve alfabéticamente, para que el ranking
// 1..8 quede siempre completo esa semana y ninguna línea comparta lugar
const rankingsPorSemana = tendencia.semanas.map((_s, semanaIdx) => {
	const ordenado = [...palabrasGrafico]
		.map((palabra) => ({ palabra, valor: tendencia.serie[palabra]?.[semanaIdx] ?? 0 }))
		.sort((a, b) => b.valor - a.valor || a.palabra.localeCompare(b.palabra, 'es'));
	const porPalabra: Record<string, { rank: number; valor: number }> = {};
	ordenado.forEach(({ palabra, valor }, i) => (porPalabra[palabra] = { rank: i + 1, valor }));
	return porPalabra;
});
const lineasTendencia = palabrasGrafico.map((palabra, i) => {
	const puntos = rankingsPorSemana.map((ranking, j) => {
		const { rank, valor } = ranking[palabra];
		return { x: xForTendencia(j), y: yForBump(rank), rank, valor };
	});
	return {
		palabra,
		color: COLORES_TENDENCIA[i % COLORES_TENDENCIA.length],
		polyline: puntos.map((p) => `${p.x},${p.y}`).join(' '),
		puntos,
	};
});

// --- "Comparar palabras": las 15 palabras seguidas, todas pre-dibujadas
// y ocultas con checkboxes (mismo patrón que el filtro de comunas de
// /herramientas/delincuencia/) — el usuario elige cuáles ver ---
const SELECCION_COMPARAR_INICIAL = new Set<string>();
const maxComparar = Math.max(1, ...tendencia.palabras.flatMap((p) => tendencia.serie[p] ?? []));
const yForComparar = (v: number) => PAD_T + (1 - v / maxComparar) * PLOT_H;
const EJE_Y_COMPARAR = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(maxComparar * f));
const lineasComparar = tendencia.palabras.map((palabra, i) => {
	const valores = tendencia.serie[palabra] ?? [];
	return {
		palabra,
		color: COLORES_TENDENCIA[i % COLORES_TENDENCIA.length],
		polyline: valores.map((v, j) => `${xForTendencia(j)},${yForComparar(v)}`).join(' '),
		puntos: valores.map((v, j) => ({ x: xForTendencia(j), y: yForComparar(v), v })),
	};
});

// --- "Por medio": agrupa cada palabra seguida en sus 5 medios más
// activos + "Otros" (el resto sumado) — sin esto un gráfico con hasta
// 27 medios por palabra sería ilegible, y no hay 27 colores distintos
// que además se puedan reconocer de un vistazo ---
const TOP_MEDIOS_N = 5;
const COLOR_OTROS = '#94a3b8';
function agruparPorMedio(palabra: string) {
	const datos = tendencia_por_medio[palabra];
	if (!datos) return { medios: [] as string[], serie: {} as Record<string, number[]> };
	const totales = datos.medios
		.map((m) => ({ medio: m, total: datos.serie[m].reduce((s, v) => s + v, 0) }))
		.sort((a, b) => b.total - a.total);
	const top = totales.slice(0, TOP_MEDIOS_N).map((x) => x.medio);
	const resto = totales.slice(TOP_MEDIOS_N).map((x) => x.medio);
	const serie: Record<string, number[]> = {};
	for (const m of top) serie[m] = datos.serie[m];
	if (resto.length > 0) {
		serie['Otros'] = tendencia.semanas.map((_s, i) => resto.reduce((s, m) => s + datos.serie[m][i], 0));
	}
	return { medios: resto.length > 0 ? [...top, 'Otros'] : top, serie };
}
const porMedioAgrupado: Record<string, { medios: string[]; serie: Record<string, number[]> }> =
	Object.fromEntries(tendencia.palabras.map((p) => [p, agruparPorMedio(p)]));

// --- "Por medio" — vista A: barras apiladas de una semana elegida,
// una barra por cada una de las 8 palabras del gráfico de tendencia ---
const SEMANA_INICIAL = tendencia.semanas.length - 1; // la más reciente
const barrasPorSemana = tendencia.semanas.map((_s, semanaIdx) =>
	palabrasGrafico.map((palabra) => {
		const { medios, serie } = porMedioAgrupado[palabra];
		const total = medios.reduce((s, m) => s + (serie[m]?.[semanaIdx] ?? 0), 0);
		return {
			palabra,
			total,
			segmentos: medios.map((medio, i) => ({
				medio,
				n: serie[medio]?.[semanaIdx] ?? 0,
				color: medio === 'Otros' ? COLOR_OTROS : COLORES_TENDENCIA[i % COLORES_TENDENCIA.length],
			})),
		};
	})
);
const maxBarraPorSemana = Math.max(1, ...barrasPorSemana.flatMap((sem) => sem.map((b) => b.total)));

// --- "Por medio" — vista B: un concepto elegido, una línea por medio
// (top 5 + Otros) a través del tiempo. Cada palabra tiene su propia
// escala Y (según su medio más activo) — se precomputan las 15 acá
// mismo, junto con sus propios ticks del eje, y el cliente solo cambia
// cuál grupo mostrar (sin recalcular nada) ---
const porMedioPorPalabra = Object.fromEntries(
	tendencia.palabras.map((palabra) => {
		const { medios, serie } = porMedioAgrupado[palabra];
		const maxLocal = Math.max(1, ...medios.flatMap((m) => serie[m] ?? []));
		const yForLocal = (v: number) => PAD_T + (1 - v / maxLocal) * PLOT_H;
		const ejeY = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(maxLocal * f));
		return [
			palabra,
			{
				ejeY: ejeY.map((v) => ({ v, y: yForLocal(v) })),
				lineas: medios.map((medio, i) => ({
					medio,
					color: medio === 'Otros' ? COLOR_OTROS : COLORES_TENDENCIA[i % COLORES_TENDENCIA.length],
					polyline: (serie[medio] ?? []).map((v, j) => `${xForTendencia(j)},${yForLocal(v)}`).join(' '),
					puntos: (serie[medio] ?? []).map((v, j) => ({ x: xForTendencia(j), y: yForLocal(v), v })),
				})),
			},
		];
	})
);
