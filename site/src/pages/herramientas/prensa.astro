<Layout
	title="Prensa regional — OPRC"
	description="Análisis de texto de la prensa regional de Coquimbo: palabras más usadas, tendencia, red de coocurrencia y qué comunas aparecen más en las noticias."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/herramientas/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">&larr; Herramientas</a>
			<p class="mt-6 text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Prensa regional
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				{total_articulos} noticias reales de {medios.length} medios de la Región de Coquimbo —
				{total_palabras_corpus.toLocaleString('es-CL')} palabras analizadas. Solo se analiza el
				texto (nubes de palabras, tendencias, menciones); nunca se republican los artículos.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap gap-2">
			{['Comunas', 'Palabras más usadas', 'Tendencia', 'Comparar palabras', 'Nube por semana', 'Por medio', 'Red de palabras'].map((label, i) => (
				<button
					type="button"
					data-tab={i}
					class:list={[
						'tab-btn cursor-pointer rounded-md px-4 py-2 text-sm font-semibold',
						i === 0 ? 'bg-topic-discursos text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50',
					]}
				>
					{label}
				</button>
			))}
		</div>

		<!-- Menciones -->
		<section class="panel mt-8" data-panel="0">
			<h2 class="text-xl font-semibold text-slate-900">Comunas más mencionadas</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Cuántas noticias mencionan a cada comuna, por nombre. {rangoTotalTexto}
			</p>
			{menCom.length === 0 ? (
				<p class="mt-2 text-sm text-slate-500">Todavía no hay menciones detectadas.</p>
			) : (
				<div class="mt-3 space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					{menCom.map((m) => {
						const max = Math.max(...menCom.map((x) => x.n), 1);
						const anchoPct = (m.n / max) * 100;
						return (
							<div class="flex items-center gap-3">
								<span class="w-32 shrink-0 truncate text-sm font-medium text-slate-800 sm:w-40">{m.nombre}</span>
								<div class="h-4 flex-1 rounded bg-slate-100">
									<div class="h-4 rounded bg-topic-discursos" style={`width:${anchoPct}%`}></div>
								</div>
								<span class="w-24 shrink-0 whitespace-nowrap text-right text-sm font-semibold text-slate-900 tabular-nums">{m.n} noticias</span>
							</div>
						);
					})}
				</div>
			)}
		</section>

		<!-- Palabras más usadas -->
		<section class="panel mt-8 hidden" data-panel="1">
			<h2 class="text-xl font-semibold text-slate-900">Palabras más usadas</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Sin palabras vacías ni verbos de atribución periodística ("señaló", "indicó", etc.) — el
				vocabulario real de cada medio. {rangoTotalTexto}
			</p>
			<div class="mt-4 sm:flex sm:items-start sm:gap-6">
				<div class="flex gap-1.5 overflow-x-auto pb-2 sm:block sm:w-56 sm:shrink-0 sm:space-y-1 sm:overflow-visible sm:pb-0">
					<button type="button" data-medio="__total__" class="medio-btn shrink-0 whitespace-nowrap rounded-md bg-topic-discursos px-3 py-2 text-left text-sm font-medium text-white sm:w-full">
						Los {medios.length} medios en conjunto
					</button>
					{medios.map((m) => (
						<button type="button" data-medio={m} class="medio-btn shrink-0 whitespace-nowrap rounded-md px-3 py-2 text-left text-sm font-medium text-slate-600 hover:bg-slate-100 sm:w-full">
							{m}
						</button>
					))}
				</div>
				<div class="mt-4 min-w-0 flex-1 sm:mt-0">
					<div id="lista-palabras" class="grid gap-x-8 gap-y-1.5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2"></div>

					<h3 class="mt-10 text-base font-semibold text-slate-900">Nube de palabras</h3>
					<p class="mt-1 text-sm text-slate-500">
						Lo mismo, en movimiento — el tamaño es la frecuencia. Pasa el mouse sobre una palabra
						para ver cuántas veces se usó.
					</p>
					<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
						<canvas id="nube-palabras" class="block h-[420px] w-full"></canvas>
						<div id="tooltip-nube" class="pointer-events-none absolute z-10 hidden max-w-[14rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- Tendencia -->
		<section class="panel mt-8 hidden" data-panel="2">
			<h2 class="text-xl font-semibold text-slate-900">Tendencia semanal</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Qué lugar ocupa cada una de las 8 palabras más usadas, semana a semana — 1° es la más
				mencionada esa semana entre estas 8. {rangoTotalTexto}
			</p>
			<div class="relative mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full min-w-[560px]" id="grafico-tendencia">
					{EJE_Y_TENDENCIA.map((rank) => (
						<g>
							<line x1={PAD_L} x2={CHART_W - PAD_R} y1={yForBump(rank)} y2={yForBump(rank)} stroke="#e2e8f0" stroke-width="1" />
							<text x={PAD_L - 8} y={yForBump(rank) + 4} text-anchor="end" font-size="11" fill="#64748b">{rank}°</text>
						</g>
					))}
					{rangosSemana.map((r, i) => (
						<text x={xForTendencia(i)} y={CHART_H - PAD_B + 18} text-anchor="middle" font-size="11" fill="#64748b">
							{r.etiqueta}
						</text>
					))}
					{lineasTendencia.map(({ palabra, color, polyline, puntos }) => (
						<g>
							<polyline points={polyline} fill="none" stroke={color} stroke-width="2.5" />
							{puntos.map((p) => (
								<circle
									class="punto-tendencia"
									cx={p.x}
									cy={p.y}
									r="4"
									fill={color}
									stroke="white"
									stroke-width="1.5"
									data-palabra={palabra}
									data-rank={p.rank}
									data-valor={p.valor}
								/>
							))}
						</g>
					))}
				</svg>
				<div
					id="tooltip-tendencia"
					class="pointer-events-none absolute z-10 hidden max-w-[180px] rounded-md bg-slate-900 px-3 py-2 text-xs text-white shadow-lg"
				></div>
			</div>
			<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
				{lineasTendencia.map(({ palabra, color }) => (
					<span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
						<span class="inline-block h-2.5 w-2.5 rounded-full" style={`background-color:${color}`}></span>
						{palabra}
					</span>
				))}
			</div>
		</section>

		<!-- Comparar palabras -->
		<section class="panel mt-8 hidden" data-panel="3">
			<h2 class="text-xl font-semibold text-slate-900">Comparar palabras</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Elige cuáles de las 15 palabras más usadas comparar — su frecuencia semana a semana, una
				sobre la otra. {rangoTotalTexto}
			</p>
			<div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
				{lineasComparar.map(({ palabra, color }) => (
					<label class="flex cursor-pointer items-center gap-1.5 text-sm text-slate-700">
						<input
							type="checkbox"
							class="check-comparar h-4 w-4 rounded border-slate-300"
							style={`accent-color:${color}`}
							data-palabra={palabra}
							checked={SELECCION_COMPARAR_INICIAL.has(palabra)}
						/>
						{palabra}
					</label>
				))}
			</div>
			<p id="mensaje-comparar-vacio" class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-5 py-10 text-center text-sm text-slate-500">
				Elige al menos una palabra arriba para ver su evolución.
			</p>
			<div id="contenedor-grafico-comparar" class="relative mt-4 hidden overflow-x-auto rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full min-w-[560px]" id="grafico-comparar">
					{EJE_Y_COMPARAR.map((v) => (
						<g>
							<line x1={PAD_L} x2={CHART_W - PAD_R} y1={yForComparar(v)} y2={yForComparar(v)} stroke="#e2e8f0" stroke-width="1" />
							<text x={PAD_L - 8} y={yForComparar(v) + 4} text-anchor="end" font-size="11" fill="#64748b">{v}</text>
						</g>
					))}
					{rangosSemana.map((r, i) => (
						<text x={xForTendencia(i)} y={CHART_H - PAD_B + 18} text-anchor="middle" font-size="11" fill="#64748b">
							{r.etiqueta}
						</text>
					))}
					{lineasComparar.map(({ palabra, color, polyline, puntos }) => (
						<g class="serie-comparar" data-palabra={palabra} style={SELECCION_COMPARAR_INICIAL.has(palabra) ? '' : 'display:none'}>
							<polyline points={polyline} fill="none" stroke={color} stroke-width="2.5" />
							{puntos.map((p) => (
								<circle
									class="punto-comparar"
									cx={p.x}
									cy={p.y}
									r="4"
									fill={color}
									stroke="white"
									stroke-width="1.5"
									data-palabra={palabra}
									data-valor={p.v}
								/>
							))}
						</g>
					))}
				</svg>
				<div
					id="tooltip-comparar"
					class="pointer-events-none absolute z-10 hidden max-w-[180px] rounded-md bg-slate-900 px-3 py-2 text-xs text-white shadow-lg"
				></div>
			</div>
		</section>

		<!-- Nube por semana -->
		<section class="panel mt-8 hidden" data-panel="4">
			<h2 class="text-xl font-semibold text-slate-900">Nube por semana</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Las palabras más usadas de una semana específica — a diferencia de la pestaña anterior,
				acá cada semana muestra sus propias palabras principales, no solo las 15 más usadas en
				todo el período.
			</p>
			<select id="selector-semana-nube" class="mt-4 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				{rangosSemana.map((r, i) => (
					<option value={tendencia.semanas[i]} selected={i === SEMANA_INICIAL}>
						Semana del {r.etiqueta}
					</option>
				))}
			</select>
			<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
				<canvas id="nube-semana" class="block h-[420px] w-full"></canvas>
				<div id="tooltip-nube-semana" class="pointer-events-none absolute z-10 hidden max-w-[14rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"></div>
			</div>
		</section>

		<!-- Por medio -->
		<section class="panel mt-8 hidden" data-panel="5">
			<h2 class="text-xl font-semibold text-slate-900">Por medio</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Qué medios usan más cada palabra — para ver diferencias de enfoque editorial entre ellos.
				Se muestran los 5 medios más activos en cada palabra; el resto se agrupa en "Otros".
			</p>

			<h3 class="mt-8 text-base font-semibold text-slate-900">Top palabras de una semana, por medio</h3>
			<select id="selector-semana-barras" class="mt-3 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				{rangosSemana.map((r, i) => (
					<option value={i} selected={i === SEMANA_INICIAL}>
						Semana del {r.etiqueta}
					</option>
				))}
			</select>
			<div class="relative mt-3 space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				{barrasPorSemana.map((barras, semanaIdx) => (
					<div class="grupo-barras-semana" data-semana-idx={semanaIdx} style={semanaIdx === SEMANA_INICIAL ? '' : 'display:none'}>
						<div class="space-y-3">
							{barras.map((b) => (
								<div>
									<div class="flex items-baseline justify-between gap-3">
										<span class="text-sm font-medium text-slate-700">{b.palabra}</span>
										<span class="text-xs text-slate-400">{b.total} menciones</span>
									</div>
									<div class="mt-1 flex h-5 overflow-hidden rounded bg-slate-100">
										{b.segmentos.filter((s) => s.n > 0).map((s) => (
											<div
												class="barra-segmento cursor-default"
												style={`width:${maxBarraPorSemana ? (s.n / maxBarraPorSemana) * 100 : 0}%;background-color:${s.color}`}
												data-medio={s.medio}
												data-n={s.n}
											></div>
										))}
									</div>
								</div>
							))}
						</div>
					</div>
				))}
				<div
					id="tooltip-barras-semana"
					class="pointer-events-none absolute z-10 hidden max-w-[180px] rounded-md bg-slate-900 px-3 py-2 text-xs text-white shadow-lg"
				></div>
			</div>

			<h3 class="mt-10 text-base font-semibold text-slate-900">Un concepto, comparado entre medios</h3>
			<select id="selector-palabra-medio" class="mt-3 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				{tendencia.palabras.map((p) => (
					<option value={p}>{p}</option>
				))}
			</select>
			<div class="relative mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full min-w-[560px]" id="grafico-por-medio">
					<g id="eje-y-por-medio">
						{porMedioPorPalabra[tendencia.palabras[0]]?.ejeY.map(({ v, y }) => (
							<g class="tick-y">
								<line x1={PAD_L} x2={CHART_W - PAD_R} y1={y} y2={y} stroke="#e2e8f0" stroke-width="1" />
								<text x={PAD_L - 8} y={y + 4} text-anchor="end" font-size="11" fill="#64748b">{v}</text>
							</g>
						))}
					</g>
					{rangosSemana.map((r, i) => (
						<text x={xForTendencia(i)} y={CHART_H - PAD_B + 18} text-anchor="middle" font-size="11" fill="#64748b">
							{r.etiqueta}
						</text>
					))}
					<g id="lineas-por-medio"></g>
				</svg>
				<div
					id="tooltip-por-medio"
					class="pointer-events-none absolute z-10 hidden max-w-[180px] rounded-md bg-slate-900 px-3 py-2 text-xs text-white shadow-lg"
				></div>
			</div>
			<div id="leyenda-por-medio" class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5"></div>
		</section>

		<!-- Red de palabras -->
		<section class="panel mt-8 hidden" data-panel="6">
			<h2 class="text-xl font-semibold text-slate-900">Red de coocurrencia</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Qué palabras aparecen juntas en una misma noticia. El tamaño del punto es la frecuencia
				total; el grosor de la línea, cuántas veces esas dos palabras coincidieron. Arrastra para
				mover, rueda o pellizca para acercar.
			</p>
			<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
				<canvas id="red-palabras" class="block h-[520px] w-full touch-none"></canvas>
				<div id="tooltip-red" class="pointer-events-none absolute z-10 hidden max-w-[14rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"></div>
				<div class="absolute right-3 bottom-3 flex flex-col gap-1.5">
					<button id="zoom-in" type="button" aria-label="Acercar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">+</button>
					<button id="zoom-out" type="button" aria-label="Alejar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">−</button>
				</div>
			</div>
		</section>

		<p class="mt-6 text-xs text-slate-400">Fuentes: Medios de la Región de Coquimbo.</p>
	</main>

	<script type="application/json" id="palabras-data" set:html={JSON.stringify({ top_palabras_por_medio, top_palabras_total })} />
	<script type="application/json" id="nube-semana-data" set:html={JSON.stringify(top_palabras_por_semana)} />
	<script type="application/json" id="por-medio-data" set:html={JSON.stringify(porMedioPorPalabra)} />
	<script type="application/json" id="coocurrencia-data" set:html={JSON.stringify(coocurrencia)} />

	<script>
		// --- tabs ---
		document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const tab = btn.dataset.tab;
				document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((b) => {
					const activo = b === btn;
					b.classList.toggle('bg-topic-discursos', activo);
					b.classList.toggle('text-white', activo);
					b.classList.toggle('border', !activo);
					b.classList.toggle('border-slate-300', !activo);
					b.classList.toggle('text-slate-700', !activo);
					b.classList.toggle('hover:bg-slate-50', !activo);
				});
				document.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
					p.classList.toggle('hidden', p.dataset.panel !== tab);
				});
				// los canvas miden 0x0 mientras su panel está oculto (display:none)
				// — hay que recalcular el layout recién cuando se hacen visibles,
				// si no los nodos quedan todos amontonados en (0,0)
				if (tab === '1') requestAnimationFrame(() => iniciarNubeSiHaceFalta());
				if (tab === '4') requestAnimationFrame(() => iniciarNubeSemanaSiHaceFalta());
				if (tab === '6') requestAnimationFrame(() => iniciarRedSiHaceFalta());
			});
		});

		// --- palabras más usadas ---
		interface PalabraFrecuencia { palabra: string; n: number }
		const palabrasData: {
			top_palabras_por_medio: Record<string, PalabraFrecuencia[]>;
			top_palabras_total: PalabraFrecuencia[];
		} = JSON.parse(document.getElementById('palabras-data')!.textContent!);

		function renderPalabras(clave: string) {
			const lista =
				clave === '__total__'
					? palabrasData.top_palabras_total
					: palabrasData.top_palabras_por_medio[clave] ?? [];
			const max = Math.max(...lista.map((p) => p.n), 1);
			const cont = document.getElementById('lista-palabras')!;
			cont.innerHTML = lista
				.slice(0, 30)
				.map(
					(p) => `
					<div class="flex items-center gap-2 py-0.5">
						<span class="w-24 shrink-0 truncate text-sm text-slate-700">${p.palabra}</span>
						<div class="h-2.5 flex-1 rounded-full bg-slate-100">
							<div class="h-2.5 rounded-full bg-topic-discursos" style="width:${(p.n / max) * 100}%"></div>
						</div>
						<span class="w-8 shrink-0 text-right text-xs font-semibold text-slate-500 tabular-nums">${p.n}</span>
					</div>`
				)
				.join('');
		}
		const botonesMedio = document.querySelectorAll<HTMLButtonElement>('.medio-btn');
		function activarBotonMedio(valor: string) {
			botonesMedio.forEach((b) => {
				const activo = b.dataset.medio === valor;
				b.classList.toggle('bg-topic-discursos', activo);
				b.classList.toggle('text-white', activo);
				b.classList.toggle('text-slate-600', !activo);
				b.classList.toggle('hover:bg-slate-100', !activo);
			});
		}
		botonesMedio.forEach((b) => {
			b.addEventListener('click', () => {
				activarBotonMedio(b.dataset.medio!);
				renderPalabras(b.dataset.medio!);
				reconstruirNubeSiHaceFalta(b.dataset.medio!);
			});
		});
		renderPalabras('__total__');

		const COLORES = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7', '#e34948'];

		// --- nube de palabras (canvas, flotando, hover = frecuencia) ---
		type NodoNube = { palabra: string; n: number; x: number; y: number; vx: number; vy: number; w: number; h: number; fontSize: number; color: string };

		const canvasNube = document.getElementById('nube-palabras') as HTMLCanvasElement;
		const ctxNube = canvasNube.getContext('2d')!;
		const tooltipNube = document.getElementById('tooltip-nube')!;
		const dprNube = Math.min(window.devicePixelRatio || 1, 2);
		let anchoNube = 0, altoNube = 0;
		let nodosNube: NodoNube[] = [];
		let nodoActivoNube: NodoNube | null = null;

		function construirNube(lista: PalabraFrecuencia[]) {
			const top = lista.slice(0, 35);
			const max = Math.max(...top.map((p) => p.n), 1);
			ctxNube.save();
			nodosNube = top.map((p, i) => {
				const fontSize = 13 + (p.n / max) * 26;
				ctxNube.font = `700 ${fontSize}px "Space Grotesk", sans-serif`;
				const w = ctxNube.measureText(p.palabra).width + 10;
				const h = fontSize + 8;
				return {
					palabra: p.palabra,
					n: p.n,
					x: Math.random() * Math.max(anchoNube - w, w) + w / 2,
					y: Math.random() * Math.max(altoNube - h, h) + h / 2,
					vx: (Math.random() - 0.5) * 0.3,
					vy: (Math.random() - 0.5) * 0.3,
					w, h, fontSize,
					color: COLORES[i % COLORES.length],
				};
			});
			ctxNube.restore();
		}

		function redimensionarNube() {
			const rect = canvasNube.getBoundingClientRect();
			anchoNube = rect.width;
			altoNube = rect.height;
			canvasNube.width = anchoNube * dprNube;
			canvasNube.height = altoNube * dprNube;
			ctxNube.setTransform(dprNube, 0, 0, dprNube, 0, 0);
			construirNube(palabrasData.top_palabras_total);
		}

		function pasoNube() {
			// deriva suave + rebote en los bordes
			for (const n of nodosNube) {
				if (Math.random() < 0.01) {
					n.vx += (Math.random() - 0.5) * 0.15;
					n.vy += (Math.random() - 0.5) * 0.15;
				}
				const vel = Math.hypot(n.vx, n.vy);
				if (vel > 0.4) { n.vx = (n.vx / vel) * 0.4; n.vy = (n.vy / vel) * 0.4; }
				n.x += n.vx; n.y += n.vy;
				if (n.x - n.w / 2 < 0 || n.x + n.w / 2 > anchoNube) n.vx *= -1;
				if (n.y - n.h / 2 < 0 || n.y + n.h / 2 > altoNube) n.vy *= -1;
				n.x = Math.max(n.w / 2, Math.min(anchoNube - n.w / 2, n.x));
				n.y = Math.max(n.h / 2, Math.min(altoNube - n.h / 2, n.y));
			}
			// separación por colisión de rectángulos — que nunca se tapen
			for (let iter = 0; iter < 2; iter++) {
				for (let i = 0; i < nodosNube.length; i++) {
					for (let j = i + 1; j < nodosNube.length; j++) {
						const a = nodosNube[i], b = nodosNube[j];
						const dx = b.x - a.x, dy = b.y - a.y;
						const solapaX = (a.w + b.w) / 2 + 6 - Math.abs(dx);
						const solapaY = (a.h + b.h) / 2 + 4 - Math.abs(dy);
						if (solapaX > 0 && solapaY > 0) {
							if (solapaX < solapaY) {
								const push = (solapaX / 2) * Math.sign(dx || 1);
								a.x -= push; b.x += push;
							} else {
								const push = (solapaY / 2) * Math.sign(dy || 1);
								a.y -= push; b.y += push;
							}
						}
					}
				}
			}
		}

		function dibujarNube() {
			ctxNube.clearRect(0, 0, anchoNube, altoNube);
			for (const n of nodosNube) {
				const atenuado = nodoActivoNube && nodoActivoNube !== n;
				ctxNube.globalAlpha = atenuado ? 0.35 : 1;
				ctxNube.font = `700 ${n.fontSize}px "Space Grotesk", sans-serif`;
				ctxNube.fillStyle = n.color;
				ctxNube.textAlign = 'center';
				ctxNube.textBaseline = 'middle';
				ctxNube.fillText(n.palabra, n.x, n.y);
			}
			ctxNube.globalAlpha = 1;
		}

		function animarNube() {
			pasoNube();
			dibujarNube();
			requestAnimationFrame(animarNube);
		}

		function nodoEnPosicionNube(px: number, py: number): NodoNube | null {
			for (let i = nodosNube.length - 1; i >= 0; i--) {
				const n = nodosNube[i];
				if (Math.abs(px - n.x) <= n.w / 2 && Math.abs(py - n.y) <= n.h / 2) return n;
			}
			return null;
		}

		canvasNube.addEventListener('mousemove', (ev) => {
			const rect = canvasNube.getBoundingClientRect();
			const px = ev.clientX - rect.left, py = ev.clientY - rect.top;
			const nodo = nodoEnPosicionNube(px, py);
			nodoActivoNube = nodo;
			if (nodo) {
				tooltipNube.classList.remove('hidden');
				tooltipNube.style.left = `${Math.min(px + 12, anchoNube - 160)}px`;
				tooltipNube.style.top = `${py + 12}px`;
				tooltipNube.innerHTML = `<p class="font-semibold text-slate-900">${nodo.palabra}</p><p class="mt-1 text-slate-500">${nodo.n} menciones</p>`;
			} else {
				tooltipNube.classList.add('hidden');
			}
		});
		canvasNube.addEventListener('mouseleave', () => { nodoActivoNube = null; tooltipNube.classList.add('hidden'); });

		let nubeIniciada = false;
		function iniciarNubeSiHaceFalta() {
			if (nubeIniciada) return;
			nubeIniciada = true;
			window.addEventListener('resize', redimensionarNube);
			redimensionarNube();
			animarNube();
		}
		function reconstruirNubeSiHaceFalta(clave: string) {
			if (!nubeIniciada) return;
			const lista = clave === '__total__' ? palabrasData.top_palabras_total : palabrasData.top_palabras_por_medio[clave] ?? [];
			construirNube(lista);
		}

		// --- tendencia (gráfico de líneas, ya calculado en el servidor —
		// solo falta el tooltip al pasar el mouse por un punto) ---
		const tooltipTendencia = document.getElementById('tooltip-tendencia');
		const wrapperTendencia = tooltipTendencia?.parentElement;
		if (tooltipTendencia && wrapperTendencia) {
			function muestraTooltipTendencia(punto: SVGCircleElement, clientX: number, clientY: number) {
				const { palabra, rank, valor } = punto.dataset;
				tooltipTendencia!.innerHTML = `<strong>${palabra}</strong><br>${rank}° lugar esa semana (${valor} menciones)`;
				const rect = wrapperTendencia!.getBoundingClientRect();
				tooltipTendencia!.style.left = `${clientX - rect.left + 12}px`;
				tooltipTendencia!.style.top = `${clientY - rect.top + 12}px`;
				tooltipTendencia!.classList.remove('hidden');
			}
			document.querySelectorAll<SVGCircleElement>('.punto-tendencia').forEach((punto) => {
				punto.addEventListener('pointerenter', (e) => muestraTooltipTendencia(punto, e.clientX, e.clientY));
				punto.addEventListener('pointermove', (e) => muestraTooltipTendencia(punto, e.clientX, e.clientY));
				punto.addEventListener('pointerleave', () => tooltipTendencia!.classList.add('hidden'));
			});
		}

		// --- comparar palabras: checkboxes que muestran/ocultan las líneas
		// ya pre-dibujadas (mismo patrón que el filtro de comunas de
		// /herramientas/delincuencia/) + el mismo tipo de tooltip que arriba.
		// Nada viene marcado por defecto — se muestra un mensaje hasta que
		// el usuario elige al menos una palabra ---
		const mensajeCompararVacio = document.getElementById('mensaje-comparar-vacio')!;
		const contenedorGraficoComparar = document.getElementById('contenedor-grafico-comparar')!;
		function actualizarVisibilidadComparar() {
			const haySeleccion = document.querySelector<HTMLInputElement>('.check-comparar:checked') !== null;
			mensajeCompararVacio.classList.toggle('hidden', haySeleccion);
			contenedorGraficoComparar.classList.toggle('hidden', !haySeleccion);
		}
		document.querySelectorAll<HTMLInputElement>('.check-comparar').forEach((chk) => {
			chk.addEventListener('change', () => {
				document
					.querySelectorAll<HTMLElement>(`.serie-comparar[data-palabra="${chk.dataset.palabra}"]`)
					.forEach((el) => (el.style.display = chk.checked ? '' : 'none'));
				actualizarVisibilidadComparar();
			});
		});
		actualizarVisibilidadComparar();
		const tooltipComparar = document.getElementById('tooltip-comparar');
		const wrapperComparar = tooltipComparar?.parentElement;
		if (tooltipComparar && wrapperComparar) {
			function muestraTooltipComparar(punto: SVGCircleElement, clientX: number, clientY: number) {
				const { palabra, valor } = punto.dataset;
				tooltipComparar!.innerHTML = `<strong>${palabra}</strong><br>${valor} menciones esa semana`;
				const rect = wrapperComparar!.getBoundingClientRect();
				tooltipComparar!.style.left = `${clientX - rect.left + 12}px`;
				tooltipComparar!.style.top = `${clientY - rect.top + 12}px`;
				tooltipComparar!.classList.remove('hidden');
			}
			document.querySelectorAll<SVGCircleElement>('.punto-comparar').forEach((punto) => {
				punto.addEventListener('pointerenter', (e) => muestraTooltipComparar(punto, e.clientX, e.clientY));
				punto.addEventListener('pointermove', (e) => muestraTooltipComparar(punto, e.clientX, e.clientY));
				punto.addEventListener('pointerleave', () => tooltipComparar!.classList.add('hidden'));
			});
		}

		// --- nube por semana: misma mecánica que la nube de "Palabras más
		// usadas", con su propio canvas y su propia data (top de cada
		// semana, no las 15 palabras seguidas) ---
		const nubeSemanaData: Record<string, PalabraFrecuencia[]> =
			JSON.parse(document.getElementById('nube-semana-data')!.textContent!);

		const canvasNubeSemana = document.getElementById('nube-semana') as HTMLCanvasElement;
		const ctxNubeSemana = canvasNubeSemana.getContext('2d')!;
		const tooltipNubeSemana = document.getElementById('tooltip-nube-semana')!;
		const dprNubeSemana = Math.min(window.devicePixelRatio || 1, 2);
		let anchoNubeSemana = 0, altoNubeSemana = 0;
		let nodosNubeSemana: NodoNube[] = [];
		let nodoActivoNubeSemana: NodoNube | null = null;

		function construirNubeSemana(lista: PalabraFrecuencia[]) {
			const top = lista.slice(0, 35);
			const max = Math.max(...top.map((p) => p.n), 1);
			ctxNubeSemana.save();
			nodosNubeSemana = top.map((p, i) => {
				const fontSize = 13 + (p.n / max) * 26;
				ctxNubeSemana.font = `700 ${fontSize}px "Space Grotesk", sans-serif`;
				const w = ctxNubeSemana.measureText(p.palabra).width + 10;
				const h = fontSize + 8;
				return {
					palabra: p.palabra,
					n: p.n,
					x: Math.random() * Math.max(anchoNubeSemana - w, w) + w / 2,
					y: Math.random() * Math.max(altoNubeSemana - h, h) + h / 2,
					vx: (Math.random() - 0.5) * 0.3,
					vy: (Math.random() - 0.5) * 0.3,
					w, h, fontSize,
					color: COLORES[i % COLORES.length],
				};
			});
			ctxNubeSemana.restore();
		}

		function redimensionarNubeSemana() {
			const rect = canvasNubeSemana.getBoundingClientRect();
			anchoNubeSemana = rect.width;
			altoNubeSemana = rect.height;
			canvasNubeSemana.width = anchoNubeSemana * dprNubeSemana;
			canvasNubeSemana.height = altoNubeSemana * dprNubeSemana;
			ctxNubeSemana.setTransform(dprNubeSemana, 0, 0, dprNubeSemana, 0, 0);
			const selectorSemana = document.getElementById('selector-semana-nube') as HTMLSelectElement;
			construirNubeSemana(nubeSemanaData[selectorSemana.value] ?? []);
		}

		function pasoNubeSemana() {
			for (const n of nodosNubeSemana) {
				if (Math.random() < 0.01) {
					n.vx += (Math.random() - 0.5) * 0.15;
					n.vy += (Math.random() - 0.5) * 0.15;
				}
				const vel = Math.hypot(n.vx, n.vy);
				if (vel > 0.4) { n.vx = (n.vx / vel) * 0.4; n.vy = (n.vy / vel) * 0.4; }
				n.x += n.vx; n.y += n.vy;
				if (n.x - n.w / 2 < 0 || n.x + n.w / 2 > anchoNubeSemana) n.vx *= -1;
				if (n.y - n.h / 2 < 0 || n.y + n.h / 2 > altoNubeSemana) n.vy *= -1;
				n.x = Math.max(n.w / 2, Math.min(anchoNubeSemana - n.w / 2, n.x));
				n.y = Math.max(n.h / 2, Math.min(altoNubeSemana - n.h / 2, n.y));
			}
			for (let iter = 0; iter < 2; iter++) {
				for (let i = 0; i < nodosNubeSemana.length; i++) {
					for (let j = i + 1; j < nodosNubeSemana.length; j++) {
						const a = nodosNubeSemana[i], b = nodosNubeSemana[j];
						const dx = b.x - a.x, dy = b.y - a.y;
						const solapaX = (a.w + b.w) / 2 + 6 - Math.abs(dx);
						const solapaY = (a.h + b.h) / 2 + 4 - Math.abs(dy);
						if (solapaX > 0 && solapaY > 0) {
							if (solapaX < solapaY) {
								const push = (solapaX / 2) * Math.sign(dx || 1);
								a.x -= push; b.x += push;
							} else {
								const push = (solapaY / 2) * Math.sign(dy || 1);
								a.y -= push; b.y += push;
							}
						}
					}
				}
			}
		}

		function dibujarNubeSemana() {
			ctxNubeSemana.clearRect(0, 0, anchoNubeSemana, altoNubeSemana);
			for (const n of nodosNubeSemana) {
				const atenuado = nodoActivoNubeSemana && nodoActivoNubeSemana !== n;
				ctxNubeSemana.globalAlpha = atenuado ? 0.35 : 1;
				ctxNubeSemana.font = `700 ${n.fontSize}px "Space Grotesk", sans-serif`;
				ctxNubeSemana.fillStyle = n.color;
				ctxNubeSemana.textAlign = 'center';
				ctxNubeSemana.textBaseline = 'middle';
				ctxNubeSemana.fillText(n.palabra, n.x, n.y);
			}
			ctxNubeSemana.globalAlpha = 1;
		}

		function animarNubeSemana() {
			pasoNubeSemana();
			dibujarNubeSemana();
			requestAnimationFrame(animarNubeSemana);
		}

		function nodoEnPosicionNubeSemana(px: number, py: number): NodoNube | null {
			for (let i = nodosNubeSemana.length - 1; i >= 0; i--) {
				const n = nodosNubeSemana[i];
				if (Math.abs(px - n.x) <= n.w / 2 && Math.abs(py - n.y) <= n.h / 2) return n;
			}
			return null;
		}

		canvasNubeSemana.addEventListener('mousemove', (ev) => {
			const rect = canvasNubeSemana.getBoundingClientRect();
			const px = ev.clientX - rect.left, py = ev.clientY - rect.top;
			const nodo = nodoEnPosicionNubeSemana(px, py);
			nodoActivoNubeSemana = nodo;
			if (nodo) {
				tooltipNubeSemana.classList.remove('hidden');
				tooltipNubeSemana.style.left = `${Math.min(px + 12, anchoNubeSemana - 160)}px`;
				tooltipNubeSemana.style.top = `${py + 12}px`;
				tooltipNubeSemana.innerHTML = `<p class="font-semibold text-slate-900">${nodo.palabra}</p><p class="mt-1 text-slate-500">${nodo.n} menciones</p>`;
			} else {
				tooltipNubeSemana.classList.add('hidden');
			}
		});
		canvasNubeSemana.addEventListener('mouseleave', () => { nodoActivoNubeSemana = null; tooltipNubeSemana.classList.add('hidden'); });

		let nubeSemanaIniciada = false;
		function iniciarNubeSemanaSiHaceFalta() {
			if (nubeSemanaIniciada) return;
			nubeSemanaIniciada = true;
			window.addEventListener('resize', redimensionarNubeSemana);
			redimensionarNubeSemana();
			animarNubeSemana();
		}
		document.getElementById('selector-semana-nube')!.addEventListener('change', (e) => {
			construirNubeSemana(nubeSemanaData[(e.target as HTMLSelectElement).value] ?? []);
		});

		// --- por medio: vista A (barras apiladas por semana) — el
		// selector solo muestra/oculta los grupos ya pre-dibujados ---
		document.getElementById('selector-semana-barras')!.addEventListener('change', (e) => {
			const idx = (e.target as HTMLSelectElement).value;
			document.querySelectorAll<HTMLElement>('.grupo-barras-semana').forEach((el) => {
				el.style.display = el.dataset.semanaIdx === idx ? '' : 'none';
			});
		});
		const tooltipBarrasSemana = document.getElementById('tooltip-barras-semana');
		const wrapperBarrasSemana = tooltipBarrasSemana?.parentElement;
		if (tooltipBarrasSemana && wrapperBarrasSemana) {
			function muestraTooltipBarrasSemana(el: HTMLElement, clientX: number, clientY: number) {
				const { medio, n } = el.dataset;
				tooltipBarrasSemana!.innerHTML = `<strong>${medio}</strong><br>${n} menciones esa semana`;
				const rect = wrapperBarrasSemana!.getBoundingClientRect();
				tooltipBarrasSemana!.style.left = `${clientX - rect.left + 12}px`;
				tooltipBarrasSemana!.style.top = `${clientY - rect.top + 12}px`;
				tooltipBarrasSemana!.classList.remove('hidden');
			}
			document.querySelectorAll<HTMLElement>('.barra-segmento').forEach((el) => {
				el.addEventListener('pointerenter', (e) => muestraTooltipBarrasSemana(el, e.clientX, e.clientY));
				el.addEventListener('pointermove', (e) => muestraTooltipBarrasSemana(el, e.clientX, e.clientY));
				el.addEventListener('pointerleave', () => tooltipBarrasSemana!.classList.add('hidden'));
			});
		}

		// --- por medio: vista B (una palabra, una línea por medio) — acá
		// sí se redibuja en el cliente porque cada palabra trae su propia
		// escala Y (ver porMedioPorPalabra en el servidor) ---
		const porMedioData: Record<
			string,
			{ ejeY: { v: number; y: number }[]; lineas: { medio: string; color: string; polyline: string; puntos: { x: number; y: number; v: number }[] }[] }
		> = JSON.parse(document.getElementById('por-medio-data')!.textContent!);

		const ejeYPorMedio = document.getElementById('eje-y-por-medio')!;
		const gLineasPorMedio = document.getElementById('lineas-por-medio')!;
		const leyendaPorMedio = document.getElementById('leyenda-por-medio')!;
		const tooltipPorMedio = document.getElementById('tooltip-por-medio')!;
		const wrapperPorMedio = tooltipPorMedio.parentElement!;

		function muestraTooltipPorMedio(medio: string, valor: number, clientX: number, clientY: number) {
			tooltipPorMedio.innerHTML = `<strong>${medio}</strong><br>${valor} menciones esa semana`;
			const rect = wrapperPorMedio.getBoundingClientRect();
			tooltipPorMedio.style.left = `${clientX - rect.left + 12}px`;
			tooltipPorMedio.style.top = `${clientY - rect.top + 12}px`;
			tooltipPorMedio.classList.remove('hidden');
		}

		// mismas medidas que el SVG del servidor (CHART_W/PAD_L/PAD_R en el
		// frontmatter) — duplicadas acá porque este bloque sí redibuja en
		// el cliente al cambiar de palabra, a diferencia del resto de los
		// gráficos de esta página
		const CHART_W_CLIENTE = 900;
		const PAD_L_CLIENTE = 40;
		const PAD_R_CLIENTE = 16;

		function renderPorMedio(palabra: string) {
			const datos = porMedioData[palabra];
			if (!datos) return;

			ejeYPorMedio.innerHTML = datos.ejeY
				.map(
					({ v, y }) => `<g class="tick-y">
						<line x1="${PAD_L_CLIENTE}" x2="${CHART_W_CLIENTE - PAD_R_CLIENTE}" y1="${y}" y2="${y}" stroke="#e2e8f0" stroke-width="1" />
						<text x="${PAD_L_CLIENTE - 8}" y="${y + 4}" text-anchor="end" font-size="11" fill="#64748b">${v}</text>
					</g>`
				)
				.join('');

			gLineasPorMedio.innerHTML = datos.lineas
				.map(
					({ medio, color, polyline, puntos }) => `
					<g>
						<polyline points="${polyline}" fill="none" stroke="${color}" stroke-width="2.5" />
						${puntos
							.map(
								(p) =>
									`<circle class="punto-por-medio" cx="${p.x}" cy="${p.y}" r="4" fill="${color}" stroke="white" stroke-width="1.5" data-medio="${medio}" data-valor="${p.v}" />`
							)
							.join('')}
					</g>`
				)
				.join('');

			leyendaPorMedio.innerHTML = datos.lineas
				.map(
					({ medio, color }) =>
						`<span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
							<span class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:${color}"></span>
							${medio}
						</span>`
				)
				.join('');

			gLineasPorMedio.querySelectorAll<SVGCircleElement>('.punto-por-medio').forEach((punto) => {
				punto.addEventListener('pointerenter', (e) =>
					muestraTooltipPorMedio(punto.dataset.medio!, Number(punto.dataset.valor), e.clientX, e.clientY)
				);
				punto.addEventListener('pointermove', (e) =>
					muestraTooltipPorMedio(punto.dataset.medio!, Number(punto.dataset.valor), e.clientX, e.clientY)
				);
				punto.addEventListener('pointerleave', () => tooltipPorMedio.classList.add('hidden'));
			});
		}

		const selectorPalabraMedio = document.getElementById('selector-palabra-medio') as HTMLSelectElement;
		selectorPalabraMedio.addEventListener('change', () => renderPorMedio(selectorPalabraMedio.value));
		renderPorMedio(selectorPalabraMedio.value);

		// --- red de coocurrencia (canvas, fuerzas, zoom/pan) ---
		interface Enlace { a: string; b: string; peso: number }
		const cooData: { nodos: PalabraFrecuencia[]; enlaces: Enlace[] } =
			JSON.parse(document.getElementById('coocurrencia-data')!.textContent!);

		type Nodo = { palabra: string; n: number; x: number; y: number; vx: number; vy: number; r: number; rTexto: number };

		const canvas = document.getElementById('red-palabras') as HTMLCanvasElement;
		const ctx = canvas.getContext('2d')!;
		const tooltipRed = document.getElementById('tooltip-red')!;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		let anchoC = 0, altoC = 0;
		let nodos: Nodo[] = [];
		const view = { zoom: 1, offsetX: 0, offsetY: 0 };

		function construirNodosRed() {
			const cx = anchoC / 2, cy = altoC / 2;
			const maxN = Math.max(...cooData.nodos.map((n) => n.n), 1);
			nodos = cooData.nodos.map((n, i) => {
				const angulo = (i / cooData.nodos.length) * Math.PI * 2;
				const radio = Math.min(anchoC, altoC) * (0.15 + Math.random() * 0.2);
				const fontSize = 7 + (n.n / maxN) * 13;
				ctx.font = `700 ${fontSize}px "Space Grotesk", sans-serif`;
				const anchoTexto = ctx.measureText(n.palabra).width;
				return {
					palabra: n.palabra,
					n: n.n,
					x: cx + Math.cos(angulo) * radio,
					y: cy + Math.sin(angulo) * radio,
					vx: 0,
					vy: 0,
					r: 6 + (n.n / maxN) * 22,
					rTexto: Math.max(6 + (n.n / maxN) * 22, anchoTexto / 2 + 3),
				};
			});
		}

		function redimensionarRed() {
			const rect = canvas.getBoundingClientRect();
			anchoC = rect.width;
			altoC = rect.height;
			canvas.width = anchoC * dpr;
			canvas.height = altoC * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			construirNodosRed();
			asentarRed();
			view.zoom = 1; view.offsetX = 0; view.offsetY = 0;
			aplicarZoomRed(1.3, anchoC / 2, altoC / 2);
		}

		function pantallaAMundoRed(px: number, py: number) {
			return { x: (px - view.offsetX) / view.zoom, y: (py - view.offsetY) / view.zoom };
		}
		function aplicarZoomRed(factor: number, cx: number, cy: number) {
			const antes = pantallaAMundoRed(cx, cy);
			view.zoom = Math.min(4, Math.max(0.4, view.zoom * factor));
			view.offsetX = cx - antes.x * view.zoom;
			view.offsetY = cy - antes.y * view.zoom;
			dibujarRed();
		}

		const maxPeso = Math.max(...cooData.enlaces.map((e) => e.peso), 1);
		const maxNodoN = Math.max(...cooData.nodos.map((n) => n.n), 1);
		let nodoActivoRed: Nodo | null = null;

		function pasoRed() {
			const centroX = anchoC / 2, centroY = altoC / 2;
			for (const n of nodos) {
				n.vx += (centroX - n.x) * 0.0005;
				n.vy += (centroY - n.y) * 0.0005;
			}
			for (let i = 0; i < nodos.length; i++) {
				for (let j = i + 1; j < nodos.length; j++) {
					const a = nodos[i], b = nodos[j];
					const dx = b.x - a.x, dy = b.y - a.y;
					const dist = Math.max(Math.hypot(dx, dy), 24);
					const f = Math.min(2200 / (dist * dist), 8);
					const fx = (dx / dist) * f, fy = (dy / dist) * f;
					a.vx -= fx; a.vy -= fy;
					b.vx += fx; b.vy += fy;
				}
			}
			for (const e of cooData.enlaces) {
				const a = nodos.find((n) => n.palabra === e.a)!;
				const b = nodos.find((n) => n.palabra === e.b)!;
				const dx = b.x - a.x, dy = b.y - a.y;
				const dist = Math.max(Math.hypot(dx, dy), 1);
				const objetivo = 160;
				const f = (dist - objetivo) * 0.004 * Math.min(e.peso / maxPeso + 0.2, 1);
				a.vx += dx * f; a.vy += dy * f;
				b.vx -= dx * f; b.vy -= dy * f;
			}
			for (const n of nodos) {
				if (
					!Number.isFinite(n.x) || !Number.isFinite(n.y) ||
					!Number.isFinite(n.vx) || !Number.isFinite(n.vy)
				) {
					n.x = anchoC / 2 + (Math.random() - 0.5) * 40;
					n.y = altoC / 2 + (Math.random() - 0.5) * 40;
					n.vx = 0; n.vy = 0;
				}
				n.vx *= 0.85; n.vy *= 0.85;
				const velocidad = Math.hypot(n.vx, n.vy);
				const VELOCIDAD_MAX = 15;
				if (velocidad > VELOCIDAD_MAX) {
					n.vx = (n.vx / velocidad) * VELOCIDAD_MAX;
					n.vy = (n.vy / velocidad) * VELOCIDAD_MAX;
				}
				n.x += n.vx; n.y += n.vy;
			}
			const PADDING_ETIQUETA = 12;
			for (let iter = 0; iter < 3; iter++) {
				for (let i = 0; i < nodos.length; i++) {
					for (let j = i + 1; j < nodos.length; j++) {
						const a = nodos[i], b = nodos[j];
						const dx = b.x - a.x, dy = b.y - a.y;
						const dist = Math.hypot(dx, dy) || 0.01;
						const minDist = a.rTexto + b.rTexto + PADDING_ETIQUETA;
						if (dist < minDist) {
							const solape = (minDist - dist) / 2;
							const nx = dx / dist, ny = dy / dist;
							a.x -= nx * solape; a.y -= ny * solape;
							b.x += nx * solape; b.y += ny * solape;
						}
					}
				}
			}
			let cx = 0, cy = 0;
			for (const n of nodos) { cx += n.x; cy += n.y; }
			cx /= nodos.length; cy /= nodos.length;
			const dCx = centroX - cx, dCy = centroY - cy;
			for (const n of nodos) {
				n.x += dCx; n.y += dCy;
				n.x = Math.max(n.r, Math.min(anchoC - n.r, n.x));
				n.y = Math.max(n.r, Math.min(altoC - n.r, n.y));
			}
		}

		function dibujarRed() {
			ctx.clearRect(0, 0, anchoC, altoC);
			ctx.save();
			ctx.translate(view.offsetX, view.offsetY);
			ctx.scale(view.zoom, view.zoom);

			for (const e of cooData.enlaces) {
				const a = nodos.find((n) => n.palabra === e.a)!;
				const b = nodos.find((n) => n.palabra === e.b)!;
				const atenuado = nodoActivoRed && nodoActivoRed.palabra !== e.a && nodoActivoRed.palabra !== e.b;
				ctx.beginPath();
				ctx.moveTo(a.x, a.y);
				ctx.lineTo(b.x, b.y);
				ctx.strokeStyle = `rgba(74,58,167,${atenuado ? 0.04 : 0.1 + (e.peso / maxPeso) * 0.3})`;
				ctx.lineWidth = (0.5 + (e.peso / maxPeso) * 2.5) / view.zoom;
				ctx.stroke();
			}
			for (const n of nodos) {
				const atenuado = nodoActivoRed && !cooData.enlaces.some(
					(e) => (e.a === nodoActivoRed!.palabra && e.b === n.palabra) || (e.b === nodoActivoRed!.palabra && e.a === n.palabra)
				) && nodoActivoRed.palabra !== n.palabra;
				ctx.globalAlpha = atenuado ? 0.25 : 1;
				ctx.beginPath();
				ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
				ctx.fillStyle = '#4a3aa7cc';
				ctx.fill();

				const fontSize = 7 + (n.n / maxNodoN) * 13;
				ctx.font = `700 ${fontSize}px "Space Grotesk", sans-serif`;
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.lineJoin = 'round';
				ctx.lineWidth = Math.max(3, fontSize * 0.22);
				ctx.strokeStyle = 'rgba(42,35,88,0.85)';
				ctx.strokeText(n.palabra, n.x, n.y);
				ctx.fillStyle = '#fff';
				ctx.fillText(n.palabra, n.x, n.y);
				ctx.globalAlpha = 1;
			}
			ctx.restore();
		}

		function asentarRed(iteraciones = 600) {
			for (let i = 0; i < iteraciones; i++) pasoRed();
			dibujarRed();
		}

		function nodoEnPosicionRed(px: number, py: number): Nodo | null {
			const m = pantallaAMundoRed(px, py);
			for (let i = nodos.length - 1; i >= 0; i--) {
				if (Math.hypot(nodos[i].x - m.x, nodos[i].y - m.y) <= nodos[i].r + 2) return nodos[i];
			}
			return null;
		}

		let arrastrandoRed = false;
		let inicioArrastreRed = { px: 0, py: 0, offsetX: 0, offsetY: 0 };

		canvas.addEventListener('mousedown', (ev) => {
			arrastrandoRed = true;
			const rect = canvas.getBoundingClientRect();
			inicioArrastreRed = { px: ev.clientX - rect.left, py: ev.clientY - rect.top, offsetX: view.offsetX, offsetY: view.offsetY };
			tooltipRed.classList.add('hidden');
		});
		window.addEventListener('mouseup', () => { arrastrandoRed = false; });
		canvas.addEventListener('mousemove', (ev) => {
			const rect = canvas.getBoundingClientRect();
			const px = ev.clientX - rect.left, py = ev.clientY - rect.top;
			if (arrastrandoRed) {
				view.offsetX = inicioArrastreRed.offsetX + (px - inicioArrastreRed.px);
				view.offsetY = inicioArrastreRed.offsetY + (py - inicioArrastreRed.py);
				nodoActivoRed = null;
				tooltipRed.classList.add('hidden');
				canvas.style.cursor = 'grabbing';
				dibujarRed();
				return;
			}
			const nodo = nodoEnPosicionRed(px, py);
			const cambioActivo = nodo !== nodoActivoRed;
			nodoActivoRed = nodo;
			canvas.style.cursor = nodo ? 'pointer' : 'grab';
			if (nodo) {
				tooltipRed.classList.remove('hidden');
				tooltipRed.style.left = `${Math.min(px + 12, anchoC - 200)}px`;
				tooltipRed.style.top = `${py + 12}px`;
				tooltipRed.innerHTML = `<p class="font-semibold text-slate-900">${nodo.palabra}</p><p class="mt-1 text-slate-500">${nodo.n} menciones</p>`;
			} else {
				tooltipRed.classList.add('hidden');
			}
			if (cambioActivo) dibujarRed();
		});
		canvas.addEventListener('mouseleave', () => {
			arrastrandoRed = false;
			nodoActivoRed = null;
			tooltipRed.classList.add('hidden');
			dibujarRed();
		});
		canvas.addEventListener('wheel', (ev) => {
			ev.preventDefault();
			const rect = canvas.getBoundingClientRect();
			aplicarZoomRed(ev.deltaY < 0 ? 1.12 : 1 / 1.12, ev.clientX - rect.left, ev.clientY - rect.top);
		}, { passive: false });
		canvas.addEventListener('touchstart', (ev) => {
			if (ev.touches.length !== 1) return;
			const rect = canvas.getBoundingClientRect();
			arrastrandoRed = true;
			inicioArrastreRed = { px: ev.touches[0].clientX - rect.left, py: ev.touches[0].clientY - rect.top, offsetX: view.offsetX, offsetY: view.offsetY };
		}, { passive: true });
		canvas.addEventListener('touchmove', (ev) => {
			if (!arrastrandoRed || ev.touches.length !== 1) return;
			ev.preventDefault();
			const rect = canvas.getBoundingClientRect();
			const px = ev.touches[0].clientX - rect.left, py = ev.touches[0].clientY - rect.top;
			view.offsetX = inicioArrastreRed.offsetX + (px - inicioArrastreRed.px);
			view.offsetY = inicioArrastreRed.offsetY + (py - inicioArrastreRed.py);
			dibujarRed();
		}, { passive: false });
		canvas.addEventListener('touchend', () => { arrastrandoRed = false; });
		document.getElementById('zoom-in')!.addEventListener('click', () => aplicarZoomRed(1.3, anchoC / 2, altoC / 2));
		document.getElementById('zoom-out')!.addEventListener('click', () => aplicarZoomRed(1 / 1.3, anchoC / 2, altoC / 2));

		let redIniciada = false;
		function iniciarRedSiHaceFalta() {
			if (redIniciada) return;
			redIniciada = true;
			window.addEventListener('resize', redimensionarRed);
			redimensionarRed();
		}
	</script>
</Layout>
