---
import Layout from '../../layouts/Layout.astro';
import { comunas } from '../../lib/datos';
import { COLOR_COMUNA } from '../../lib/colores-comunas';

// Mismo orden geográfico real (provincias de Elqui, Limarí y Choapa, de
// norte a sur) usado en /autoridades/ y en las otras herramientas — se usa
// solo para asignar colores consistentes, el ranking en sí va por densidad.
const COMUNA_ORDEN = [
	'la-higuera', 'la-serena', 'coquimbo', 'vicuna', 'paihuano', 'andacollo',
	'rio-hurtado', 'monte-patria', 'ovalle', 'punitaqui', 'combarbala',
	'canela', 'illapel', 'salamanca', 'los-vilos',
];
const ORDEN_COMUNA_IDX = Object.fromEntries(COMUNA_ORDEN.map((id, i) => [id, i]));

const filas = comunas
	.filter((c) => c.poblacion && c.superficie_km2)
	.map((c) => ({
		id: c.id,
		nombre: c.nombre,
		provincia: c.provincia,
		poblacion: c.poblacion as number,
		superficie: c.superficie_km2 as number,
		densidad: Math.round(((c.poblacion as number) / (c.superficie_km2 as number)) * 10) / 10,
	}))
	.sort((a, b) => b.densidad - a.densidad);

const maxDensidad = filas[0]?.densidad ?? 1;
const masDensa = filas[0];
const menosDensa = filas[filas.length - 1];
const ratio = menosDensa && menosDensa.densidad > 0 ? Math.round(masDensa.densidad / menosDensa.densidad) : null;

const superficieTotal = Math.round(filas.reduce((s, f) => s + f.superficie, 0));
const poblacionTotal = filas.reduce((s, f) => s + f.poblacion, 0);
const densidadRegional = Math.round((poblacionTotal / superficieTotal) * 10) / 10;
---

<Layout
	title="Densidad poblacional — OPRC"
	description="Habitantes por km² en cada una de las 15 comunas de la Región de Coquimbo — de las más concentradas a las más dispersas."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/herramientas/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">&larr; Herramientas</a>
			<p class="mt-4 text-sm font-semibold tracking-widest text-brand-300 uppercase">Herramientas</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Densidad poblacional
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				{masDensa && menosDensa && ratio ? (
					<>
						{masDensa.nombre} tiene {masDensa.densidad} hab/km² — {ratio} veces más densa que{' '}
						{menosDensa.nombre} ({menosDensa.densidad} hab/km²), la comuna más dispersa de la región.
					</>
				) : (
					'Habitantes por km² en cada comuna de la Región de Coquimbo.'
				)}
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<details class="group rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
			<summary class="cursor-pointer text-sm font-semibold text-slate-700 marker:content-none">
				<span class="inline-block transition group-open:rotate-90">&#9656;</span>
				¿Qué mide la densidad y por qué importa?
			</summary>
			<div class="mt-3 space-y-3 text-sm text-slate-600">
				<p>
					La densidad es la <strong>población dividida por la superficie</strong> (habitantes por
					km²). Dos comunas pueden tener una población parecida y aun así ser muy distintas para
					gobernar: una ciudad compacta necesita infraestructura distinta a un territorio rural
					disperso con la misma cantidad de gente repartida en un área mucho mayor.
				</p>
				<p>
					Coquimbo y La Serena, pese a estar contiguas, concentran la enorme mayoría de la
					población regional en una fracción pequeña del territorio — el resto de la región es
					mayoritariamente rural y dispersa, con densidades que pueden ser 100 veces menores.
				</p>
			</div>
		</details>

		<div class="mt-8 space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
			{filas.map((f) => {
				const ancho = maxDensidad ? (f.densidad / maxDensidad) * 100 : 0;
				return (
					<div>
						<div class="flex items-baseline justify-between gap-3">
							<span class="text-sm font-medium text-slate-700">
								<span class="mr-2 inline-block h-2.5 w-2.5 rounded-full align-middle" style={`background-color:${COLOR_COMUNA[f.id]}`}></span>
								{f.nombre}
							</span>
							<span class="text-sm font-semibold text-slate-900">{f.densidad} hab/km²</span>
						</div>
						<div class="mt-1 h-5 rounded bg-slate-200">
							<div class="h-5 rounded" style={`width:${ancho}%;background-color:${COLOR_COMUNA[f.id]}`}></div>
						</div>
						<p class="mt-1 text-xs text-slate-400">
							{f.poblacion.toLocaleString('es-CL')} hab. en {f.superficie.toLocaleString('es-CL')} km² &mdash; {f.provincia}
						</p>
					</div>
				);
			})}
		</div>

		<p class="mt-4 text-sm text-slate-500">
			Toda la región suma {poblacionTotal.toLocaleString('es-CL')} habitantes en {superficieTotal.toLocaleString('es-CL')} km²
			 — una densidad regional promedio de {densidadRegional} hab/km², aunque como muestra el gráfico esa cifra esconde
			diferencias enormes entre comunas.
		</p>

		<p class="mt-6 text-xs text-slate-400">
			Fuentes: población, Censo 2024 (INE); superficie, División Político Administrativa 2023 (SUBDERE),
			ambos vía el catastro abierto de{' '}
			<a
				href="https://github.com/bastianolea/densidad_poblacional_comunas"
				target="_blank"
				rel="noopener"
				class="font-medium text-brand-600 hover:underline"
			>
				Bastián Olea Herrera
			</a>, filtrado a las 15 comunas de la Región de Coquimbo.
		</p>
	</main>
</Layout>
