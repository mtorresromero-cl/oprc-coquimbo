---
import Layout from '../layouts/Layout.astro';
import { votaciones, autoridades, VOTO_LABEL } from '../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}
---

<Layout title="Votaciones recientes — OPRC">
	<main class="mx-auto max-w-3xl px-6 py-12">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900">Votaciones recientes</h1>
		<p class="mt-2 text-slate-600">
			Votaciones del Senado en las que participó alguno de los 3 senadores de la Región de
			Coquimbo. Los diputados de la región aún no tienen datos de votaciones disponibles — la
			fuente oficial para diputados no está publicando esos datos actualmente.
		</p>

		{
			votaciones.length === 0 && (
				<p class="mt-8 text-sm text-slate-500">Todavía no hay votaciones registradas.</p>
			)
		}

		<ul class="mt-8 space-y-4">
			{votaciones.map((v) => (
				<li class="rounded-lg border border-slate-200 p-4">
					<div class="flex items-center justify-between text-xs text-slate-500">
						<span>{v.fecha}</span>
						<span class={v.resultado === 'aprobado' ? 'text-emerald-600' : 'text-red-600'}>
							{v.resultado === 'aprobado' ? 'Aprobado' : 'Rechazado'} ({v.votos_favor} a favor /{' '}
							{v.votos_contra} en contra)
						</span>
					</div>
					<p class="mt-2 text-sm text-slate-800">{v.descripcion}</p>
					<ul class="mt-3 flex flex-wrap gap-2">
						{v.votos.map((voto) => (
							<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
								<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
									{nombreAutoridad(voto.autoridad_id)}
								</a>
								: {VOTO_LABEL[voto.voto] ?? voto.voto}
							</li>
						))}
					</ul>
					{v.fuente_url && (
						<a
							href={v.fuente_url}
							target="_blank"
							rel="noopener"
							class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline"
						>
							Fuente oficial
						</a>
					)}
				</li>
			))}
		</ul>
	</main>
</Layout>
