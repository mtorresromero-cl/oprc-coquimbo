---
import Layout from '../../layouts/Layout.astro';
import { matricesGastoParlamentario, detalleGastosOperacionales, equiposDiputados, fotoAutoridad, nombreMes } from '../../lib/datos';

const matrices = matricesGastoParlamentario();
const meses = matrices[0]?.meses ?? [];
const detalleOperacionales = detalleGastosOperacionales();
const equipos = equiposDiputados();
const equiposGrafo = equipos.map((e) => ({ ...e, foto: fotoAutoridad(e.id) }));
const totalAsesores = equipos.reduce((n, e) => n + e.asesores.length, 0);

function iniciales(nombre: string): string {
	const partes = nombre.split(' ').filter(Boolean);
	return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
}

function formatoValor(unidad: string, valor: number | null): string {
	if (valor === null) return '0';
	if (unidad === '$') return `$${valor.toLocaleString('es-CL')}`;
	return `${valor.toLocaleString('es-CL')} ${unidad}`;
}
---

<Layout
	title="Gasto parlamentario — OPRC"
	description="Gastos operacionales, asesorías externas, pasajes aéreos y personal de apoyo de los 7 diputados de la Región de Coquimbo, mes a mes, según camara.cl."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/parlamentarios/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">
				← Volver a Parlamentarios
			</a>
			<p class="mt-6 text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Gasto parlamentario
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Los 7 diputados de la Región de Coquimbo (Distrito 5), mes a mes, según lo que camara.cl
				publica por transparencia. Datos hasta julio de 2026.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap gap-2">
			{matrices.map((m, i) => (
				<button
					type="button"
					data-categoria={m.categoria}
					class:list={[
						'categoria-btn cursor-pointer rounded-md px-4 py-2 text-sm font-semibold',
						i === 0
							? 'bg-topic-gasto text-white'
							: 'border border-slate-300 text-slate-700 hover:bg-slate-50',
					]}
				>
					{m.label}
				</button>
			))}
		</div>

		{matrices.map((m, i) => (
			<section
				id={m.categoria === 'personal_apoyo' ? 'personal-apoyo' : undefined}
				class:list={['matriz mt-8 scroll-mt-24', i !== 0 && 'hidden']}
				data-matriz={m.categoria}
			>
				<h2 class="text-xl font-semibold text-slate-900">{m.label}</h2>
				<p class="mt-2 max-w-3xl text-sm text-slate-500">{m.nota}</p>

				<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
					<table class="w-full text-sm">
						<thead class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<tr>
								<th class="px-4 py-2">Diputado/a</th>
								{meses.map((mes) => (
									<th class="px-4 py-2 text-right whitespace-nowrap">{nombreMes(mes)}</th>
								))}
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							{m.filas.map((fila) => (
								<tr>
									<td class="px-4 py-2.5">
										<a
											href={`/autoridades/${fila.id}/`}
											class="flex items-center gap-2.5 font-medium text-slate-900 hover:text-brand-600 hover:underline"
										>
											{fila.foto ? (
												<img src={fila.foto} alt="" class="h-7 w-7 shrink-0 rounded-full border-2 border-slate-100 object-cover" />
											) : (
												<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-slate-100 bg-brand-50 text-[10px] font-bold text-brand-700">
													{iniciales(fila.nombre)}
												</span>
											)}
											{fila.nombre}
										</a>
									</td>
									{fila.celdas.map((celda) => (
										<td class="px-4 py-2.5 text-right whitespace-nowrap tabular-nums text-slate-700">
											{formatoValor(m.unidad, celda.valor)}
											{!celda.publicado && (
												<sup class="ml-0.5 text-topic-gasto" title="Sin dato publicado — ver nota">
													*
												</sup>
											)}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<p class="mt-3 text-xs text-slate-400">
					<sup class="text-topic-gasto">*</sup> Sin dato publicado por la Cámara para ese mes — el 0
					no es un valor verificado, es la ausencia de publicación. Fuente:{' '}
					<a
						href="https://www.camara.cl/diputados/detalle/"
						target="_blank"
						rel="noopener"
						class="text-slate-500 hover:text-brand-600 hover:underline"
					>
						camara.cl
					</a>
					, ficha de transparencia de cada diputado/a.
				</p>

				{m.categoria === 'gastos_operacionales' && (
					<div class="mt-10">
						<h3 class="text-base font-semibold text-slate-900">Detalle por ítem</h3>
						<p class="mt-1 max-w-2xl text-sm text-slate-500">
							Elige diputado/a y mes para ver cada concepto de gasto operacional, no solo el total.
						</p>
						<div class="mt-4 flex flex-wrap gap-3">
							<select id="detalle-op-diputado" class="rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
								{detalleOperacionales.map((d) => <option value={d.id}>{d.nombre}</option>)}
							</select>
							<select id="detalle-op-mes" class="rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
								{meses.map((mes) => <option value={mes}>{nombreMes(mes)}</option>)}
							</select>
						</div>
						<div id="detalle-op-lista" class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm"></div>
					</div>
				)}

				{m.categoria === 'personal_apoyo' && (
					<div class="mt-10">
						<h3 class="text-base font-semibold text-slate-900">Equipo por diputado/a</h3>
						<p class="mt-1 max-w-2xl text-sm text-slate-500">
							Nombre, cargo y sueldo de cada persona del equipo, julio 2026 (último mes con datos completos).
						</p>
						<select id="equipo-diputado" class="mt-4 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
							{equipos.map((e) => <option value={e.id}>{e.nombre}</option>)}
						</select>
						<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
							<table class="w-full text-sm">
								<thead class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
									<tr><th class="px-4 py-2">Nombre</th><th class="px-4 py-2">Cargo</th><th class="px-4 py-2 text-right">Sueldo</th></tr>
								</thead>
								<tbody id="equipo-lista" class="divide-y divide-slate-100"></tbody>
							</table>
						</div>

						<h3 class="mt-10 text-base font-semibold text-slate-900">Red del equipo</h3>
						<p class="mt-1 max-w-2xl text-sm text-slate-500">
							Los {totalAsesores} profesionales, administrativos y asesores de los 7 equipos, todos
							a la vez. El tamaño del punto es proporcional al sueldo. Arrastra para mover, rueda o
							pellizca para acercar.
						</p>
						<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
							<canvas id="red-equipo" class="block h-[420px] w-full touch-none"></canvas>
							<div
								id="tooltip-equipo"
								class="pointer-events-none absolute z-10 hidden max-w-[16rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"
							></div>
							<div class="absolute right-3 bottom-3 flex flex-col gap-1.5">
								<button id="equipo-zoom-in" type="button" aria-label="Acercar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">+</button>
								<button id="equipo-zoom-out" type="button" aria-label="Alejar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">−</button>
								<button id="equipo-zoom-reset" type="button" aria-label="Restablecer vista" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 shadow-sm hover:bg-slate-50">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 12a9 9 0 1 1 3 6.7M3 12v5h5"></path></svg>
								</button>
							</div>
						</div>
						<div id="leyenda-equipo" class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-600"></div>
					</div>
				)}
			</section>
		))}
	</main>

	<script type="application/json" id="detalle-op-data" set:html={JSON.stringify(detalleOperacionales)} />
	<script type="application/json" id="equipos-data" set:html={JSON.stringify(equipos)} />
	<script type="application/json" id="equipos-grafo-data" set:html={JSON.stringify(equiposGrafo)} />

	<script>
		function activarCategoria(categoria: string) {
			const btn = document.querySelector<HTMLButtonElement>(`.categoria-btn[data-categoria="${categoria}"]`);
			if (!btn) return;
			document.querySelectorAll<HTMLButtonElement>('.categoria-btn').forEach((b) => {
				const activo = b === btn;
				b.classList.toggle('bg-topic-gasto', activo);
				b.classList.toggle('text-white', activo);
				b.classList.toggle('border', !activo);
				b.classList.toggle('border-slate-300', !activo);
				b.classList.toggle('text-slate-700', !activo);
				b.classList.toggle('hover:bg-slate-50', !activo);
			});
			document.querySelectorAll<HTMLElement>('.matriz').forEach((sec) => {
				sec.classList.toggle('hidden', sec.dataset.matriz !== categoria);
			});
			// el canvas de la red mide 0x0 mientras su pestaña está oculta
			// (display:none) — recién se inicia cuando se muestra de verdad
			if (categoria === 'personal_apoyo') requestAnimationFrame(() => iniciarGrafoSiHaceFalta());
		}

		document.querySelectorAll<HTMLButtonElement>('.categoria-btn').forEach((btn) => {
			btn.addEventListener('click', () => activarCategoria(btn.dataset.categoria!));
		});

		// llegar con #personal-apoyo (ej. desde el perfil de una autoridad)
		// abre esa pestaña directamente en vez de dejarla oculta
		if (location.hash === '#personal-apoyo') activarCategoria('personal_apoyo');

		// --- detalle de gastos operacionales por diputado/mes ---
		interface ItemGasto { concepto: string; monto: number }
		interface DetalleDiputado { id: string; nombre: string; meses: { mes: number; items: ItemGasto[] }[] }
		const detalleOp: DetalleDiputado[] = JSON.parse(document.getElementById('detalle-op-data')!.textContent!);

		function renderDetalleOp() {
			const selDiputado = document.getElementById('detalle-op-diputado') as HTMLSelectElement;
			const selMes = document.getElementById('detalle-op-mes') as HTMLSelectElement;
			const cont = document.getElementById('detalle-op-lista');
			if (!cont) return;
			const dip = detalleOp.find((d) => d.id === selDiputado.value);
			const items = dip?.meses.find((m) => m.mes === Number(selMes.value))?.items ?? [];
			if (items.length === 0) {
				cont.innerHTML = '<p class="p-4 text-sm text-slate-500">Sin ítems con gasto ese mes.</p>';
				return;
			}
			cont.innerHTML = items
				.map(
					(it) => `
					<div class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm">
						<span class="text-slate-700">${it.concepto}</span>
						<span class="shrink-0 font-semibold text-slate-900 tabular-nums">$${it.monto.toLocaleString('es-CL')}</span>
					</div>`
				)
				.join('');
		}
		document.getElementById('detalle-op-diputado')?.addEventListener('change', renderDetalleOp);
		document.getElementById('detalle-op-mes')?.addEventListener('change', renderDetalleOp);
		if (document.getElementById('detalle-op-lista')) renderDetalleOp();

		// --- equipo (personal de apoyo) por diputado ---
		interface Asesor { nombre: string; cargo: string; renta: number | null }
		interface EquipoDiputado { id: string; nombre: string; asesores: Asesor[] }
		const equiposData: EquipoDiputado[] = JSON.parse(document.getElementById('equipos-data')!.textContent!);

		function renderEquipo() {
			const sel = document.getElementById('equipo-diputado') as HTMLSelectElement;
			const cont = document.getElementById('equipo-lista');
			if (!cont) return;
			const equipo = equiposData.find((e) => e.id === sel.value);
			const asesores = [...(equipo?.asesores ?? [])].sort((a, b) => (b.renta ?? 0) - (a.renta ?? 0));
			cont.innerHTML = asesores
				.map(
					(a) => `
					<tr>
						<td class="px-4 py-2.5 font-medium text-slate-900">${a.nombre}</td>
						<td class="px-4 py-2.5 text-slate-700">${a.cargo}</td>
						<td class="px-4 py-2.5 text-right font-semibold text-slate-900 tabular-nums">${a.renta ? `$${a.renta.toLocaleString('es-CL')}` : '—'}</td>
					</tr>`
				)
				.join('');
		}
		document.getElementById('equipo-diputado')?.addEventListener('change', renderEquipo);
		if (document.getElementById('equipo-lista')) renderEquipo();

		// --- red del equipo (canvas, fuerzas ancladas por diputado/a) ---
		const canvasEquipo = document.getElementById('red-equipo') as HTMLCanvasElement | null;
		if (canvasEquipo) {
			interface AsesorGrafo { nombre: string; cargo: string; renta: number | null }
			interface EquipoGrafo { id: string; nombre: string; foto: string | null; asesores: AsesorGrafo[] }
			const equiposGrafoData: EquipoGrafo[] = JSON.parse(document.getElementById('equipos-grafo-data')!.textContent!);

			// mismos 7 tonos categoricos del sistema (sin el rojo, reservado
			// para la marca) — uno fijo por diputado/a
			const COLORES_DIPUTADO = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7'];

			type NodoEquipo = {
				tipo: 'diputado' | 'asesor';
				id: string;
				nombre: string;
				cargo?: string;
				renta?: number | null;
				color: string;
				equipoId: string;
				x: number; y: number; vx: number; vy: number;
				homeX: number; homeY: number;
				r: number;
			};

			const ctxEquipo = canvasEquipo.getContext('2d')!;
			const tooltipEquipo = document.getElementById('tooltip-equipo')!;
			const dprEquipo = Math.min(window.devicePixelRatio || 1, 2);
			let anchoE = 0, altoE = 0;
			let nodosEquipo: NodoEquipo[] = [];

			const fotosEquipo = new Map<string, HTMLImageElement>();
			for (const e of equiposGrafoData) {
				if (!e.foto) continue;
				const img = new Image();
				img.src = e.foto;
				fotosEquipo.set(e.id, img);
			}

			const viewEquipo = { zoom: 1, offsetX: 0, offsetY: 0 };
			function pantallaAMundoEquipo(px: number, py: number) {
				return { x: (px - viewEquipo.offsetX) / viewEquipo.zoom, y: (py - viewEquipo.offsetY) / viewEquipo.zoom };
			}
			function aplicarZoomEquipo(factor: number, cx: number, cy: number) {
				const antes = pantallaAMundoEquipo(cx, cy);
				viewEquipo.zoom = Math.min(4, Math.max(0.4, viewEquipo.zoom * factor));
				viewEquipo.offsetX = cx - antes.x * viewEquipo.zoom;
				viewEquipo.offsetY = cy - antes.y * viewEquipo.zoom;
			}
			function restablecerVistaEquipo() {
				viewEquipo.zoom = 1; viewEquipo.offsetX = 0; viewEquipo.offsetY = 0;
			}

			function construirNodosEquipo() {
				const cx = anchoE / 2;
				const cy = altoE * 0.54;
				const radioX = anchoE * 0.32;
				const radioY = altoE * 0.28;
				const maxRenta = Math.max(...equiposGrafoData.flatMap((e) => e.asesores.map((a) => a.renta ?? 0)), 1);

				nodosEquipo = [];
				equiposGrafoData.forEach((equipo, i) => {
					const angulo = (i / equiposGrafoData.length) * Math.PI * 2 - Math.PI / 2;
					const homeX = cx + Math.cos(angulo) * radioX;
					const homeY = cy + Math.sin(angulo) * radioY;
					const color = COLORES_DIPUTADO[i % COLORES_DIPUTADO.length];

					nodosEquipo.push({
						tipo: 'diputado', id: equipo.id, nombre: equipo.nombre, color, equipoId: equipo.id,
						x: homeX, y: homeY, vx: 0, vy: 0, homeX, homeY, r: 18,
					});

					equipo.asesores.forEach((asesor, j) => {
						const jitterAngulo = Math.random() * Math.PI * 2;
						const jitterRadio = 25 + Math.random() * 16;
						const rentaNorm = (asesor.renta ?? 0) / maxRenta;
						nodosEquipo.push({
							tipo: 'asesor', id: `${equipo.id}-${j}`, nombre: asesor.nombre, cargo: asesor.cargo,
							renta: asesor.renta, color, equipoId: equipo.id,
							x: homeX + Math.cos(jitterAngulo) * jitterRadio,
							y: homeY + Math.sin(jitterAngulo) * jitterRadio,
							vx: 0, vy: 0, homeX, homeY,
							r: 3 + Math.sqrt(rentaNorm) * 8,
						});
					});
				});
			}

			function inicialesEquipo(nombre: string): string {
				const partes = nombre.split(' ').filter(Boolean);
				return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
			}

			function redimensionarEquipo() {
				const rect = canvasEquipo!.getBoundingClientRect();
				anchoE = rect.width; altoE = rect.height;
				canvasEquipo!.width = anchoE * dprEquipo;
				canvasEquipo!.height = altoE * dprEquipo;
				ctxEquipo.setTransform(dprEquipo, 0, 0, dprEquipo, 0, 0);
				construirNodosEquipo();
			}

			let nodoActivoEquipo: NodoEquipo | null = null;

			function pasoEquipo() {
				for (const n of nodosEquipo) {
					if (n.tipo === 'diputado') continue;
					n.vx += (n.homeX - n.x) * 0.02;
					n.vy += (n.homeY - n.y) * 0.02;
				}
				for (let i = 0; i < nodosEquipo.length; i++) {
					for (let j = i + 1; j < nodosEquipo.length; j++) {
						const a = nodosEquipo[i], b = nodosEquipo[j];
						const dx = b.x - a.x, dy = b.y - a.y;
						const dist = Math.max(Math.hypot(dx, dy), 1);
						const minDist = a.r + b.r + 4;
						if (dist < minDist * 3) {
							const fuerza = ((minDist * 3 - dist) / dist) * 0.6;
							const fx = dx * fuerza, fy = dy * fuerza;
							if (a.tipo === 'asesor') { a.vx -= fx; a.vy -= fy; }
							if (b.tipo === 'asesor') { b.vx += fx; b.vy += fy; }
						}
					}
				}
				for (const n of nodosEquipo) {
					if (n.tipo === 'diputado') continue;
					n.vx *= 0.82; n.vy *= 0.82;
					n.x += n.vx; n.y += n.vy;
					n.x = Math.max(n.r + 2, Math.min(anchoE - n.r - 2, n.x));
					n.y = Math.max(n.r + 2, Math.min(altoE - n.r - 2, n.y));
				}
			}

			function dibujarEquipo() {
				ctxEquipo.clearRect(0, 0, anchoE, altoE);
				ctxEquipo.save();
				ctxEquipo.translate(viewEquipo.offsetX, viewEquipo.offsetY);
				ctxEquipo.scale(viewEquipo.zoom, viewEquipo.zoom);

				for (const n of nodosEquipo) {
					if (n.tipo !== 'asesor') continue;
					if (nodoActivoEquipo && nodoActivoEquipo.equipoId !== n.equipoId) continue;
					const home = nodosEquipo.find((d) => d.tipo === 'diputado' && d.equipoId === n.equipoId)!;
					ctxEquipo.beginPath();
					ctxEquipo.moveTo(home.x, home.y);
					ctxEquipo.lineTo(n.x, n.y);
					ctxEquipo.strokeStyle = `${n.color}30`;
					ctxEquipo.lineWidth = 1 / viewEquipo.zoom;
					ctxEquipo.stroke();
				}

				for (const n of nodosEquipo) {
					const atenuado = nodoActivoEquipo && nodoActivoEquipo.equipoId !== n.equipoId;
					ctxEquipo.globalAlpha = atenuado ? 0.15 : 1;
					const foto = n.tipo === 'diputado' ? fotosEquipo.get(n.equipoId) : undefined;
					if (foto && foto.complete && foto.naturalWidth > 0) {
						ctxEquipo.save();
						ctxEquipo.beginPath();
						ctxEquipo.arc(n.x, n.y, n.r, 0, Math.PI * 2);
						ctxEquipo.clip();
						ctxEquipo.drawImage(foto, n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
						ctxEquipo.restore();
						ctxEquipo.beginPath();
						ctxEquipo.arc(n.x, n.y, n.r, 0, Math.PI * 2);
						ctxEquipo.lineWidth = 2 / viewEquipo.zoom;
						ctxEquipo.strokeStyle = n.color;
						ctxEquipo.stroke();
					} else {
						ctxEquipo.beginPath();
						ctxEquipo.arc(n.x, n.y, n.r, 0, Math.PI * 2);
						ctxEquipo.fillStyle = n.tipo === 'diputado' ? n.color : `${n.color}cc`;
						ctxEquipo.fill();
						if (n.tipo === 'diputado') {
							ctxEquipo.lineWidth = 2 / viewEquipo.zoom;
							ctxEquipo.strokeStyle = '#fff';
							ctxEquipo.stroke();
							ctxEquipo.fillStyle = '#fff';
							ctxEquipo.font = 'bold 9px "Space Grotesk", sans-serif';
							ctxEquipo.textAlign = 'center';
							ctxEquipo.textBaseline = 'middle';
							ctxEquipo.fillText(inicialesEquipo(n.nombre), n.x, n.y);
						}
					}
					ctxEquipo.globalAlpha = 1;
				}

				for (const n of nodosEquipo) {
					if (n.tipo !== 'diputado') continue;
					ctxEquipo.globalAlpha = nodoActivoEquipo && nodoActivoEquipo.equipoId !== n.equipoId ? 0.3 : 1;
					ctxEquipo.fillStyle = '#334155';
					ctxEquipo.font = '600 10px "Space Grotesk", sans-serif';
					ctxEquipo.textAlign = 'center';
					ctxEquipo.fillText(n.nombre.split(' ').slice(0, 2).join(' '), n.x, n.y + n.r + 13);
					ctxEquipo.globalAlpha = 1;
				}
				ctxEquipo.restore();
			}

			function animarEquipo() {
				pasoEquipo();
				dibujarEquipo();
				requestAnimationFrame(animarEquipo);
			}

			function nodoEnPosicionEquipo(px: number, py: number): NodoEquipo | null {
				const m = pantallaAMundoEquipo(px, py);
				for (let i = nodosEquipo.length - 1; i >= 0; i--) {
					const n = nodosEquipo[i];
					if (Math.hypot(n.x - m.x, n.y - m.y) <= n.r + 2) return n;
				}
				return null;
			}

			function formatoCLPEquipo(monto: number) {
				return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(monto);
			}

			function mostrarTooltipEquipo(nodo: NodoEquipo, px: number, py: number) {
				tooltipEquipo.classList.remove('hidden');
				tooltipEquipo.style.left = `${Math.min(px + 12, anchoE - 240)}px`;
				tooltipEquipo.style.top = `${py + 12}px`;
				if (nodo.tipo === 'diputado') {
					const equipo = equiposGrafoData.find((e) => e.id === nodo.equipoId)!;
					const totalEquipo = equipo.asesores.reduce((s, a) => s + (a.renta ?? 0), 0);
					tooltipEquipo.innerHTML = `<p class="font-semibold text-slate-900">${nodo.nombre}</p><p class="mt-1 text-slate-500">${equipo.asesores.length} personas · ${formatoCLPEquipo(totalEquipo)}/mes en total</p>`;
				} else {
					tooltipEquipo.innerHTML = `<p class="font-semibold text-slate-900">${nodo.nombre}</p><p class="mt-1 text-slate-500">${nodo.cargo}${nodo.renta ? ` · ${formatoCLPEquipo(nodo.renta)}/mes` : ''}</p>`;
				}
			}

			let arrastrandoEquipo = false;
			let arrastreInicioEquipo = { px: 0, py: 0, offsetX: 0, offsetY: 0 };

			canvasEquipo.addEventListener('mousedown', (ev) => {
				arrastrandoEquipo = true;
				const rect = canvasEquipo!.getBoundingClientRect();
				arrastreInicioEquipo = { px: ev.clientX - rect.left, py: ev.clientY - rect.top, offsetX: viewEquipo.offsetX, offsetY: viewEquipo.offsetY };
				tooltipEquipo.classList.add('hidden');
			});
			window.addEventListener('mouseup', () => { arrastrandoEquipo = false; });
			canvasEquipo.addEventListener('mousemove', (ev) => {
				const rect = canvasEquipo!.getBoundingClientRect();
				const px = ev.clientX - rect.left, py = ev.clientY - rect.top;
				if (arrastrandoEquipo) {
					viewEquipo.offsetX = arrastreInicioEquipo.offsetX + (px - arrastreInicioEquipo.px);
					viewEquipo.offsetY = arrastreInicioEquipo.offsetY + (py - arrastreInicioEquipo.py);
					nodoActivoEquipo = null;
					tooltipEquipo.classList.add('hidden');
					canvasEquipo!.style.cursor = 'grabbing';
					return;
				}
				const nodo = nodoEnPosicionEquipo(px, py);
				nodoActivoEquipo = nodo;
				canvasEquipo!.style.cursor = nodo ? 'pointer' : 'grab';
				if (nodo) mostrarTooltipEquipo(nodo, px, py);
				else tooltipEquipo.classList.add('hidden');
			});
			canvasEquipo.addEventListener('mouseleave', () => {
				nodoActivoEquipo = null; arrastrandoEquipo = false; tooltipEquipo.classList.add('hidden');
			});
			canvasEquipo.addEventListener('wheel', (ev) => {
				ev.preventDefault();
				const rect = canvasEquipo!.getBoundingClientRect();
				aplicarZoomEquipo(ev.deltaY < 0 ? 1.12 : 1 / 1.12, ev.clientX - rect.left, ev.clientY - rect.top);
			}, { passive: false });
			canvasEquipo.addEventListener('touchstart', (ev) => {
				if (ev.touches.length !== 1) return;
				const rect = canvasEquipo!.getBoundingClientRect();
				arrastrandoEquipo = true;
				arrastreInicioEquipo = { px: ev.touches[0].clientX - rect.left, py: ev.touches[0].clientY - rect.top, offsetX: viewEquipo.offsetX, offsetY: viewEquipo.offsetY };
			}, { passive: true });
			canvasEquipo.addEventListener('touchmove', (ev) => {
				if (!arrastrandoEquipo || ev.touches.length !== 1) return;
				ev.preventDefault();
				const rect = canvasEquipo!.getBoundingClientRect();
				const px = ev.touches[0].clientX - rect.left, py = ev.touches[0].clientY - rect.top;
				viewEquipo.offsetX = arrastreInicioEquipo.offsetX + (px - arrastreInicioEquipo.px);
				viewEquipo.offsetY = arrastreInicioEquipo.offsetY + (py - arrastreInicioEquipo.py);
			}, { passive: false });
			canvasEquipo.addEventListener('touchend', () => { arrastrandoEquipo = false; });
			document.getElementById('equipo-zoom-in')!.addEventListener('click', () => aplicarZoomEquipo(1.3, anchoE / 2, altoE / 2));
			document.getElementById('equipo-zoom-out')!.addEventListener('click', () => aplicarZoomEquipo(1 / 1.3, anchoE / 2, altoE / 2));
			document.getElementById('equipo-zoom-reset')!.addEventListener('click', restablecerVistaEquipo);

			const leyendaEquipo = document.getElementById('leyenda-equipo')!;
			leyendaEquipo.innerHTML = equiposGrafoData
				.map((e, i) => {
					const color = COLORES_DIPUTADO[i % COLORES_DIPUTADO.length];
					return `<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full" style="background:${color}"></span>${e.nombre} (${e.asesores.length})</span>`;
				})
				.join('');

			// el panel de "Personal de apoyo" empieza oculto — iniciar la
			// simulación ahí mismo mide un canvas de 0x0
			var grafoIniciado = false;
			var iniciarGrafoSiHaceFalta = function () {
				if (grafoIniciado) return;
				grafoIniciado = true;
				window.addEventListener('resize', redimensionarEquipo);
				redimensionarEquipo();
				animarEquipo();
			};
		}
	</script>
</Layout>
