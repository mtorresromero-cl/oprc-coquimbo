---
import Layout from '../../layouts/Layout.astro';
import { votaciones, mociones, autoridades, VOTO_LABEL } from '../../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}

const mocionesOrdenadas = [...mociones].sort((a, b) => b.fecha.localeCompare(a.fecha));
---

<Layout
	title="Parlamentarios — OPRC"
	description="Votaciones y mociones de los diputados y senadores de la Región de Coquimbo."
>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Parlamentarios</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				Seguimiento del trabajo legislativo de los diputados y senadores de la Región de Coquimbo:
				votaciones y mociones presentadas. La asistencia a sesiones todavía no está disponible — la
				fuente oficial (Cámara de Diputados) no publica ese dato de forma confiable actualmente.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<section>
			<h2 class="text-xl font-semibold text-slate-900">Votaciones recientes</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Votaciones del Senado en las que participó alguno de los 3 senadores de la región. Los
				diputados de la región aún no tienen datos de votaciones disponibles por la misma razón
				que la asistencia.
			</p>

			{votaciones.length === 0 && (
				<p class="mt-6 text-sm text-slate-500">Todavía no hay votaciones registradas.</p>
			)}

			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{votaciones.map((v) => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{v.fecha}</span>
							<span class={v.resultado === 'aprobado' ? 'font-medium text-emerald-600' : 'font-medium text-red-600'}>
								{v.resultado === 'aprobado' ? 'Aprobado' : 'Rechazado'} ({v.votos_favor} a favor /{' '}
								{v.votos_contra} en contra)
							</span>
						</div>
						<p class="mt-2 text-sm text-slate-800">{v.descripcion}</p>
						<ul class="mt-3 flex flex-wrap gap-2">
							{v.votos.map((voto) => (
								<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
									<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
										{nombreAutoridad(voto.autoridad_id)}
									</a>
									: {VOTO_LABEL[voto.voto] ?? voto.voto}
								</li>
							))}
						</ul>
						{v.fuente_url && (
							<a
								href={v.fuente_url}
								target="_blank"
								rel="noopener"
								class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline"
							>
								Fuente oficial
							</a>
						)}
					</li>
				))}
			</ul>
		</section>

		<section class="mt-14">
			<h2 class="text-xl font-semibold text-slate-900">Mociones presentadas</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Proyectos de ley presentados como autor o coautor por diputados de la región, vía datos
				abiertos de la BCN.
			</p>

			{mocionesOrdenadas.length === 0 && (
				<p class="mt-6 text-sm text-slate-500">Todavía no hay mociones registradas.</p>
			)}

			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{mocionesOrdenadas.map((m) => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{m.fecha}</span>
							<span>Boletín {m.boletin}{m.estado ? ` · ${m.estado}` : ''}</span>
						</div>
						<p class="mt-2 text-sm text-slate-800">
							<a href={m.url_bcn} target="_blank" rel="noopener" class="hover:text-brand-600 hover:underline">
								{m.titulo}
							</a>
						</p>
						<p class="mt-2 text-xs text-slate-500">
							<a href={`/autoridades/${m.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
								{nombreAutoridad(m.autoridad_id)}
							</a>
							{' '}({m.rol})
						</p>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>
