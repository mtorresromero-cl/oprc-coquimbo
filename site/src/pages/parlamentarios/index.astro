---
import Layout from '../../layouts/Layout.astro';
import {
	autoridades,
	votaciones,
	votacionesCamara,
	indiceVotaciones,
	indiceMociones,
	indiceAsistencia,
	VOTO_LABEL,
	fotoAutoridad,
} from '../../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}

const senadorIds = autoridades.filter((a) => a.cargo === 'senador').map((a) => a.id);
const diputadoIds = autoridades.filter((a) => a.cargo === 'diputado').map((a) => a.id);

const indiceSenado = indiceVotaciones(votaciones, senadorIds);
const indiceDiputados = indiceVotaciones(votacionesCamara, diputadoIds);
const mocionesPorId = new Map(
	[...indiceMociones(senadorIds), ...indiceMociones(diputadoIds)].map((m) => [m.autoridad_id, m.total])
);
const asistenciaSenadoPorId = new Map(indiceAsistencia(senadorIds).map((a) => [a.autoridad_id, a]));
const asistenciaDiputadosPorId = new Map(indiceAsistencia(diputadoIds).map((a) => [a.autoridad_id, a]));

const grupos = {
	senado: indiceSenado.map((i) => ({
		id: i.autoridad_id,
		nombre: i.nombre,
		foto: fotoAutoridad(i.autoridad_id),
		metrics: {
			asistenciaPct: asistenciaSenadoPorId.get(i.autoridad_id)?.asistenciaPct ?? null,
			participacionPct: i.participacionPct,
			alineamientoPct: i.alineamientoPct,
			favor: i.favor,
			contra: i.contra,
			abstencion: i.abstencion,
			pareo: i.pareo,
			mociones: mocionesPorId.get(i.autoridad_id) ?? 0,
		},
	})),
	diputados: indiceDiputados.map((i) => ({
		id: i.autoridad_id,
		nombre: i.nombre,
		foto: fotoAutoridad(i.autoridad_id),
		metrics: {
			asistenciaPct: asistenciaDiputadosPorId.get(i.autoridad_id)?.asistenciaPct ?? null,
			participacionPct: i.participacionPct,
			alineamientoPct: i.alineamientoPct,
			favor: i.favor,
			contra: i.contra,
			abstencion: i.abstencion,
			pareo: i.pareo,
			mociones: mocionesPorId.get(i.autoridad_id) ?? 0,
		},
	})),
};

const votacionesSenado = [...votaciones].sort((a, b) => b.fecha.localeCompare(a.fecha));
const votacionesDiputados = [...votacionesCamara].sort((a, b) => b.fecha.localeCompare(a.fecha));
---

<Layout
	title="Parlamentarios — OPRC"
	description="Ranking de participación y votaciones recientes de senadores y diputados de la Región de Coquimbo."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Parlamentarios
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Elige a quién mirar. Cada cámara muestra su ranking de participación y sus votaciones más
				recientes.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex flex-wrap gap-2">
				<button type="button" data-grupo="senado" class="grupo-btn cursor-pointer rounded-md px-4 py-2 text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700">
					Senadores
				</button>
				<button type="button" data-grupo="diputados" class="grupo-btn cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
					Diputados
				</button>
			</div>
			<a
				href="/parlamentarios/comparador/"
				class="flex items-center gap-2 rounded-md bg-topic-asistencia px-4 py-2 text-sm font-semibold text-white shadow-sm hover:brightness-110"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
					<path d="M8 3 4 7l4 4" /><path d="M4 7h16" /><path d="M16 21l4-4-4-4" /><path d="M20 17H4" />
				</svg>
				Comparador
			</a>
		</div>

		<div id="submenu-diputados" class="mt-3 hidden flex-wrap gap-2 border-l-2 border-slate-200 pl-3">
			<a
				href="/parlamentarios/gastos/"
				class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
			>
				Gasto parlamentario
			</a>
			<a
				href="/parlamentarios/asesores/"
				class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
			>
				Asesores
			</a>
			<a
				href="/parlamentarios/discursos/"
				class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
			>
				Intervenciones en sala
			</a>
		</div>

		<section class="mt-8">
			<h2 class="text-xl font-semibold text-slate-900">Ranking</h2>
			<div id="metricas" class="mt-3 flex flex-wrap gap-2"></div>
			<p id="metrica-definicion" class="mt-2 max-w-2xl text-sm text-slate-500"></p>

			<div id="chart" class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"></div>

			<details class="mt-6 group">
				<summary class="cursor-pointer text-sm font-semibold text-brand-600 hover:text-brand-700">
					Ver tabla con todas las métricas a la vez →
				</summary>
				<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
					<table class="w-full text-sm">
						<thead id="tabla-head" class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase"></thead>
						<tbody id="tabla-body" class="divide-y divide-slate-100"></tbody>
					</table>
				</div>
			</details>
		</section>

		<!-- SENADO — recientes -->
		<section class="recientes mt-14" data-recientes="senado">
			<h2 class="text-xl font-semibold text-slate-900">Votaciones recientes — Senado</h2>
			<p class="mt-1 max-w-2xl text-base text-slate-500">
				Votaciones del Senado en las que participó alguno de los 3 senadores de la región.
			</p>
			{votacionesSenado.length === 0 && (
				<p class="mt-6 text-base text-slate-500">Todavía no hay votaciones registradas.</p>
			)}
			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{votacionesSenado.map((v) => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{v.fecha}</span>
							<span class={v.resultado === 'aprobado' ? 'font-medium text-emerald-600' : 'font-medium text-red-600'}>
								{v.resultado === 'aprobado' ? 'Aprobado' : 'Rechazado'} ({v.votos_favor} a favor /{' '}
								{v.votos_contra} en contra)
							</span>
						</div>
						<p class="mt-2 text-base text-slate-800">{v.descripcion}</p>
						<ul class="mt-3 flex flex-wrap gap-2">
							{v.votos.map((voto) => (
								<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
									<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
										{nombreAutoridad(voto.autoridad_id)}
									</a>
									: {VOTO_LABEL[voto.voto] ?? voto.voto}
								</li>
							))}
						</ul>
						{v.fuente_url && (
							<a href={v.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
								Fuente oficial
							</a>
						)}
					</li>
				))}
			</ul>
		</section>

		<!-- DIPUTADOS — recientes -->
		<section class="recientes mt-14 hidden" data-recientes="diputados">
			<h2 class="text-xl font-semibold text-slate-900">Votaciones recientes — Diputados</h2>
			<p class="mt-1 max-w-2xl text-base text-slate-500">
				Votaciones de los diputados de la región, vía camara.cl. Solo se muestran las más
				recientes — no el historial completo del período.
			</p>
			{votacionesDiputados.length === 0 && (
				<p class="mt-6 text-base text-slate-500">Todavía no hay votaciones registradas.</p>
			)}
			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{votacionesDiputados.map((v) => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{v.fecha}</span>
							<span class={v.resultado === 'aprobado' ? 'font-medium text-emerald-600' : 'font-medium text-red-600'}>
								{v.resultado === 'aprobado' ? 'Aprobado' : 'Rechazado'} ({v.votos_favor} a favor /{' '}
								{v.votos_contra} en contra)
							</span>
						</div>
						<p class="mt-2 text-base text-slate-800">{v.descripcion}</p>
						<ul class="mt-3 flex flex-wrap gap-2">
							{v.votos.map((voto) => (
								<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
									<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
										{nombreAutoridad(voto.autoridad_id)}
									</a>
									: {VOTO_LABEL[voto.voto] ?? voto.voto}
								</li>
							))}
						</ul>
						{v.fuente_url && (
							<a href={v.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
								Fuente oficial
							</a>
						)}
					</li>
				))}
			</ul>
		</section>
	</main>

	<script type="application/json" id="grupos-data" set:html={JSON.stringify(grupos)} />

	<script>
		interface Item {
			id: string;
			nombre: string;
			foto: string | null;
			metrics: Record<string, number | null>;
		}

		type GrupoKey = 'senado' | 'diputados';

		const grupos: Record<GrupoKey, Item[]> = JSON.parse(document.getElementById('grupos-data')!.textContent!);

		const DEFINICIONES: Record<string, string> = {
			participacionPct:
				'% de votaciones en las que emitió un voto real (a favor, en contra, abstención o pareo). No aparecer en una votación cuenta como no participada.',
			alineamientoPct:
				'De sus votos a favor o en contra, % que coincidió con el resultado final de la votación (si se aprobó o se rechazó).',
			favor: 'Cantidad de votaciones en las que votó a favor.',
			contra: 'Cantidad de votaciones en las que votó en contra.',
			abstencion: 'Cantidad de votaciones en las que se abstuvo.',
			pareo:
				'Acuerdo formal para no votar junto a un/a parlamentario/a de la posición contraria, generalmente por inasistencia de alguno de los dos. Cuenta como participación, pero no como voto a favor ni en contra.',
			mociones:
				'Mociones (proyectos de ley) presentadas como autor o coautor este año, según la fuente oficial (camara.cl o el buscador de tramitación del Senado).',
			asistenciaPct:
				'% de asistencia a sesiones de sala del período, tal como lo calcula la fuente oficial (camara.cl o senado.cl): asistencias sobre sesiones computables.',
		};

		const METRICAS: Record<GrupoKey, [string, string][]> = {
			senado: [
				['asistenciaPct', 'Asistencia'],
				['participacionPct', 'Participación'],
				['alineamientoPct', 'Alineamiento'],
				['favor', 'A favor'],
				['contra', 'En contra'],
				['abstencion', 'Abstención'],
				['pareo', 'Pareo'],
				['mociones', 'Mociones presentadas'],
			],
			diputados: [
				['asistenciaPct', 'Asistencia'],
				['participacionPct', 'Participación'],
				['alineamientoPct', 'Alineamiento'],
				['favor', 'A favor'],
				['contra', 'En contra'],
				['abstencion', 'Abstención'],
				['pareo', 'Pareo'],
				['mociones', 'Mociones presentadas'],
			],
		};

		function esPct(metricKey: string) {
			return metricKey.endsWith('Pct');
		}

		function formatoValor(metricKey: string, valor: number | null) {
			if (valor === null) return 'Sin datos comparables';
			return esPct(metricKey) ? `${valor.toFixed(1)}%` : String(valor);
		}

		function iniciales(nombre: string): string {
			const partes = nombre.split(' ').filter(Boolean);
			return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
		}

		let grupoActivo: GrupoKey = 'senado';
		let metricaActiva = METRICAS.senado[0][0];

		function renderMetricas() {
			const cont = document.getElementById('metricas')!;
			cont.innerHTML = METRICAS[grupoActivo]
				.map(
					([key, label]) =>
						`<button type="button" data-metrica="${key}" class="metrica-btn cursor-pointer rounded-full px-3 py-1 text-xs font-medium ${
							key === metricaActiva ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
						}">${label}</button>`
				)
				.join('');
			cont.querySelectorAll<HTMLButtonElement>('.metrica-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					metricaActiva = btn.dataset.metrica!;
					renderMetricas();
					render();
				});
			});
			document.getElementById('metrica-definicion')!.textContent = DEFINICIONES[metricaActiva] ?? '';
		}

		function render() {
			const items = grupos[grupoActivo];
			const ordenados = [...items].sort((a, b) => (b.metrics[metricaActiva] ?? -1) - (a.metrics[metricaActiva] ?? -1));
			const max = Math.max(...ordenados.map((i) => i.metrics[metricaActiva] ?? 0), 1);

			function etiquetaNombre(i: Item) {
				const avatar = i.foto
					? `<img src="${i.foto}" alt="" class="h-6 w-6 shrink-0 rounded-full border-2 border-slate-100 object-cover" />`
					: `<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-slate-100 bg-brand-50 text-[10px] font-bold text-brand-700">${iniciales(i.nombre)}</span>`;
				return `${avatar}<span class="min-w-0 truncate">${i.nombre}</span>`;
			}

			const chart = document.getElementById('chart')!;
			chart.innerHTML = ordenados
				.map((i) => {
					const valor = i.metrics[metricaActiva];
					const anchoPct = valor === null ? 0 : (valor / max) * 100;
					return `
						<div class="flex items-center gap-2 py-1.5 sm:gap-3">
							<a href="/autoridades/${i.id}/" class="flex w-24 shrink-0 items-center gap-1.5 text-sm text-slate-700 hover:text-brand-600 hover:underline sm:w-64">${etiquetaNombre(i)}</a>
							<div class="h-5 flex-1 rounded bg-slate-100">
								<div class="h-5 rounded bg-brand-600" style="width:${anchoPct}%"></div>
							</div>
							<span class="w-16 shrink-0 text-right text-sm font-medium text-slate-900 sm:w-32">${formatoValor(metricaActiva, valor)}</span>
						</div>`;
				})
				.join('');

			const head = document.getElementById('tabla-head')!;
			const cols = METRICAS[grupoActivo];
			head.innerHTML =
				'<tr><th class="px-4 py-2">Nombre</th>' +
				cols.map(([, label]) => `<th class="px-4 py-2 text-right">${label}</th>`).join('') +
				'</tr>';

			const body = document.getElementById('tabla-body')!;
			body.innerHTML = ordenados
				.map(
					(i) =>
						`<tr><td class="px-4 py-2.5"><a href="/autoridades/${i.id}/" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-brand-600 hover:underline">${etiquetaNombre(i)}</a></td>` +
						cols
							.map(([key]) => `<td class="px-4 py-2.5 text-right text-slate-700">${formatoValor(key, i.metrics[key])}</td>`)
							.join('') +
						'</tr>'
				)
				.join('');
		}

		document.querySelectorAll<HTMLButtonElement>('.grupo-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				grupoActivo = btn.dataset.grupo as GrupoKey;
				metricaActiva = METRICAS[grupoActivo][0][0];
				document.querySelectorAll('.grupo-btn').forEach((b) => {
					b.classList.remove('bg-brand-600', 'text-white', 'hover:bg-brand-700');
					b.classList.add('border', 'border-slate-300', 'text-slate-700', 'hover:bg-slate-50');
				});
				btn.classList.add('bg-brand-600', 'text-white', 'hover:bg-brand-700');
				btn.classList.remove('border', 'border-slate-300', 'text-slate-700', 'hover:bg-slate-50');
				renderMetricas();
				render();

				document.querySelectorAll<HTMLElement>('.recientes').forEach((sec) => {
					sec.classList.toggle('hidden', sec.dataset.recientes !== grupoActivo);
				});

				const submenu = document.getElementById('submenu-diputados')!;
				submenu.classList.toggle('hidden', grupoActivo !== 'diputados');
				submenu.classList.toggle('flex', grupoActivo === 'diputados');
			});
		});

		renderMetricas();
		render();
	</script>
</Layout>
