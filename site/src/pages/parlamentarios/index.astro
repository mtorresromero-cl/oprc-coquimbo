---
import Layout from '../../layouts/Layout.astro';
import { votaciones, mociones, autoridades, VOTO_LABEL, indiceVotaciones, indiceMociones } from '../../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}

const mocionesOrdenadas = [...mociones].sort((a, b) => b.fecha.localeCompare(a.fecha));

const senadorIds = autoridades.filter((a) => a.cargo === 'senador').map((a) => a.id);
const diputadoIds = autoridades.filter((a) => a.cargo === 'diputado').map((a) => a.id);

const indiceSenado = indiceVotaciones(votaciones, senadorIds).sort(
	(a, b) => b.participacionPct - a.participacionPct
);
const indiceMocionesDiputados = indiceMociones(diputadoIds).sort((a, b) => b.total - a.total);

function formatoPct(valor: number | null) {
	return valor === null ? '—' : `${valor.toFixed(1)}%`;
}
---

<Layout
	title="Parlamentarios — OPRC"
	description="Votaciones, índice de participación y mociones de los diputados y senadores de la Región de Coquimbo."
>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Parlamentarios</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				Seguimiento del trabajo legislativo de los diputados y senadores de la Región de Coquimbo:
				votaciones y mociones presentadas. La asistencia a sesiones todavía no está disponible — la
				fuente oficial (Cámara de Diputados) no publica ese dato de forma confiable actualmente.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<section>
			<h2 class="text-xl font-semibold text-slate-900">Índice de participación — Senado</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Sobre las {votaciones.length} votaciones registradas. <strong>Participación</strong>: %
				de votaciones en las que emitió un voto real (el Senado no publica ausencias explícitas,
				así que no aparecer en una votación cuenta como no participada). <strong>Alineamiento</strong>:
				de sus votos a favor/en contra, % que coincidió con el resultado final de la votación.
				No calculamos un puntaje único: mezclar participación y alineamiento en un solo número
				requeriría ponderarlos de forma arbitraria.
			</p>
			<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
				<table class="w-full min-w-[560px] text-sm">
					<thead>
						<tr class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<th class="px-4 py-2">Senador/a</th>
							<th class="px-4 py-2 text-right">Participación</th>
							<th class="px-4 py-2 text-right">Alineamiento</th>
							<th class="px-4 py-2 text-right">A favor</th>
							<th class="px-4 py-2 text-right">En contra</th>
							<th class="px-4 py-2 text-right">Abstención</th>
							<th class="px-4 py-2 text-right">Pareo</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						{indiceSenado.map((i) => (
							<tr>
								<td class="px-4 py-2.5">
									<a href={`/autoridades/${i.autoridad_id}/`} class="font-medium text-slate-900 hover:text-brand-600 hover:underline">
										{i.nombre}
									</a>
								</td>
								<td class="px-4 py-2.5 text-right font-medium text-slate-900">{formatoPct(i.participacionPct)}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{formatoPct(i.alineamientoPct)}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.favor}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.contra}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.abstencion}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.pareo}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-xl font-semibold text-slate-900">Mociones por diputado/a</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Mociones presentadas como autor o coautor, vía la ficha de cada diputado/a en camara.cl.
				Un total en cero significa que no encontramos mociones suyas en esa fuente — no necesariamente que no haya
				presentado ninguna.
			</p>
			<ul class="mt-4 grid gap-2 sm:grid-cols-2">
				{indiceMocionesDiputados.map((i) => (
					<li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm">
						<a href={`/autoridades/${i.autoridad_id}/`} class="font-medium text-slate-900 hover:text-brand-600 hover:underline">
							{i.nombre}
						</a>
						<span class="font-semibold text-slate-700">{i.total}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="mt-14">
			<h2 class="text-xl font-semibold text-slate-900">Votaciones recientes</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Votaciones del Senado en las que participó alguno de los 3 senadores de la región. Los
				diputados de la región aún no tienen datos de votaciones disponibles por la misma razón
				que la asistencia.
			</p>

			{votaciones.length === 0 && (
				<p class="mt-6 text-sm text-slate-500">Todavía no hay votaciones registradas.</p>
			)}

			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{votaciones.map((v) => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{v.fecha}</span>
							<span class={v.resultado === 'aprobado' ? 'font-medium text-emerald-600' : 'font-medium text-red-600'}>
								{v.resultado === 'aprobado' ? 'Aprobado' : 'Rechazado'} ({v.votos_favor} a favor /{' '}
								{v.votos_contra} en contra)
							</span>
						</div>
						<p class="mt-2 text-sm text-slate-800">{v.descripcion}</p>
						<ul class="mt-3 flex flex-wrap gap-2">
							{v.votos.map((voto) => (
								<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
									<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
										{nombreAutoridad(voto.autoridad_id)}
									</a>
									: {VOTO_LABEL[voto.voto] ?? voto.voto}
								</li>
							))}
						</ul>
						{v.fuente_url && (
							<a
								href={v.fuente_url}
								target="_blank"
								rel="noopener"
								class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline"
							>
								Fuente oficial
							</a>
						)}
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>
