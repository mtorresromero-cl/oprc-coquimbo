---
import Layout from '../../layouts/Layout.astro';
import {
	autoridades,
	votaciones,
	votacionesCamara,
	indiceVotaciones,
	indiceMociones,
	indiceAsistencia,
	fotoAutoridad,
	cargoDeAutoridad,
	nombrePartido,
} from '../../lib/datos';

const senadorIds = autoridades.filter((a) => a.cargo === 'senador').map((a) => a.id);
const diputadoIds = autoridades.filter((a) => a.cargo === 'diputado').map((a) => a.id);

const votacionesPorId = new Map(
	[...indiceVotaciones(votaciones, senadorIds), ...indiceVotaciones(votacionesCamara, diputadoIds)].map((v) => [
		v.autoridad_id,
		v,
	])
);
const mocionesPorId = new Map(
	[...indiceMociones(senadorIds), ...indiceMociones(diputadoIds)].map((m) => [m.autoridad_id, m.total])
);
const asistenciaPorId = new Map(
	[...indiceAsistencia(senadorIds), ...indiceAsistencia(diputadoIds)].map((a) => [a.autoridad_id, a])
);

const personas = [...diputadoIds, ...senadorIds].map((id) => {
	const a = autoridades.find((x) => x.id === id)!;
	const v = votacionesPorId.get(id);
	return {
		id,
		nombre: a.nombre_completo,
		cargo: a.cargo,
		cargoLabel: cargoDeAutoridad(a),
		partido: a.partido ? nombrePartido(a.partido) : null,
		foto: fotoAutoridad(id),
		metrics: {
			asistenciaPct: asistenciaPorId.get(id)?.asistenciaPct ?? null,
			participacionPct: v?.participacionPct ?? null,
			alineamientoPct: v?.alineamientoPct ?? null,
			favor: v?.favor ?? 0,
			contra: v?.contra ?? 0,
			abstencion: v?.abstencion ?? 0,
			pareo: v?.pareo ?? 0,
			mociones: mocionesPorId.get(id) ?? 0,
		},
	};
});
---

<Layout
	title="Comparador — OPRC"
	description="Compara hasta 3 diputados o senadores de la Región de Coquimbo lado a lado: asistencia, votaciones y mociones."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Comparador
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Elige 2 diputados o senadores para un duelo cara a cara, o hasta 3 para comparar en tabla.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="grid gap-3 sm:grid-cols-3">
			<select data-slot="0" class="persona-select rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				<option value="">Persona 1</option>
			</select>
			<select data-slot="1" class="persona-select rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				<option value="">Persona 2</option>
			</select>
			<select data-slot="2" class="persona-select rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				<option value="">Persona 3 (opcional)</option>
			</select>
		</div>

		<p id="prompt" class="mt-10 text-base text-slate-500">Elige al menos 2 personas para comparar.</p>

		<div id="resultado" class="mt-8 hidden"></div>
	</main>

	<script type="application/json" id="personas-data" set:html={JSON.stringify(personas)} />

	<script>
		interface Metrics {
			asistenciaPct: number | null;
			participacionPct: number | null;
			alineamientoPct: number | null;
			favor: number;
			contra: number;
			abstencion: number;
			pareo: number;
			mociones: number;
		}
		interface Persona {
			id: string;
			nombre: string;
			cargo: string;
			cargoLabel: string;
			partido: string | null;
			foto: string | null;
			metrics: Metrics;
		}

		const personas: Persona[] = JSON.parse(document.getElementById('personas-data')!.textContent!);
		const porId = new Map(personas.map((p) => [p.id, p]));

		// mismos 2-3 primeros tonos del sistema de color (validados para
		// distinguirse entre sí incluso comparados de a pares) — nunca el
		// rojo de marca, para no confundir "persona" con "identidad OPRC".
		const COLORES = ['#2a78d6', '#eb6834', '#1baf7a'];

		const ICONOS: Record<string, string> = {
			asistenciaPct: 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
			participacionPct: 'm9 12 2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
			alineamientoPct: 'M3 6h18M6 6v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6M10 6V4a2 2 0 0 1 2-2 2 2 0 0 1 2 2v2',
			mociones: 'M14 3v5a2 2 0 0 0 2 2h5M6 3h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z',
			favor: 'M7 10v11M2 10h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H2v-11ZM7 10l3.5-7A1.5 1.5 0 0 1 12 2v0a3 3 0 0 1 3 3v4h3.5a2 2 0 0 1 2 2.3l-1.4 7A2 2 0 0 1 17.1 20H7',
			contra: 'M17 14V3M22 14h-3a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3V14ZM17 14l-3.5 7A1.5 1.5 0 0 1 12 22v0a3 3 0 0 1-3-3v-4H5.5a2 2 0 0 1-2-2.3l1.4-7A2 2 0 0 1 6.9 4H17',
			abstencion: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM8 12h8',
			pareo: 'm8 3 4 4-4 4M4 7h12M16 21l-4-4 4-4M20 17H8',
		};

		const METRICAS: [keyof Metrics, string, boolean][] = [
			['asistenciaPct', 'Asistencia', true],
			['participacionPct', 'Participación', true],
			['alineamientoPct', 'Alineamiento', true],
			['mociones', 'Mociones presentadas', false],
			['favor', 'Votos a favor', false],
			['contra', 'Votos en contra', false],
			['abstencion', 'Abstenciones', false],
			['pareo', 'Pareos', false],
		];


		const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('.persona-select'));

		function seleccionActual(excluyendo: HTMLSelectElement): string[] {
			return selects.filter((s) => s !== excluyendo).map((s) => s.value).filter(Boolean);
		}

		function pobladoSelect(select: HTMLSelectElement) {
			const usados = new Set(seleccionActual(select));
			const actual = select.value;
			const placeholder = select.querySelector('option[value=""]')!.outerHTML;
			const diputados = personas.filter((p) => p.cargo === 'diputado');
			const senadores = personas.filter((p) => p.cargo === 'senador');
			const opcion = (p: Persona) =>
				`<option value="${p.id}" ${usados.has(p.id) && p.id !== actual ? 'disabled' : ''}>${p.nombre}</option>`;
			select.innerHTML =
				placeholder +
				`<optgroup label="Diputados">${diputados.map(opcion).join('')}</optgroup>` +
				`<optgroup label="Senadores">${senadores.map(opcion).join('')}</optgroup>`;
			select.value = actual;
		}

		function formatoValor(esPct: boolean, valor: number | null): string {
			if (valor === null) return '—';
			return esPct ? `${valor.toFixed(1)}%` : String(valor);
		}

		function iniciales(nombre: string): string {
			const partes = nombre.split(' ').filter(Boolean);
			return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
		}

		function avatar(p: Persona, color: string, tamano: number): string {
			// aro claro de 2px entre la foto y el aro de color, para que se
			// vean como dos anillos separados en vez de un solo borde grueso
			const anillo = `box-shadow: 0 0 0 2px #fff, 0 0 0 5px ${color};`;
			if (p.foto) {
				return `<img src="${p.foto}" alt="${p.nombre}" style="width:${tamano}px;height:${tamano}px;${anillo}" class="rounded-full object-cover" />`;
			}
			return `<span style="width:${tamano}px;height:${tamano}px;${anillo};background:color-mix(in srgb, ${color} 12%, white);color:${color};font-size:${tamano * 0.34}px" class="flex items-center justify-center rounded-full font-bold">${iniciales(p.nombre)}</span>`;
		}

		function icono(key: string): string {
			return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 mx-auto"><path d="${ICONOS[key]}"></path></svg>`;
		}

		// --- duelo: exactamente 2 personas, barras espejo desde cada borde ---
		function renderDuelo(a: Persona, b: Persona): string {
			const colorA = COLORES[0];
			const colorB = COLORES[1];

			const cabecera = `
				<div class="grid grid-cols-[1fr_auto_1fr] items-start gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
					<div class="flex flex-col items-center text-center">
						<a href="/autoridades/${a.id}/" class="hover:opacity-90">
							${avatar(a, colorA, 96)}
							<p class="mt-3 text-lg font-bold text-slate-900">${a.nombre}</p>
							<p class="mt-0.5 text-sm text-slate-500">${a.cargoLabel}${a.partido ? ` · ${a.partido}` : ''}</p>
						</a>
						<button type="button" class="quitar-persona mt-2 text-xs font-semibold text-slate-400 hover:text-red-600" data-id="${a.id}">✕ Quitar</button>
					</div>
					<span class="mt-10 text-sm font-black tracking-widest text-slate-300">VS</span>
					<div class="flex flex-col items-center text-center">
						<a href="/autoridades/${b.id}/" class="hover:opacity-90">
							${avatar(b, colorB, 96)}
							<p class="mt-3 text-lg font-bold text-slate-900">${b.nombre}</p>
							<p class="mt-0.5 text-sm text-slate-500">${b.cargoLabel}${b.partido ? ` · ${b.partido}` : ''}</p>
						</a>
						<button type="button" class="quitar-persona mt-2 text-xs font-semibold text-slate-400 hover:text-red-600" data-id="${b.id}">✕ Quitar</button>
					</div>
				</div>`;

			const filas = METRICAS.map(([key, label, esPct]) => {
				const va = a.metrics[key] as number | null;
				const vb = b.metrics[key] as number | null;
				const max = Math.max(Math.abs(va ?? 0), Math.abs(vb ?? 0), esPct ? 100 : 1);
				const anchoA = va === null ? 0 : (Math.abs(va) / max) * 100;
				const anchoB = vb === null ? 0 : (Math.abs(vb) / max) * 100;
				return `
					<div class="grid grid-cols-[1fr_5rem_1fr] items-center gap-3 py-3">
						<div class="flex items-center justify-end gap-3">
							<span class="text-lg font-bold text-slate-900 tabular-nums">${formatoValor(esPct, va)}</span>
							<div class="h-3 w-full max-w-[10rem] rounded-full bg-slate-100">
								<div class="ml-auto h-3 rounded-full" style="width:${anchoA}%;background:${colorA}"></div>
							</div>
						</div>
						<div class="flex flex-col items-center gap-1 text-slate-400">
							${icono(key)}
							<span class="text-center text-[10px] font-semibold tracking-wide uppercase leading-tight">${label}</span>
						</div>
						<div class="flex items-center gap-3">
							<div class="h-3 w-full max-w-[10rem] rounded-full bg-slate-100">
								<div class="h-3 rounded-full" style="width:${anchoB}%;background:${colorB}"></div>
							</div>
							<span class="text-lg font-bold text-slate-900 tabular-nums">${formatoValor(esPct, vb)}</span>
						</div>
					</div>`;
			}).join('');

			return `${cabecera}<div class="mt-6 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white px-4 shadow-sm sm:px-8">${filas}</div>`;
		}

		// --- tabla: 3 personas, sin la mecánica de espejo ---
		function renderTabla(elegidas: Persona[]): string {
			const chips = elegidas
				.map(
					(p, i) => `
					<div class="flex items-center gap-1 rounded-full border py-1.5 pr-2 pl-1.5 text-sm font-semibold" style="border-color:${COLORES[i]};color:${COLORES[i]}">
						<a href="/autoridades/${p.id}/" class="flex items-center gap-2.5 hover:underline">
							${avatar(p, COLORES[i], 28)}
							${p.nombre} <span class="font-normal text-slate-400">· ${p.cargoLabel}</span>
						</a>
						<button type="button" class="quitar-persona ml-1 rounded-full px-1.5 py-0.5 text-slate-400 hover:bg-slate-100 hover:text-red-600" data-id="${p.id}" aria-label="Quitar a ${p.nombre}">✕</button>
					</div>`
				)
				.join('');

			const filas = METRICAS.map(([key, label, esPct]) => {
				const max = Math.max(...elegidas.map((p) => Math.abs((p.metrics[key] as number) ?? 0)), esPct ? 100 : 1);
				const barras = elegidas
					.map((p, i) => {
						const valor = p.metrics[key] as number | null;
						const anchoPct = valor === null ? 0 : (Math.abs(valor) / max) * 100;
						return `
							<div class="flex items-center gap-3">
								<div class="h-3.5 flex-1 rounded-full bg-slate-100">
									<div class="h-3.5 rounded-full" style="width:${anchoPct}%;background:${COLORES[i]}"></div>
								</div>
								<span class="w-16 shrink-0 text-right text-base font-bold text-slate-900 tabular-nums">${formatoValor(esPct, valor)}</span>
							</div>`;
					})
					.join('');
				return `
					<div class="flex items-start gap-4 py-4">
						<div class="flex w-16 shrink-0 flex-col items-center gap-1 pt-0.5 text-slate-400">
							${icono(key)}
							<span class="text-center text-[10px] font-semibold tracking-wide uppercase leading-tight">${label}</span>
						</div>
						<div class="flex-1 space-y-2">${barras}</div>
					</div>`;
			}).join('');

			return `<div class="flex flex-wrap gap-2">${chips}</div>
				<div class="mt-6 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white px-6 shadow-sm">${filas}</div>`;
		}

		function render() {
			selects.forEach(pobladoSelect);

			const elegidas = selects.map((s) => s.value).filter(Boolean).map((id) => porId.get(id)!);
			const prompt = document.getElementById('prompt')!;
			const resultado = document.getElementById('resultado')!;

			if (elegidas.length < 2) {
				prompt.classList.remove('hidden');
				resultado.classList.add('hidden');
				return;
			}
			prompt.classList.add('hidden');
			resultado.classList.remove('hidden');
			resultado.innerHTML =
				elegidas.length === 2 ? renderDuelo(elegidas[0], elegidas[1]) : renderTabla(elegidas);

			resultado.querySelectorAll<HTMLButtonElement>('.quitar-persona').forEach((btn) => {
				btn.addEventListener('click', () => {
					const select = selects.find((s) => s.value === btn.dataset.id);
					if (select) {
						select.value = '';
						render();
					}
				});
			});
		}

		selects.forEach((s) => s.addEventListener('change', render));
		render();
	</script>
</Layout>
