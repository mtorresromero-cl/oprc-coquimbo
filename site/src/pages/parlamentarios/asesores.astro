---
import Layout from '../../layouts/Layout.astro';
import { equiposDiputados, fotoAutoridad } from '../../lib/datos';

const equipos = equiposDiputados().map((e) => ({ ...e, foto: fotoAutoridad(e.id) }));
const totalAsesores = equipos.reduce((n, e) => n + e.asesores.length, 0);
---

<Layout
	title="Asesores — OPRC"
	description="Quién trabaja para cada diputado de la Región de Coquimbo: personal de apoyo, cargo y sueldo, según camara.cl."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/parlamentarios/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">
				← Volver a Parlamentarios
			</a>
			<p class="mt-6 text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Asesores
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Los {totalAsesores} profesionales, administrativos y asesores del personal de apoyo de los
				7 diputados de la región, julio 2026. Ningún nombre se repite entre dos diputados —
				cada uno tiene su propio equipo, sin cruces.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">
			<span>El tamaño del punto es proporcional al sueldo. Arrastra para mover, rueda o pellizca para acercar.</span>
		</div>

		<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
			<canvas id="red" class="block h-[560px] w-full touch-none"></canvas>
			<div
				id="tooltip"
				class="pointer-events-none absolute z-10 hidden max-w-[16rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"
			></div>
			<div class="absolute right-3 bottom-3 flex flex-col gap-1.5">
				<button id="zoom-in" type="button" aria-label="Acercar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">+</button>
				<button id="zoom-out" type="button" aria-label="Alejar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">−</button>
				<button id="zoom-reset" type="button" aria-label="Restablecer vista" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 shadow-sm hover:bg-slate-50">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 12a9 9 0 1 1 3 6.7M3 12v5h5"></path></svg>
				</button>
			</div>
		</div>

		<div id="leyenda" class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-600"></div>

		<p class="mt-6 text-xs text-slate-400">
			Fuente: camara.cl, ficha de "Personal de apoyo" de cada diputado/a. Los sueldos son el total
			mensual bruto declarado, no incluyen imposiciones ni descuentos.
		</p>
	</main>

	<script type="application/json" id="equipos-data" set:html={JSON.stringify(equipos)} />

	<script>
		interface Asesor {
			nombre: string;
			cargo: string;
			renta: number | null;
		}
		interface Equipo {
			id: string;
			nombre: string;
			foto: string | null;
			asesores: Asesor[];
		}

		const equipos: Equipo[] = JSON.parse(document.getElementById('equipos-data')!.textContent!);

		// mismos 7 tonos categoricos del sistema (sin el rojo, reservado para
		// la marca) — uno fijo por diputado/a, para que su equipo se lea como
		// un mismo color en el grafo
		const COLORES_DIPUTADO = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7'];

		type Nodo = {
			tipo: 'diputado' | 'asesor';
			id: string;
			nombre: string;
			cargo?: string;
			renta?: number | null;
			color: string;
			equipoId: string;
			x: number;
			y: number;
			vx: number;
			vy: number;
			homeX: number;
			homeY: number;
			r: number;
		};

		const canvas = document.getElementById('red') as HTMLCanvasElement;
		const ctx = canvas.getContext('2d')!;
		const tooltip = document.getElementById('tooltip')!;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);

		let ancho = 0;
		let alto = 0;
		let nodos: Nodo[] = [];

		// fotos precargadas por equipo — si no hay foto o todavia no carga,
		// dibujar() cae de vuelta a las iniciales sin bloquear nada
		const fotos = new Map<string, HTMLImageElement>();
		for (const e of equipos) {
			if (!e.foto) continue;
			const img = new Image();
			img.src = e.foto;
			fotos.set(e.id, img);
		}

		// vista: pan (offsetX/Y) + zoom, aplicados a las coordenadas "mundo"
		// en las que viven los nodos
		const view = { zoom: 1, offsetX: 0, offsetY: 0 };
		const ZOOM_MIN = 0.4;
		const ZOOM_MAX = 4;

		function pantallaAMundo(px: number, py: number) {
			return { x: (px - view.offsetX) / view.zoom, y: (py - view.offsetY) / view.zoom };
		}

		function aplicarZoom(factor: number, centroPx: number, centroPy: number) {
			const antes = pantallaAMundo(centroPx, centroPy);
			view.zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, view.zoom * factor));
			view.offsetX = centroPx - antes.x * view.zoom;
			view.offsetY = centroPy - antes.y * view.zoom;
		}

		function restablecerVista() {
			view.zoom = 1;
			view.offsetX = 0;
			view.offsetY = 0;
		}

		function construirNodos() {
			const cx = ancho / 2;
			// un poco más abajo del centro real: los nombres se dibujan bajo
			// cada nodo, así que el centro "visual" del grafo queda más alto
			// que su centro matemático si cy = alto/2 — bajarlo lo compensa
			const cy = alto * 0.54;
			// elipse, no círculo: el canvas es mucho más ancho que alto, y un
			// solo radio (basado en el lado corto) dejaba a los equipos de
			// arriba/abajo pegados a esos bordes, con asesores empujados
			// fuera del marco por la repulsión
			const radioX = ancho * 0.32;
			const radioY = alto * 0.28;
			const maxRenta = Math.max(...equipos.flatMap((e) => e.asesores.map((a) => a.renta ?? 0)), 1);

			nodos = [];
			equipos.forEach((equipo, i) => {
				const angulo = (i / equipos.length) * Math.PI * 2 - Math.PI / 2;
				const homeX = cx + Math.cos(angulo) * radioX;
				const homeY = cy + Math.sin(angulo) * radioY;
				const color = COLORES_DIPUTADO[i % COLORES_DIPUTADO.length];

				nodos.push({
					tipo: 'diputado',
					id: equipo.id,
					nombre: equipo.nombre,
					color,
					equipoId: equipo.id,
					x: homeX,
					y: homeY,
					vx: 0,
					vy: 0,
					homeX,
					homeY,
					r: 22,
				});

				equipo.asesores.forEach((asesor, j) => {
					const jitterAngulo = Math.random() * Math.PI * 2;
					const jitterRadio = 30 + Math.random() * 20;
					const rentaNorm = (asesor.renta ?? 0) / maxRenta;
					nodos.push({
						tipo: 'asesor',
						id: `${equipo.id}-${j}`,
						nombre: asesor.nombre,
						cargo: asesor.cargo,
						renta: asesor.renta,
						color,
						equipoId: equipo.id,
						x: homeX + Math.cos(jitterAngulo) * jitterRadio,
						y: homeY + Math.sin(jitterAngulo) * jitterRadio,
						vx: 0,
						vy: 0,
						homeX,
						homeY,
						r: 4 + Math.sqrt(rentaNorm) * 10,
					});
				});
			});
		}

		function iniciales(nombre: string): string {
			const partes = nombre.split(' ').filter(Boolean);
			return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
		}

		function redimensionar() {
			const rect = canvas.getBoundingClientRect();
			ancho = rect.width;
			alto = rect.height;
			canvas.width = ancho * dpr;
			canvas.height = alto * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			construirNodos();
		}

		let nodoActivo: Nodo | null = null;

		function paso() {
			// resorte hacia el "hogar" del propio equipo + repulsion entre todos los nodos
			for (const n of nodos) {
				if (n.tipo === 'diputado') continue;
				n.vx += (n.homeX - n.x) * 0.02;
				n.vy += (n.homeY - n.y) * 0.02;
			}
			for (let i = 0; i < nodos.length; i++) {
				for (let j = i + 1; j < nodos.length; j++) {
					const a = nodos[i];
					const b = nodos[j];
					const dx = b.x - a.x;
					const dy = b.y - a.y;
					const dist = Math.max(Math.hypot(dx, dy), 1);
					const minDist = a.r + b.r + 4;
					if (dist < minDist * 3) {
						const fuerza = ((minDist * 3 - dist) / dist) * 0.6;
						const fx = dx * fuerza;
						const fy = dy * fuerza;
						if (a.tipo === 'asesor') { a.vx -= fx; a.vy -= fy; }
						if (b.tipo === 'asesor') { b.vx += fx; b.vy += fy; }
					}
				}
			}
			for (const n of nodos) {
				if (n.tipo === 'diputado') continue;
				n.vx *= 0.82;
				n.vy *= 0.82;
				n.x += n.vx;
				n.y += n.vy;
				// tope duro: sin esto, un equipo grande cerca del borde puede
				// terminar con asesores empujados fuera del canvas
				n.x = Math.max(n.r + 2, Math.min(ancho - n.r - 2, n.x));
				n.y = Math.max(n.r + 2, Math.min(alto - n.r - 2, n.y));
			}
		}

		function dibujar() {
			ctx.clearRect(0, 0, ancho, alto);
			ctx.save();
			ctx.translate(view.offsetX, view.offsetY);
			ctx.scale(view.zoom, view.zoom);

			// lineas hacia el diputado (solo del equipo activo, si hay uno)
			for (const n of nodos) {
				if (n.tipo !== 'asesor') continue;
				if (nodoActivo && nodoActivo.equipoId !== n.equipoId) continue;
				const home = nodos.find((d) => d.tipo === 'diputado' && d.equipoId === n.equipoId)!;
				ctx.beginPath();
				ctx.moveTo(home.x, home.y);
				ctx.lineTo(n.x, n.y);
				ctx.strokeStyle = `${n.color}30`;
				ctx.lineWidth = 1 / view.zoom;
				ctx.stroke();
			}

			for (const n of nodos) {
				const atenuado = nodoActivo && nodoActivo.equipoId !== n.equipoId;
				ctx.globalAlpha = atenuado ? 0.15 : 1;

				const foto = n.tipo === 'diputado' ? fotos.get(n.equipoId) : undefined;
				if (foto && foto.complete && foto.naturalWidth > 0) {
					ctx.save();
					ctx.beginPath();
					ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
					ctx.clip();
					ctx.drawImage(foto, n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
					ctx.restore();
					ctx.beginPath();
					ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
					ctx.lineWidth = 2 / view.zoom;
					ctx.strokeStyle = n.color;
					ctx.stroke();
				} else {
					ctx.beginPath();
					ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
					ctx.fillStyle = n.tipo === 'diputado' ? n.color : `${n.color}cc`;
					ctx.fill();
					if (n.tipo === 'diputado') {
						ctx.lineWidth = 2 / view.zoom;
						ctx.strokeStyle = '#fff';
						ctx.stroke();
						ctx.fillStyle = '#fff';
						ctx.font = 'bold 11px "Space Grotesk", sans-serif';
						ctx.textAlign = 'center';
						ctx.textBaseline = 'middle';
						ctx.fillText(iniciales(n.nombre), n.x, n.y);
					}
				}
				ctx.globalAlpha = 1;
			}

			// nombre del diputado bajo su nodo
			for (const n of nodos) {
				if (n.tipo !== 'diputado') continue;
				ctx.globalAlpha = nodoActivo && nodoActivo.equipoId !== n.equipoId ? 0.3 : 1;
				ctx.fillStyle = '#334155';
				ctx.font = '600 11px "Space Grotesk", sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText(n.nombre.split(' ').slice(0, 2).join(' '), n.x, n.y + n.r + 14);
				ctx.globalAlpha = 1;
			}

			ctx.restore();
		}

		function animar() {
			paso();
			dibujar();
			requestAnimationFrame(animar);
		}

		function nodoEnPosicion(px: number, py: number): Nodo | null {
			const m = pantallaAMundo(px, py);
			for (let i = nodos.length - 1; i >= 0; i--) {
				const n = nodos[i];
				if (Math.hypot(n.x - m.x, n.y - m.y) <= n.r + 2) return n;
			}
			return null;
		}

		function formatoCLP(monto: number) {
			return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(monto);
		}

		function mostrarTooltip(nodo: Nodo, px: number, py: number) {
			tooltip.classList.remove('hidden');
			tooltip.style.left = `${Math.min(px + 12, ancho - 240)}px`;
			tooltip.style.top = `${py + 12}px`;
			if (nodo.tipo === 'diputado') {
				const equipo = equipos.find((e) => e.id === nodo.equipoId)!;
				const totalEquipo = equipo.asesores.reduce((s, a) => s + (a.renta ?? 0), 0);
				tooltip.innerHTML = `<p class="font-semibold text-slate-900">${nodo.nombre}</p><p class="mt-1 text-slate-500">${equipo.asesores.length} personas · ${formatoCLP(totalEquipo)}/mes en total</p>`;
			} else {
				tooltip.innerHTML = `<p class="font-semibold text-slate-900">${nodo.nombre}</p><p class="mt-1 text-slate-500">${nodo.cargo}${nodo.renta ? ` · ${formatoCLP(nodo.renta)}/mes` : ''}</p>`;
			}
		}

		// --- arrastrar para mover (mouse) ---
		let arrastrando = false;
		let arrastreInicio = { px: 0, py: 0, offsetX: 0, offsetY: 0 };

		canvas.addEventListener('mousedown', (ev) => {
			arrastrando = true;
			const rect = canvas.getBoundingClientRect();
			arrastreInicio = {
				px: ev.clientX - rect.left,
				py: ev.clientY - rect.top,
				offsetX: view.offsetX,
				offsetY: view.offsetY,
			};
			tooltip.classList.add('hidden');
		});
		window.addEventListener('mouseup', () => { arrastrando = false; });

		canvas.addEventListener('mousemove', (ev) => {
			const rect = canvas.getBoundingClientRect();
			const px = ev.clientX - rect.left;
			const py = ev.clientY - rect.top;

			if (arrastrando) {
				view.offsetX = arrastreInicio.offsetX + (px - arrastreInicio.px);
				view.offsetY = arrastreInicio.offsetY + (py - arrastreInicio.py);
				nodoActivo = null;
				tooltip.classList.add('hidden');
				canvas.style.cursor = 'grabbing';
				return;
			}

			const nodo = nodoEnPosicion(px, py);
			nodoActivo = nodo;
			canvas.style.cursor = nodo ? 'pointer' : 'grab';
			if (nodo) mostrarTooltip(nodo, px, py);
			else tooltip.classList.add('hidden');
		});
		canvas.addEventListener('mouseleave', () => {
			nodoActivo = null;
			arrastrando = false;
			tooltip.classList.add('hidden');
		});

		// --- rueda para acercar/alejar, centrado en el cursor ---
		canvas.addEventListener(
			'wheel',
			(ev) => {
				ev.preventDefault();
				const rect = canvas.getBoundingClientRect();
				const factor = ev.deltaY < 0 ? 1.12 : 1 / 1.12;
				aplicarZoom(factor, ev.clientX - rect.left, ev.clientY - rect.top);
			},
			{ passive: false }
		);

		// --- un dedo para mover en tactil (sin pellizco, para mantenerlo simple) ---
		canvas.addEventListener(
			'touchstart',
			(ev) => {
				if (ev.touches.length !== 1) return;
				const rect = canvas.getBoundingClientRect();
				arrastrando = true;
				arrastreInicio = {
					px: ev.touches[0].clientX - rect.left,
					py: ev.touches[0].clientY - rect.top,
					offsetX: view.offsetX,
					offsetY: view.offsetY,
				};
			},
			{ passive: true }
		);
		canvas.addEventListener(
			'touchmove',
			(ev) => {
				if (!arrastrando || ev.touches.length !== 1) return;
				ev.preventDefault();
				const rect = canvas.getBoundingClientRect();
				const px = ev.touches[0].clientX - rect.left;
				const py = ev.touches[0].clientY - rect.top;
				view.offsetX = arrastreInicio.offsetX + (px - arrastreInicio.px);
				view.offsetY = arrastreInicio.offsetY + (py - arrastreInicio.py);
			},
			{ passive: false }
		);
		canvas.addEventListener('touchend', () => { arrastrando = false; });

		document.getElementById('zoom-in')!.addEventListener('click', () => aplicarZoom(1.3, ancho / 2, alto / 2));
		document.getElementById('zoom-out')!.addEventListener('click', () => aplicarZoom(1 / 1.3, ancho / 2, alto / 2));
		document.getElementById('zoom-reset')!.addEventListener('click', restablecerVista);

		const leyenda = document.getElementById('leyenda')!;
		leyenda.innerHTML = equipos
			.map((e, i) => {
				const color = COLORES_DIPUTADO[i % COLORES_DIPUTADO.length];
				return `<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full" style="background:${color}"></span>${e.nombre} (${e.asesores.length})</span>`;
			})
			.join('');

		window.addEventListener('resize', redimensionar);
		redimensionar();
		animar();
	</script>
</Layout>
