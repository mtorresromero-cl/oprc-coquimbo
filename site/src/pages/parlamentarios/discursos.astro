---
import Layout from '../../layouts/Layout.astro';
import { autoridades, analisisIntervenciones, fotoAutoridad, nombreMes } from '../../lib/datos';

const diputados = autoridades
	.filter((a) => a.cargo === 'diputado')
	.map((a) => ({ id: a.id, nombre: a.nombre_completo, foto: fotoAutoridad(a.id) }))
	.sort((a, b) => a.nombre.localeCompare(b.nombre));

const { participacion, top_palabras_por_autoridad, top_palabras_total, tendencia, coocurrencia } =
	analisisIntervenciones;

const participacionOrdenada = diputados
	.map((d) => ({ ...d, ...(participacion[d.id] ?? { intervenciones: 0, segundos: 0, con_texto: 0 }) }))
	.sort((a, b) => b.segundos - a.segundos);

function formatoDuracion(segundos: number): string {
	const min = Math.floor(segundos / 60);
	const seg = segundos % 60;
	return `${min}:${String(seg).padStart(2, '0')}`;
}

const mesesEtiquetas = tendencia.meses.map((m) => {
	const [anno, mes] = m.split('-').map(Number);
	return `${nombreMes(mes).slice(0, 3)} ${anno}`;
});
---

<Layout
	title="Intervenciones en sala — OPRC"
	description="Análisis de texto de los discursos de los 7 diputados de la Región de Coquimbo en sala: palabras más usadas, tendencia y red de coocurrencia."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Intervenciones en sala
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				{analisisIntervenciones.total_con_texto} discursos reales de los 7 diputados de la región,
				marzo-agosto 2026, vía el boletín de sesiones de camara.cl —
				{analisisIntervenciones.total_palabras_corpus.toLocaleString('es-CL')} palabras analizadas.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap gap-2">
			{['Participación', 'Palabras más usadas', 'Tendencia', 'Red de palabras'].map((label, i) => (
				<button
					type="button"
					data-tab={i}
					class:list={[
						'tab-btn cursor-pointer rounded-md px-4 py-2 text-sm font-semibold',
						i === 0 ? 'bg-topic-discursos text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50',
					]}
				>
					{label}
				</button>
			))}
		</div>

		<!-- Participación -->
		<section class="panel mt-8" data-panel="0">
			<h2 class="text-xl font-semibold text-slate-900">Participación</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Tiempo hablado y cantidad de intervenciones registradas por camara.cl, todo tipo de
				intervención (discursos, incidentes, puntos reglamentarios).
			</p>
			<div class="mt-6 space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				{participacionOrdenada.map((d) => {
					const max = Math.max(...participacionOrdenada.map((x) => x.segundos), 1);
					const anchoPct = (d.segundos / max) * 100;
					return (
						<div class="flex items-center gap-3">
							{d.foto ? (
								<img src={d.foto} alt="" class="h-8 w-8 shrink-0 rounded-full border-2 border-slate-100 object-cover" />
							) : (
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-slate-100 bg-brand-50 text-[10px] font-bold text-brand-700">
									{d.nombre.split(' ').slice(0, 2).map((p) => p[0]).join('')}
								</span>
							)}
							<a href={`/autoridades/${d.id}/`} class="w-24 shrink-0 truncate text-sm font-medium text-slate-800 hover:text-brand-600 hover:underline sm:w-56">
								{d.nombre}
							</a>
							<div class="h-4 flex-1 rounded bg-slate-100">
								<div class="h-4 rounded bg-topic-discursos" style={`width:${anchoPct}%`}></div>
							</div>
							<span class="w-16 shrink-0 text-right text-sm font-semibold text-slate-900 tabular-nums">{formatoDuracion(d.segundos)}</span>
							<span class="hidden w-20 shrink-0 text-right text-xs text-slate-400 sm:inline">{d.intervenciones} interv.</span>
						</div>
					);
				})}
			</div>
		</section>

		<!-- Palabras más usadas -->
		<section class="panel mt-8 hidden" data-panel="1">
			<h2 class="text-xl font-semibold text-slate-900">Palabras más usadas</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Sin palabras vacías ni fórmulas protocolares ("señor", "he dicho", etc.) — el vocabulario
				real de cada quien.
			</p>
			<select id="selector-diputado" class="mt-4 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
				<option value="__total__">Los 7 en conjunto</option>
				{diputados.map((d) => (
					<option value={d.id}>{d.nombre}</option>
				))}
			</select>
			<div id="lista-palabras" class="mt-4 grid gap-x-8 gap-y-1.5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2"></div>
		</section>

		<!-- Tendencia -->
		<section class="panel mt-8 hidden" data-panel="2">
			<h2 class="text-xl font-semibold text-slate-900">Tendencia mensual</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				De las palabras más usadas en total, cuántas veces aparece cada una mes a mes.
			</p>
			<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<svg id="grafico-tendencia" viewBox="0 0 720 340" class="w-full min-w-[600px]"></svg>
			</div>
			<div id="leyenda-tendencia" class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-600"></div>
		</section>

		<!-- Red de palabras -->
		<section class="panel mt-8 hidden" data-panel="3">
			<h2 class="text-xl font-semibold text-slate-900">Red de coocurrencia</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Qué palabras aparecen juntas en una misma intervención. El tamaño del punto es la
				frecuencia total; el grosor de la línea, cuántas veces esas dos palabras coincidieron.
				Arrastra para mover, rueda o pellizca para acercar.
			</p>
			<div class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
				<canvas id="red-palabras" class="block h-[520px] w-full touch-none"></canvas>
				<div id="tooltip-red" class="pointer-events-none absolute z-10 hidden max-w-[14rem] rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-lg"></div>
				<div class="absolute right-3 bottom-3 flex flex-col gap-1.5">
					<button id="zoom-in" type="button" aria-label="Acercar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">+</button>
					<button id="zoom-out" type="button" aria-label="Alejar" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-white text-lg font-semibold text-slate-600 shadow-sm hover:bg-slate-50">−</button>
				</div>
			</div>
		</section>

		<p class="mt-6 text-xs text-slate-400">
			Fuente: camara.cl, boletín de cada sesión de sala (texto completo, Legislatura 374).
			No incluye intervenciones tipo "Acuerdos y Resoluciones" (votos/mociones), que se registran
			como resumen sin cita textual, ni las sesiones donde el boletín aún no está disponible.
		</p>
	</main>

	<script type="application/json" id="palabras-data" set:html={JSON.stringify({ top_palabras_por_autoridad, top_palabras_total })} />
	<script type="application/json" id="tendencia-data" set:html={JSON.stringify({ ...tendencia, mesesEtiquetas })} />
	<script type="application/json" id="coocurrencia-data" set:html={JSON.stringify(coocurrencia)} />

	<script>
		// --- tabs ---
		document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const tab = btn.dataset.tab;
				document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((b) => {
					const activo = b === btn;
					b.classList.toggle('bg-topic-discursos', activo);
					b.classList.toggle('text-white', activo);
					b.classList.toggle('border', !activo);
					b.classList.toggle('border-slate-300', !activo);
					b.classList.toggle('text-slate-700', !activo);
					b.classList.toggle('hover:bg-slate-50', !activo);
				});
				document.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
					p.classList.toggle('hidden', p.dataset.panel !== tab);
				});
				// el canvas de la red mide 0x0 mientras su panel está oculto
				// (display:none) — hay que recalcular el layout recién cuando
				// se hace visible, si no los nodos quedan todos en (0,0)
				if (tab === '3') requestAnimationFrame(() => iniciarRedSiHaceFalta());
			});
		});

		// --- palabras más usadas ---
		interface PalabraFrecuencia { palabra: string; n: number }
		const palabrasData: {
			top_palabras_por_autoridad: Record<string, PalabraFrecuencia[]>;
			top_palabras_total: PalabraFrecuencia[];
		} = JSON.parse(document.getElementById('palabras-data')!.textContent!);

		function renderPalabras(clave: string) {
			const lista =
				clave === '__total__'
					? palabrasData.top_palabras_total
					: palabrasData.top_palabras_por_autoridad[clave] ?? [];
			const max = Math.max(...lista.map((p) => p.n), 1);
			const cont = document.getElementById('lista-palabras')!;
			cont.innerHTML = lista
				.slice(0, 30)
				.map(
					(p) => `
					<div class="flex items-center gap-2 py-0.5">
						<span class="w-24 shrink-0 truncate text-sm text-slate-700">${p.palabra}</span>
						<div class="h-2.5 flex-1 rounded-full bg-slate-100">
							<div class="h-2.5 rounded-full bg-topic-discursos" style="width:${(p.n / max) * 100}%"></div>
						</div>
						<span class="w-8 shrink-0 text-right text-xs font-semibold text-slate-500 tabular-nums">${p.n}</span>
					</div>`
				)
				.join('');
		}
		const selector = document.getElementById('selector-diputado') as HTMLSelectElement;
		selector.addEventListener('change', () => renderPalabras(selector.value));
		renderPalabras('__total__');

		// --- tendencia (linea SVG) ---
		const tendenciaData: { meses: string[]; palabras: string[]; serie: Record<string, number[]>; mesesEtiquetas: string[] } =
			JSON.parse(document.getElementById('tendencia-data')!.textContent!);

		const COLORES = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7', '#e34948'];

		(function renderTendencia() {
			const svg = document.getElementById('grafico-tendencia')!;
			const { meses, palabras, serie, mesesEtiquetas } = tendenciaData;
			if (meses.length < 2) {
				svg.outerHTML = '<p class="text-sm text-slate-500">No hay suficientes meses con datos todavía.</p>';
				return;
			}
			const palabrasMostradas = palabras.slice(0, 8);
			const padL = 30, padB = 30, padT = 10, padR = 10;
			const w = 720 - padL - padR;
			const h = 340 - padT - padB;
			const max = Math.max(...palabrasMostradas.flatMap((p) => serie[p]), 1);
			const x = (i: number) => padL + (i / (meses.length - 1)) * w;
			const y = (v: number) => padT + h - (v / max) * h;

			let svgHtml = `<line x1="${padL}" y1="${padT + h}" x2="${padL + w}" y2="${padT + h}" stroke="#e2e8f0" stroke-width="1" />`;
			meses.forEach((_, i) => {
				const esUltimo = i === meses.length - 1;
				if (!esUltimo && i % Math.ceil(meses.length / 6) !== 0) return;
				const anchor = i === 0 ? 'start' : esUltimo ? 'end' : 'middle';
				svgHtml += `<text x="${x(i)}" y="${padT + h + 16}" font-size="9" fill="#94a3b8" text-anchor="${anchor}">${mesesEtiquetas[i]}</text>`;
			});

			palabrasMostradas.forEach((palabra, pi) => {
				const color = COLORES[pi % COLORES.length];
				const puntos = serie[palabra].map((v, i) => `${x(i)},${y(v)}`).join(' ');
				svgHtml += `<polyline points="${puntos}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />`;
				const ultimoI = meses.length - 1;
				svgHtml += `<circle cx="${x(ultimoI)}" cy="${y(serie[palabra][ultimoI])}" r="3" fill="${color}" />`;
			});
			svg.innerHTML = svgHtml;

			const leyenda = document.getElementById('leyenda-tendencia')!;
			leyenda.innerHTML = palabrasMostradas
				.map((p, i) => `<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full" style="background:${COLORES[i % COLORES.length]}"></span>${p}</span>`)
				.join('');
		})();

		// --- red de coocurrencia (canvas, fuerzas, zoom/pan) ---
		interface Enlace { a: string; b: string; peso: number }
		const cooData: { nodos: PalabraFrecuencia[]; enlaces: Enlace[] } =
			JSON.parse(document.getElementById('coocurrencia-data')!.textContent!);

		type Nodo = { palabra: string; n: number; x: number; y: number; vx: number; vy: number; r: number };

		const canvas = document.getElementById('red-palabras') as HTMLCanvasElement;
		const ctx = canvas.getContext('2d')!;
		const tooltipRed = document.getElementById('tooltip-red')!;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		let anchoC = 0, altoC = 0;
		let nodos: Nodo[] = [];
		const view = { zoom: 1, offsetX: 0, offsetY: 0 };

		function construirNodosRed() {
			const cx = anchoC / 2, cy = altoC / 2;
			const maxN = Math.max(...cooData.nodos.map((n) => n.n), 1);
			nodos = cooData.nodos.map((n, i) => {
				const angulo = (i / cooData.nodos.length) * Math.PI * 2;
				const radio = Math.min(anchoC, altoC) * (0.15 + Math.random() * 0.2);
				return {
					palabra: n.palabra,
					n: n.n,
					x: cx + Math.cos(angulo) * radio,
					y: cy + Math.sin(angulo) * radio,
					vx: 0,
					vy: 0,
					r: 6 + (n.n / maxN) * 22,
				};
			});
		}

		function redimensionarRed() {
			const rect = canvas.getBoundingClientRect();
			anchoC = rect.width;
			altoC = rect.height;
			canvas.width = anchoC * dpr;
			canvas.height = altoC * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			construirNodosRed();
		}

		function pantallaAMundoRed(px: number, py: number) {
			return { x: (px - view.offsetX) / view.zoom, y: (py - view.offsetY) / view.zoom };
		}
		function aplicarZoomRed(factor: number, cx: number, cy: number) {
			const antes = pantallaAMundoRed(cx, cy);
			view.zoom = Math.min(4, Math.max(0.4, view.zoom * factor));
			view.offsetX = cx - antes.x * view.zoom;
			view.offsetY = cy - antes.y * view.zoom;
		}

		const maxPeso = Math.max(...cooData.enlaces.map((e) => e.peso), 1);
		let nodoActivoRed: Nodo | null = null;

		function pasoRed() {
			// centrado muy suave — solo evita que el conjunto se vaya
			// flotando fuera de pantalla, no debe competir con la repulsión
			const centroX = anchoC / 2, centroY = altoC / 2;
			for (const n of nodos) {
				n.vx += (centroX - n.x) * 0.0003;
				n.vy += (centroY - n.y) * 0.0003;
			}
			// repulsion de largo alcance entre TODOS los pares (no solo los
			// que ya están cerca) — si solo repele a corta distancia, el
			// centrado gana siempre y todo termina colapsado en un punto
			for (let i = 0; i < nodos.length; i++) {
				for (let j = i + 1; j < nodos.length; j++) {
					const a = nodos[i], b = nodos[j];
					const dx = b.x - a.x, dy = b.y - a.y;
					// piso de distancia alto a propósito: con 1/dist^2 y un
					// piso de 1px, dos nodos que arrancan casi superpuestos
					// reciben una fuerza gigante y salen disparados fuera de
					// pantalla en vez de simplemente separarse
					const dist = Math.max(Math.hypot(dx, dy), 24);
					const f = Math.min(1400 / (dist * dist), 6);
					const fx = (dx / dist) * f, fy = (dy / dist) * f;
					a.vx -= fx; a.vy -= fy;
					b.vx += fx; b.vy += fy;
				}
			}
			for (const e of cooData.enlaces) {
				const a = nodos.find((n) => n.palabra === e.a)!;
				const b = nodos.find((n) => n.palabra === e.b)!;
				const dx = b.x - a.x, dy = b.y - a.y;
				const dist = Math.max(Math.hypot(dx, dy), 1);
				const objetivo = 160;
				const f = (dist - objetivo) * 0.004 * Math.min(e.peso / maxPeso + 0.2, 1);
				a.vx += dx * f; a.vy += dy * f;
				b.vx -= dx * f; b.vy -= dy * f;
			}
			for (const n of nodos) {
				if (
					!Number.isFinite(n.x) || !Number.isFinite(n.y) ||
					!Number.isFinite(n.vx) || !Number.isFinite(n.vy)
				) {
					// red de seguridad: si un nodo se corrompe (NaN), no dejar
					// que su distancia infinita/NaN contamine al resto via la
					// repulsion/resorte del proximo frame
					n.x = anchoC / 2 + (Math.random() - 0.5) * 40;
					n.y = altoC / 2 + (Math.random() - 0.5) * 40;
					n.vx = 0; n.vy = 0;
				}
				n.vx *= 0.85; n.vy *= 0.85;
				const velocidad = Math.hypot(n.vx, n.vy);
				const VELOCIDAD_MAX = 15;
				if (velocidad > VELOCIDAD_MAX) {
					n.vx = (n.vx / velocidad) * VELOCIDAD_MAX;
					n.vy = (n.vy / velocidad) * VELOCIDAD_MAX;
				}
				n.x += n.vx; n.y += n.vy;
			}
		}

		function dibujarRed() {
			ctx.clearRect(0, 0, anchoC, altoC);
			ctx.save();
			ctx.translate(view.offsetX, view.offsetY);
			ctx.scale(view.zoom, view.zoom);

			for (const e of cooData.enlaces) {
				const a = nodos.find((n) => n.palabra === e.a)!;
				const b = nodos.find((n) => n.palabra === e.b)!;
				const atenuado = nodoActivoRed && nodoActivoRed.palabra !== e.a && nodoActivoRed.palabra !== e.b;
				ctx.beginPath();
				ctx.moveTo(a.x, a.y);
				ctx.lineTo(b.x, b.y);
				ctx.strokeStyle = `rgba(74,58,167,${atenuado ? 0.04 : 0.1 + (e.peso / maxPeso) * 0.3})`;
				ctx.lineWidth = (0.5 + (e.peso / maxPeso) * 2.5) / view.zoom;
				ctx.stroke();
			}
			for (const n of nodos) {
				const atenuado = nodoActivoRed && !cooData.enlaces.some(
					(e) => (e.a === nodoActivoRed!.palabra && e.b === n.palabra) || (e.b === nodoActivoRed!.palabra && e.a === n.palabra)
				) && nodoActivoRed.palabra !== n.palabra;
				ctx.globalAlpha = atenuado ? 0.25 : 1;
				ctx.beginPath();
				ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
				ctx.fillStyle = '#4a3aa7cc';
				ctx.fill();
				ctx.fillStyle = '#fff';
				ctx.font = `${Math.min(11, 7 + n.r * 0.15)}px "Space Grotesk", sans-serif`;
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				if (n.r > 9) ctx.fillText(n.palabra, n.x, n.y);
				ctx.globalAlpha = 1;
			}
			ctx.restore();
		}

		function animarRed() {
			pasoRed();
			dibujarRed();
			requestAnimationFrame(animarRed);
		}

		function nodoEnPosicionRed(px: number, py: number): Nodo | null {
			const m = pantallaAMundoRed(px, py);
			for (let i = nodos.length - 1; i >= 0; i--) {
				if (Math.hypot(nodos[i].x - m.x, nodos[i].y - m.y) <= nodos[i].r + 2) return nodos[i];
			}
			return null;
		}

		let arrastrandoRed = false;
		let inicioArrastreRed = { px: 0, py: 0, offsetX: 0, offsetY: 0 };

		canvas.addEventListener('mousedown', (ev) => {
			arrastrandoRed = true;
			const rect = canvas.getBoundingClientRect();
			inicioArrastreRed = { px: ev.clientX - rect.left, py: ev.clientY - rect.top, offsetX: view.offsetX, offsetY: view.offsetY };
			tooltipRed.classList.add('hidden');
		});
		window.addEventListener('mouseup', () => { arrastrandoRed = false; });
		canvas.addEventListener('mousemove', (ev) => {
			const rect = canvas.getBoundingClientRect();
			const px = ev.clientX - rect.left, py = ev.clientY - rect.top;
			if (arrastrandoRed) {
				view.offsetX = inicioArrastreRed.offsetX + (px - inicioArrastreRed.px);
				view.offsetY = inicioArrastreRed.offsetY + (py - inicioArrastreRed.py);
				nodoActivoRed = null;
				tooltipRed.classList.add('hidden');
				canvas.style.cursor = 'grabbing';
				return;
			}
			const nodo = nodoEnPosicionRed(px, py);
			nodoActivoRed = nodo;
			canvas.style.cursor = nodo ? 'pointer' : 'grab';
			if (nodo) {
				tooltipRed.classList.remove('hidden');
				tooltipRed.style.left = `${Math.min(px + 12, anchoC - 200)}px`;
				tooltipRed.style.top = `${py + 12}px`;
				tooltipRed.innerHTML = `<p class="font-semibold text-slate-900">${nodo.palabra}</p><p class="mt-1 text-slate-500">${nodo.n} menciones</p>`;
			} else {
				tooltipRed.classList.add('hidden');
			}
		});
		canvas.addEventListener('mouseleave', () => { arrastrandoRed = false; nodoActivoRed = null; tooltipRed.classList.add('hidden'); });
		canvas.addEventListener('wheel', (ev) => {
			ev.preventDefault();
			const rect = canvas.getBoundingClientRect();
			aplicarZoomRed(ev.deltaY < 0 ? 1.12 : 1 / 1.12, ev.clientX - rect.left, ev.clientY - rect.top);
		}, { passive: false });
		canvas.addEventListener('touchstart', (ev) => {
			if (ev.touches.length !== 1) return;
			const rect = canvas.getBoundingClientRect();
			arrastrandoRed = true;
			inicioArrastreRed = { px: ev.touches[0].clientX - rect.left, py: ev.touches[0].clientY - rect.top, offsetX: view.offsetX, offsetY: view.offsetY };
		}, { passive: true });
		canvas.addEventListener('touchmove', (ev) => {
			if (!arrastrandoRed || ev.touches.length !== 1) return;
			ev.preventDefault();
			const rect = canvas.getBoundingClientRect();
			const px = ev.touches[0].clientX - rect.left, py = ev.touches[0].clientY - rect.top;
			view.offsetX = inicioArrastreRed.offsetX + (px - inicioArrastreRed.px);
			view.offsetY = inicioArrastreRed.offsetY + (py - inicioArrastreRed.py);
		}, { passive: false });
		canvas.addEventListener('touchend', () => { arrastrandoRed = false; });
		document.getElementById('zoom-in')!.addEventListener('click', () => aplicarZoomRed(1.3, anchoC / 2, altoC / 2));
		document.getElementById('zoom-out')!.addEventListener('click', () => aplicarZoomRed(1 / 1.3, anchoC / 2, altoC / 2));

		// el panel de la red empieza oculto (display:none) — iniciar la
		// simulación ahí mismo mide un canvas de 0x0 y arma todo el grafo
		// en el origen; se posterga hasta que el panel se muestra de verdad
		let redIniciada = false;
		function iniciarRedSiHaceFalta() {
			if (redIniciada) return;
			redIniciada = true;
			window.addEventListener('resize', redimensionarRed);
			redimensionarRed();
			animarRed();
		}
	</script>
</Layout>
