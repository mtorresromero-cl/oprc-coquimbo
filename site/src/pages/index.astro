---
import Layout from '../layouts/Layout.astro';
import {
	autoridades,
	comunas,
	votaciones,
	votacionesCore,
	presupuesto,
	personal,
	composicionPartidoTodos,
	composicionPorGenero,
	composicionPorGeneroYCargo,
	dotacionPorTipoContrato,
	remuneracionAlcaldesPorComuna,
	autoridadesPorCargoProvincia,
	nombreMes,
} from '../lib/datos';

const comunasConDatos = comunas.filter(
	(c) => presupuesto.some((p) => p.comuna_id === c.id) || personal.some((p) => p.comuna_id === c.id)
).length;

const composicionPartido = composicionPartidoTodos();
const totalAutoridadesConPartido = composicionPartido.reduce((s, p) => s + p.total, 0);
const maxPartido = Math.max(...composicionPartido.map((p) => p.total), 1);

const composicionGenero = composicionPorGenero();
const totalConGenero = composicionGenero.reduce((s, g) => s + g.total, 0);
const maxGenero = Math.max(...composicionGenero.map((g) => g.total), 1);

const generoPorCargo = composicionPorGeneroYCargo();
const maxGeneroPorCargo = Math.max(...generoPorCargo.flatMap((c) => [c.hombres, c.mujeres]), 1);

const dotacionTipo = dotacionPorTipoContrato();
const totalDotacion = dotacionTipo.reduce((s, d) => s + d.dotacion, 0);
const maxDotacionTipo = Math.max(...dotacionTipo.map((d) => d.dotacion), 1);
const municipiosConDotacion = new Set(personal.map((p) => p.comuna_id)).size;
const TIPO_CONTRATO_LABEL_HOME: Record<string, string> = {
	planta: 'Planta',
	contrata: 'Contrata',
	honorarios: 'Honorarios',
};

const remuneracionAlcaldes = remuneracionAlcaldesPorComuna();
const comunasSinRemuneracion = comunas
	.filter((c) => !remuneracionAlcaldes.some((r) => r.comunaId === c.id))
	.map((c) => c.nombre);
const maxRemuneracion = Math.max(...remuneracionAlcaldes.map((r) => r.remuneracionBruta), 1);

const cargoProvincia = autoridadesPorCargoProvincia();
const maxCargoProvincia = Math.max(...cargoProvincia.flatMap((p) => [p.alcalde, p.concejal, p.core]), 1);

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}

// Radar del hero: mismas 6 áreas de trabajo que en /nosotros/, recoloreado
// para verse sobre el fondo oscuro del hero en vez del fondo blanco.
const RADIO_RADAR = 36;
const nodosRadar = [
	['Información', 'Pública'],
	['Evaluación', 'de Gestión'],
	['Monitoreo', 'en Vivo'],
	['Participación', 'Ciudadana'],
	['Datos y', 'Metodología'],
	['Transparencia', 'Financiera'],
].map(([l1, l2], i) => {
	const angulo = (-90 + i * 60) * (Math.PI / 180);
	return {
		l1,
		l2,
		left: 50 + RADIO_RADAR * Math.cos(angulo),
		top: 50 + RADIO_RADAR * Math.sin(angulo),
		delay: (i * 4) / 6,
	};
});

const stats = [
	{ valor: autoridades.length, label: 'autoridades registradas' },
	{ valor: comunas.length, label: 'comunas de la región' },
	{ valor: comunasConDatos, label: 'con datos de transparencia' },
	{ valor: votaciones.length + votacionesCore.length, label: 'votaciones registradas' },
];

const secciones = [
	{
		href: '/autoridades/',
		titulo: 'Autoridades',
		descripcion: `Alcaldes, concejales, consejeros regionales, diputados y senadores de la región — ${autoridades.length} en total.`,
		icono: 'personas',
	},
	{
		href: '/municipios/',
		titulo: 'Municipios',
		descripcion: 'Presupuesto, dotación y remuneraciones de las 15 comunas, según el Portal de Transparencia.',
		icono: 'edificio',
	},
	{
		href: '/parlamentarios/',
		titulo: 'Parlamentarios',
		descripcion: 'Ranking de participación y votaciones recientes de senadores y diputados de la región.',
		icono: 'columnas',
	},
	{
		href: '/consejo-regional/',
		titulo: 'Consejo Regional',
		descripcion: 'Ranking de participación y acuerdos recientes de los consejeros regionales y el gobernador.',
		icono: 'acuerdo',
	},
];

const queHacemos = [
	{
		titulo: 'Análisis político',
		texto: 'Estudiamos el contexto político de la región, facilitando información sobre autoridades, elecciones y decisiones clave.',
		icono: 'lupa',
	},
	{
		titulo: 'Fiscalización ciudadana',
		texto: 'Te damos herramientas para monitorear y evaluar el trabajo de las autoridades locales y regionales.',
		icono: 'escudo',
	},
	{
		titulo: 'Datos abiertos',
		texto: 'Publicamos las fuentes y la metodología detrás de cada dato, actualizados de forma automática cada semana.',
		icono: 'grafico',
	},
];

const ICONOS: Record<string, string> = {
	personas:
		'M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m5-2.13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-2a4 4 0 1 0 0-8m-14 8a4 4 0 1 1 0-8',
	edificio: 'M3 21h18M6 21V7l6-4 6 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01',
	lupa: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35',
	escudo: 'M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6l-8-3Zm-2.5 9 2 2 4-4',
	grafico: 'M4 20V10m6 10V4m6 16v-7',
	columnas: 'M3 21h18M4 21V10m4 11V10m4 11V10m4 11V10m4 11V10M2 10l10-6 10 6',
	acuerdo: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
	electoral: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
	gasto: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
};
---

<Layout title="OPRC — Observatorio Político Región de Coquimbo">
	<main>
		<section class="relative overflow-hidden bg-slate-900">
			<div
				class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"
			>
			</div>
			<div
				class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"
			>
			</div>
			<div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-24 lg:grid-cols-[1fr_20rem] lg:items-center">
				<div>
					<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">
						Observatorio Político Región de Coquimbo
					</p>
					<h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
						Seguimiento ciudadano de la política regional
					</h1>
					<p class="mt-5 max-w-2xl text-lg text-slate-300">
						Datos públicos sobre autoridades, parlamentarios y transparencia municipal, recopilados
						directamente de fuentes oficiales.
					</p>
					<div class="mt-9 flex flex-wrap gap-3">
						<a
							href="/autoridades/"
							class="inline-block rounded-md bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 hover:bg-brand-500"
						>
							Ver autoridades
						</a>
						<a
							href="/municipios/"
							class="inline-block rounded-md border border-slate-600 px-6 py-3 text-sm font-semibold text-white hover:border-slate-400 hover:bg-white/5"
						>
							Ver municipios
						</a>
					</div>
				</div>

				<div class="flex flex-col items-center gap-4">
					<div class="radar-face relative aspect-square w-full max-w-[19rem]" role="img" aria-label="Radar con las seis áreas de trabajo del Observatorio">
						<div class="absolute inset-[13%] rounded-full border border-white/15"></div>
						<div class="absolute inset-[30%] rounded-full border border-white/15"></div>
						<div class="absolute inset-[47%] rounded-full border border-white/15"></div>

						<div class="absolute inset-0 overflow-hidden rounded-full">
							<div class="radar-sweep absolute inset-0"></div>
						</div>

						<div class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-300"></div>

						{nodosRadar.map((nd) => (
							<div class="absolute -translate-x-1/2 -translate-y-1/2" style={{ left: `${nd.left}%`, top: `${nd.top}%` }}>
								<span class="radar-blip mx-auto block h-2 w-2 rounded-full bg-brand-300" style={{ animationDelay: `${nd.delay}s` }}></span>
								<span class="absolute top-4 left-1/2 w-20 -translate-x-1/2 text-center text-[9.5px] leading-tight font-medium text-slate-200">
									{nd.l1}<br />{nd.l2}
								</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="bg-brand-600">
			<dl class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-10 sm:grid-cols-4">
				{stats.map((s) => (
					<div class="text-center">
						<dt class="text-4xl font-bold text-white">{s.valor}</dt>
						<dd class="mt-1 text-sm font-medium text-brand-100">{s.label}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">¿Qué hacemos?</h2>
			<div class="mt-8 grid gap-8 sm:grid-cols-3">
				{queHacemos.map((item) => (
					<div>
						<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
								<path d={ICONOS[item.icono]} />
							</svg>
						</div>
						<h3 class="mt-4 font-semibold text-slate-900">{item.titulo}</h3>
						<p class="mt-2 text-base leading-relaxed text-slate-600">{item.texto}</p>
					</div>
				))}
			</div>
		</section>

		<section class="bg-slate-900">
			<div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
				<div class="flex items-center gap-4">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-600/20 text-brand-300">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.electoral} />
						</svg>
					</div>
					<div>
						<p class="text-lg font-semibold text-white">¿Te interesan los datos electorales?</p>
						<p class="mt-1 text-sm text-slate-300">Resultados, participación, plebiscitos, comparador y padrón, desde 1989.</p>
					</div>
				</div>
				<a
					href="/herramientas/electoral/"
					class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500"
				>
					Revísalos acá &rarr;
				</a>
			</div>
		</section>

		<section class="bg-topic-gasto">
			<div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
				<div class="flex items-center gap-4">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white/20 text-white">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.gasto} />
						</svg>
					</div>
					<div>
						<p class="text-lg font-semibold text-white">¿Sabes en qué gastan los parlamentarios?</p>
						<p class="mt-1 text-sm text-white/80">Oficina, personal de apoyo, pasajes — mes a mes, por cada diputado/a de la región.</p>
					</div>
				</div>
				<a
					href="/parlamentarios/gastos/"
					class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-topic-gasto shadow-sm hover:bg-white/90"
				>
					Revisa el gasto &rarr;
				</a>
			</div>
		</section>

		<section class="border-b border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-16">
				<h2 class="text-2xl font-bold tracking-tight text-slate-900">
					Composición por partido — todas las autoridades
				</h2>
				<p class="mt-2 max-w-2xl text-base text-slate-600">
					Las {totalAutoridadesConPartido} autoridades de la Región de Coquimbo con partido
					declarado: alcaldes, concejales, consejeros regionales, el gobernador, diputados y
					senadores.
				</p>
				<div class="mt-8 space-y-3">
					{composicionPartido.map((p) => (
						<div class="flex items-center gap-4">
							<span class="w-56 shrink-0 truncate text-sm font-medium text-slate-700">{p.partido}</span>
							<div class="h-6 flex-1 rounded bg-slate-200">
								<div
									class="h-6 rounded bg-brand-600"
									style={`width:${(p.total / maxPartido) * 100}%`}
								>
								</div>
							</div>
							<span class="w-6 shrink-0 text-right text-sm font-semibold text-slate-900">{p.total}</span>
						</div>
					))}
				</div>

				<a href="/autoridades/" class="mt-6 inline-block text-sm font-semibold text-brand-600 hover:underline">
					Ver el detalle de cada autoridad &rarr;
				</a>
			</div>
		</section>

		<section class="border-y border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-16">
				<div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
					<div class="space-y-12">
						<div>
							<h2 class="text-2xl font-bold tracking-tight text-slate-900">Autoridades por provincia</h2>
							<p class="mt-2 text-base text-slate-600">
								Alcaldes y concejales según la provincia de su comuna; consejeros regionales según su
								circunscripción provincial. No incluye senadores, diputados ni al
								gobernador, que representan a toda la región y no a una provincia en particular.
							</p>
							<div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
								<table class="w-full text-sm">
									<thead class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
										<tr>
											<th class="px-4 py-3">Provincia</th>
											<th class="px-4 py-3 text-right">Alcaldes</th>
											<th class="px-4 py-3 text-right">Concejales</th>
											<th class="px-4 py-3 text-right">Consejeros regionales</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-slate-100 bg-white">
										{cargoProvincia.map((p) => (
											<tr>
												<td class="px-4 py-3 font-medium text-slate-900">{p.provincia}</td>
												<td class="px-4 py-3 text-right text-slate-700">{p.alcalde}</td>
												<td class="px-4 py-3 text-right text-slate-700">{p.concejal}</td>
												<td class="px-4 py-3 text-right text-slate-700">{p.core}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</div>

						<div>
							<h2 class="text-2xl font-bold tracking-tight text-slate-900">Composición por género</h2>
							<p class="mt-2 text-base text-slate-600">
								Estimación a partir del nombre de cada una de las {totalConGenero} autoridades. No es un
								dato publicado por las fuentes oficiales (SERVEL, BCN, Portal de Transparencia), que no
								registran sexo o género.
							</p>
							<div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
								<div class="space-y-3">
									{composicionGenero.map((g) => (
										<div class="flex items-center gap-4">
											<span class="w-16 shrink-0 text-sm font-medium text-slate-700">{g.label}</span>
											<div class="h-6 flex-1 rounded bg-slate-200">
												<div
													class="h-6 rounded bg-brand-600"
													style={`width:${(g.total / maxGenero) * 100}%`}
												>
												</div>
											</div>
											<span class="w-24 shrink-0 text-right text-sm font-semibold text-slate-900">
												{g.total} <span class="font-normal text-slate-500">({Math.round((g.total / totalConGenero) * 100)}%)</span>
											</span>
										</div>
									))}
								</div>
							</div>
						</div>

						<div>
							<h2 class="text-2xl font-bold tracking-tight text-slate-900">Género por cargo</h2>
							<p class="mt-2 text-base text-slate-600">
								La misma estimación, desglosada por tipo de cargo.
							</p>
							<div class="mt-8 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
								<div class="mb-4 flex items-center justify-center gap-8 text-xs font-semibold tracking-wide text-slate-500 uppercase">
									<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-slate-600"></span>Hombres</span>
									<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-brand-600"></span>Mujeres</span>
								</div>
								<div class="space-y-2.5">
									{generoPorCargo.map((c) => (
										<div class="flex items-center gap-1 sm:gap-2">
											<span class="w-12 shrink-0 text-right text-[10px] font-medium text-slate-600 sm:w-20 sm:text-xs">
												{c.hombres} <span class="text-slate-400">({Math.round(c.hombresPct)}%)</span>
											</span>
											<div class="flex h-4 flex-1 justify-end">
												<div class="h-4 rounded-l bg-slate-600" style={`width:${(c.hombres / maxGeneroPorCargo) * 100}%`}></div>
											</div>
											<span class="w-16 shrink-0 text-center text-[10px] font-semibold text-slate-900 sm:w-28 sm:text-xs">{c.label}</span>
											<div class="flex h-4 flex-1 justify-start">
												<div class="h-4 rounded-r bg-brand-600" style={`width:${(c.mujeres / maxGeneroPorCargo) * 100}%`}></div>
											</div>
											<span class="w-12 shrink-0 text-[10px] font-medium text-slate-600 sm:w-20 sm:text-xs">
												{c.mujeres} <span class="text-slate-400">({Math.round(c.mujeresPct)}%)</span>
											</span>
										</div>
									))}
								</div>
							</div>
						</div>
					</div>

					<div>
						<h2 class="text-2xl font-bold tracking-tight text-slate-900">Datos municipales</h2>

						<div class="mt-8">
							<h3 class="font-semibold text-slate-900">Dotación por tipo de contrato</h3>
							<p class="mt-1 text-base text-slate-600">
								Suma regional de las {totalDotacion} personas que trabajan en los {municipiosConDotacion} municipios con
								datos publicados.
							</p>
							<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
								<div class="space-y-3">
									{dotacionTipo.map((d) => (
										<div class="flex items-center gap-4">
											<span class="w-24 shrink-0 text-sm font-medium text-slate-700">{TIPO_CONTRATO_LABEL_HOME[d.tipoContrato] ?? d.tipoContrato}</span>
											<div class="h-6 flex-1 rounded bg-slate-200">
												<div class="h-6 rounded bg-brand-600" style={`width:${(d.dotacion / maxDotacionTipo) * 100}%`}></div>
											</div>
											<span class="w-14 shrink-0 text-right text-sm font-semibold text-slate-900">{d.dotacion}</span>
										</div>
									))}
								</div>
							</div>
						</div>

						<div class="mt-12">
							<h3 class="font-semibold text-slate-900">Remuneración de alcaldes/as por comuna</h3>
							<p class="mt-1 text-base text-slate-600">
								Remuneración bruta del mes más reciente publicado por cada comuna (indicado junto a
								cada barra) según el Portal de Transparencia. No incluye a concejales.
								{comunasSinRemuneracion.length > 0 && (
									<>{' '}Falta{comunasSinRemuneracion.length === 1 ? '' : 'n'} {comunasSinRemuneracion.join(' y ')}, sin registro disponible.</>
								)}
							</p>
							<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
								<div class="space-y-2.5">
									{remuneracionAlcaldes.map((r) => (
										<div class="flex items-center gap-4">
											<span class="w-28 shrink-0 truncate text-sm font-medium text-slate-700">{r.nombreComuna}</span>
											<div class="h-5 flex-1 rounded bg-slate-200">
												<div class="h-5 rounded bg-brand-600" style={`width:${(r.remuneracionBruta / maxRemuneracion) * 100}%`}></div>
											</div>
											<span class="w-32 shrink-0 text-right text-xs font-semibold text-slate-900">
												{formatoCLP(r.remuneracionBruta)}
												<span class="block font-normal text-slate-400">{nombreMes(r.mes)}/{r.anno}</span>
											</span>
										</div>
									))}
								</div>
							</div>
							<p class="mt-4 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800">
								<strong>Por qué varía tanto entre comunas:</strong> revisamos el histórico
								enero-julio 2026 de las 15 comunas y en la mayoría hay un salto de 30-70% en mayo y
								julio sobre su línea base de otros meses — compatible con algún bono o asignación
								variable que no se paga todos los meses. No es parejo: algunas comunas (Paihuano,
								Salamanca, Combarbalá, Canela, La Higuera) se mantienen planas todo el semestre. Por
								eso esta cifra no es un sueldo base comparable 1 a 1 entre comunas, sino el monto
								bruto de ese mes puntual.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-16">
				<h2 class="text-2xl font-bold tracking-tight text-slate-900">Explorar los datos</h2>
				<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{secciones.map((s) => (
						<a
							href={s.href}
							class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
						>
							<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
									<path d={ICONOS[s.icono]} />
								</svg>
							</div>
							<h3 class="mt-4 font-semibold text-slate-900 group-hover:text-brand-700">{s.titulo}</h3>
							<p class="mt-2 text-base leading-relaxed text-slate-600">{s.descripcion}</p>
							<span class="mt-4 inline-block text-sm font-semibold text-brand-600">Ver más &rarr;</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>

	<style>
		.radar-sweep {
			background: conic-gradient(from 0deg, transparent 0deg, rgba(245, 179, 179, 0.35) 18deg, transparent 60deg);
			animation: radar-spin 4s linear infinite;
		}
		@keyframes radar-spin {
			to { transform: rotate(360deg); }
		}
		.radar-blip {
			animation: radar-blip 4s ease-out infinite;
		}
		@keyframes radar-blip {
			0%, 92% { box-shadow: 0 0 0 0 rgba(245, 179, 179, 0.55); }
			4% { box-shadow: 0 0 0 6px rgba(245, 179, 179, 0); }
		}
		@media (prefers-reduced-motion: reduce) {
			.radar-sweep {
				animation: none;
				background: none;
			}
			.radar-blip {
				animation: none;
			}
		}
	</style>
</Layout>
