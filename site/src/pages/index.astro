---
import Layout from '../layouts/Layout.astro';
import { autoridades, comunas, votaciones, votacionesCore, gastoParlamentario, analisisIntervenciones } from '../lib/datos';

// Solo las 2 categorías con monto real verificado (gastos_operacionales y
// personal_apoyo) — pasajes_aereos no tiene costo publicado y
// asesorias_externas no tiene datos, así que sumarlas inflaría la cifra
// con ceros que no son un gasto real de cero.
const totalGastoFiscalizado = gastoParlamentario
	.filter((g) => (g.categoria === 'gastos_operacionales' || g.categoria === 'personal_apoyo') && g.monto)
	.reduce((s, g) => s + (g.monto ?? 0), 0);

// Radar del hero: mismas 6 áreas de trabajo que en /nosotros/, recoloreado
// para verse sobre el fondo oscuro del hero en vez del fondo blanco.
const RADIO_RADAR = 36;
const nodosRadar = [
	['Información', 'Pública'],
	['Evaluación', 'de Gestión'],
	['Monitoreo', 'en Vivo'],
	['Participación', 'Ciudadana'],
	['Datos y', 'Metodología'],
	['Transparencia', 'Financiera'],
].map(([l1, l2], i) => {
	const angulo = (-90 + i * 60) * (Math.PI / 180);
	return {
		l1,
		l2,
		left: 50 + RADIO_RADAR * Math.cos(angulo),
		top: 50 + RADIO_RADAR * Math.sin(angulo),
		delay: (i * 4) / 6,
	};
});

const stats = [
	{ valor: autoridades.length, label: 'autoridades registradas' },
	{ valor: comunas.length, label: 'comunas de la región' },
	{ valor: `$${Math.round(totalGastoFiscalizado / 1_000_000)}M`, label: 'en gasto parlamentario fiscalizado' },
	{ valor: votaciones.length + votacionesCore.length, label: 'votaciones registradas' },
];

const secciones = [
	{
		href: '/autoridades/',
		titulo: 'Autoridades',
		descripcion: `Alcaldes, concejales, consejeros regionales, diputados y senadores de la región — ${autoridades.length} en total.`,
		icono: 'personas',
	},
	{
		href: '/municipios/',
		titulo: 'Municipios',
		descripcion: 'Presupuesto, dotación y remuneraciones de las 15 comunas, según el Portal de Transparencia.',
		icono: 'edificio',
	},
	{
		href: '/parlamentarios/',
		titulo: 'Parlamentarios',
		descripcion: 'Ranking de participación y votaciones recientes de senadores y diputados de la región.',
		icono: 'columnas',
	},
	{
		href: '/consejo-regional/',
		titulo: 'Consejo Regional',
		descripcion: 'Ranking de participación y acuerdos recientes de los consejeros regionales y el gobernador.',
		icono: 'acuerdo',
	},
];

const queHacemos = [
	{
		titulo: 'Análisis político',
		texto: 'Estudiamos el contexto político de la región, facilitando información sobre autoridades, elecciones y decisiones clave.',
		icono: 'lupa',
	},
	{
		titulo: 'Fiscalización ciudadana',
		texto: 'Te damos herramientas para monitorear y evaluar el trabajo de las autoridades locales y regionales.',
		icono: 'escudo',
	},
	{
		titulo: 'Datos abiertos',
		texto: 'Publicamos las fuentes y la metodología detrás de cada dato, actualizados de forma automática cada semana.',
		icono: 'grafico',
	},
];

const ICONOS: Record<string, string> = {
	personas: 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
	edificio: 'M3 21h18M6 21V7l6-4 6 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01',
	lupa: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35',
	escudo: 'M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6l-8-3Zm-2.5 9 2 2 4-4',
	grafico: 'M4 20V10m6 10V4m6 16v-7',
	columnas: 'M3 21h18M4 21V10m4 11V10m4 11V10m4 11V10m4 11V10M2 10l10-6 10 6',
	acuerdo: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
	electoral: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
	gasto: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
	comparar: 'M8 3 4 7l4 4M4 7h16M16 21l4-4-4-4M20 17H4',
	discursos: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z',
};
---

<Layout title="OPRC — Observatorio Político Región de Coquimbo">
	<main>
		<section class="relative overflow-hidden bg-slate-900">
			<div
				class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"
			>
			</div>
			<div
				class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"
			>
			</div>
			<div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-24 lg:grid-cols-[1fr_20rem] lg:items-center">
				<div>
					<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">
						Observatorio Político Región de Coquimbo
					</p>
					<h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
						Seguimiento ciudadano de la política regional
					</h1>
					<p class="mt-5 max-w-2xl text-lg text-slate-300">
						Datos públicos sobre autoridades, parlamentarios y transparencia municipal, recopilados
						directamente de fuentes oficiales.
					</p>
					<div class="mt-9 flex flex-wrap gap-3">
						<a
							href="/autoridades/"
							class="inline-block rounded-md bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 hover:bg-brand-500"
						>
							Ver autoridades
						</a>
						<a
							href="/municipios/"
							class="inline-block rounded-md border border-slate-600 px-6 py-3 text-sm font-semibold text-white hover:border-slate-400 hover:bg-white/5"
						>
							Ver municipios
						</a>
					</div>
				</div>

				<div class="flex flex-col items-center gap-4">
					<div class="radar-face relative aspect-square w-full max-w-[19rem]" role="img" aria-label="Radar con las seis áreas de trabajo del Observatorio">
						<div class="absolute inset-[13%] rounded-full border border-white/15"></div>
						<div class="absolute inset-[30%] rounded-full border border-white/15"></div>
						<div class="absolute inset-[47%] rounded-full border border-white/15"></div>

						<div class="absolute inset-0 overflow-hidden rounded-full">
							<div class="radar-sweep absolute inset-0"></div>
						</div>

						<div class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-300"></div>

						{nodosRadar.map((nd) => (
							<div class="absolute -translate-x-1/2 -translate-y-1/2" style={{ left: `${nd.left}%`, top: `${nd.top}%` }}>
								<span class="radar-blip mx-auto block h-2 w-2 rounded-full bg-brand-300" style={{ animationDelay: `${nd.delay}s` }}></span>
								<span class="absolute top-4 left-1/2 w-20 -translate-x-1/2 text-center text-[9.5px] leading-tight font-medium text-slate-200">
									{nd.l1}<br />{nd.l2}
								</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="bg-brand-600">
			<dl class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-10 sm:grid-cols-4">
				{stats.map((s) => (
					<div class="text-center">
						<dt class="text-4xl font-bold text-white">{s.valor}</dt>
						<dd class="mt-1 text-sm font-medium text-brand-100">{s.label}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">¿Qué hacemos?</h2>
			<div class="mt-8 grid gap-8 sm:grid-cols-3">
				{queHacemos.map((item) => (
					<div>
						<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
								<path d={ICONOS[item.icono]} />
							</svg>
						</div>
						<h3 class="mt-4 font-semibold text-slate-900">{item.titulo}</h3>
						<p class="mt-2 text-base leading-relaxed text-slate-600">{item.texto}</p>
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-12">
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
				<div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-sm">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-600/20 text-brand-300">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.electoral} />
						</svg>
					</div>
					<p class="mt-4 text-lg font-semibold text-white">¿Te interesan los datos electorales?</p>
					<p class="mt-1 text-sm text-slate-300">Resultados, participación, plebiscitos, comparador y padrón, desde 1989.</p>
					<a
						href="/herramientas/electoral/"
						class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500"
					>
						Revísalos acá &rarr;
					</a>
				</div>

				<div class="rounded-2xl border border-topic-gasto bg-topic-gasto p-8 shadow-sm">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white/20 text-white">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.gasto} />
						</svg>
					</div>
					<p class="mt-4 text-lg font-semibold text-white">¿Sabes en qué gastan los parlamentarios?</p>
					<p class="mt-1 text-sm text-white/80">Oficina, personal de apoyo, pasajes — mes a mes, por cada diputado/a de la región.</p>
					<a
						href="/parlamentarios/gastos/"
						class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-topic-gasto shadow-sm hover:bg-white/90"
					>
						Revisa el gasto &rarr;
					</a>
				</div>

				<div class="rounded-2xl border border-topic-asistencia bg-topic-asistencia p-8 shadow-sm">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white/20 text-white">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.comparar} />
						</svg>
					</div>
					<p class="mt-4 text-lg font-semibold text-white">¿Diputado o senador — quién rinde más?</p>
					<p class="mt-1 text-sm text-white/80">Duelo cara a cara o tabla de hasta 3: asistencia, votaciones, alineamiento y mociones.</p>
					<a
						href="/parlamentarios/comparador/"
						class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-topic-asistencia shadow-sm hover:bg-white/90"
					>
						Compáralos &rarr;
					</a>
				</div>

				<div class="rounded-2xl border border-topic-discursos bg-topic-discursos p-8 shadow-sm">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white/20 text-white">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={ICONOS.discursos} />
						</svg>
					</div>
					<p class="mt-4 text-lg font-semibold text-white">¿Qué dicen realmente en la sala?</p>
					<p class="mt-1 text-sm text-white/80">{analisisIntervenciones.total_con_texto} discursos analizados: palabras más usadas, tendencia y red de coocurrencia.</p>
					<a
						href="/parlamentarios/discursos/"
						class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-topic-discursos shadow-sm hover:bg-white/90"
					>
						Léelos acá &rarr;
					</a>
				</div>
			</div>
		</section>

		<section class="border-t border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-6xl px-6 py-16">
				<h2 class="text-2xl font-bold tracking-tight text-slate-900">Explorar los datos</h2>
				<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{secciones.map((s) => (
						<a
							href={s.href}
							class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
						>
							<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
									<path d={ICONOS[s.icono]} />
								</svg>
							</div>
							<h3 class="mt-4 font-semibold text-slate-900 group-hover:text-brand-700">{s.titulo}</h3>
							<p class="mt-2 text-base leading-relaxed text-slate-600">{s.descripcion}</p>
							<span class="mt-4 inline-block text-sm font-semibold text-brand-600">Ver más &rarr;</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>

	<style>
		.radar-sweep {
			background: conic-gradient(from 0deg, transparent 0deg, rgba(245, 179, 179, 0.35) 18deg, transparent 60deg);
			animation: radar-spin 4s linear infinite;
		}
		@keyframes radar-spin {
			to { transform: rotate(360deg); }
		}
		.radar-blip {
			animation: radar-blip 4s ease-out infinite;
		}
		@keyframes radar-blip {
			0%, 92% { box-shadow: 0 0 0 0 rgba(245, 179, 179, 0.55); }
			4% { box-shadow: 0 0 0 6px rgba(245, 179, 179, 0); }
		}
		@media (prefers-reduced-motion: reduce) {
			.radar-sweep {
				animation: none;
				background: none;
			}
			.radar-blip {
				animation: none;
			}
		}
	</style>
</Layout>
