---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OPRC — Observatorio Político Región de Coquimbo">
	<main class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900">
			Observatorio Político Región de Coquimbo
		</h1>
		<p class="mt-4 text-slate-600">
			Sitio en construcción.
		</p>
		<div class="mt-6 flex gap-3">
			<a
				href="/autoridades/"
				class="inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
			>
				Ver autoridades
			</a>
			<a
				href="/votaciones/"
				class="inline-block rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-50"
			>
				Votaciones recientes
			</a>
		</div>
	</main>
</Layout>
