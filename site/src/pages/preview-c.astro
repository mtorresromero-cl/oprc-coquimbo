---
import '@fontsource-variable/manrope';
import Layout from '../layouts/Layout.astro';
import { autoridades, comunas, votaciones, presupuesto, personal } from '../lib/datos';

const comunasConDatos = comunas.filter(
	(c) => presupuesto.some((p) => p.comuna_id === c.id) || personal.some((p) => p.comuna_id === c.id)
).length;

const stats = [
	{ valor: autoridades.length, label: 'autoridades registradas' },
	{ valor: comunas.length, label: 'comunas de la región' },
	{ valor: comunasConDatos, label: 'con datos de transparencia' },
	{ valor: votaciones.length, label: 'votaciones registradas' },
];

const secciones = [
	{ titulo: 'Autoridades', descripcion: `${autoridades.length} alcaldes, concejales, core, diputados y senadores.`, href: '/autoridades/' },
	{ titulo: 'Municipios', descripcion: 'Presupuesto y personal de las 15 comunas.', href: '/municipios/' },
	{ titulo: 'Parlamentarios', descripcion: 'Votaciones y mociones legislativas.', href: '/parlamentarios/' },
];
---

<Layout title="Preview C — Civic-tech">
	<style>
		.manrope { font-family: 'Manrope Variable', sans-serif; }
		.dotted-bg {
			background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px);
			background-size: 20px 20px;
		}
	</style>
	<main class="manrope bg-white">
		<section class="dotted-bg border-b border-slate-100">
			<div class="mx-auto max-w-6xl px-6 py-24 text-center">
				<p class="text-sm font-bold tracking-widest text-brand-600 uppercase">
					Observatorio Político Región de Coquimbo
				</p>
				<h1 class="mx-auto mt-5 max-w-3xl text-5xl leading-tight font-extrabold tracking-tight text-slate-900">
					Seguimiento ciudadano de la política regional
				</h1>
				<p class="mx-auto mt-5 max-w-xl text-lg text-slate-600">
					Datos públicos sobre autoridades, parlamentarios y transparencia municipal, actualizados
					de forma automática desde fuentes oficiales.
				</p>
				<div class="mt-9 flex flex-wrap justify-center gap-3">
					<a href="/autoridades/" class="inline-block rounded-lg bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm shadow-brand-600/30 hover:bg-brand-700">
						Ver autoridades
					</a>
					<a href="/municipios/" class="inline-block rounded-lg border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-900 hover:border-slate-400">
						Ver municipios
					</a>
				</div>

				<dl class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
					{stats.map((s) => (
						<div class="rounded-xl border border-slate-100 bg-white/80 py-4 shadow-sm backdrop-blur">
							<dt class="text-3xl font-extrabold text-slate-900">{s.valor}</dt>
							<dd class="mt-1 text-xs font-medium text-slate-500">{s.label}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Explorar los datos</h2>
			<div class="mt-10 grid gap-5 sm:grid-cols-3">
				{secciones.map((s, i) => (
					<a href={s.href} class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-lg">
						<div class={`h-1.5 ${['bg-brand-600', 'bg-slate-800', 'bg-brand-400'][i]}`}></div>
						<div class="p-6">
							<h3 class="font-extrabold text-slate-900">{s.titulo}</h3>
							<p class="mt-2 text-sm text-slate-600">{s.descripcion}</p>
							<span class="mt-4 inline-block text-sm font-bold text-brand-600">Ver más →</span>
						</div>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>
