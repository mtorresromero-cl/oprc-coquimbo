---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Infografías — OPRC"
	description="Infografías del Observatorio Político Región de Coquimbo sobre elecciones, transparencia y participación política."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Infografías</p>
			</div>
			<h1 class="mt-4 max-w-xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Infografías
			</h1>
			<p class="mt-5 max-w-xl text-lg text-slate-300">
				Publicamos infografías con análisis de elecciones, transparencia municipal y participación
				política en <a href="https://instagram.com/oprcoquimbo" target="_blank" rel="noopener" class="text-brand-300 hover:underline">@oprcoquimbo</a>.
			</p>
			<a
				href="https://instagram.com/oprcoquimbo"
				target="_blank"
				rel="noopener"
				class="mt-6 inline-block rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500"
			>
				Ver en Instagram
			</a>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="sk-instagram-feed" data-embed-id="25709564"></div>
	</main>

	<script src="https://widgets.sociablekit.com/instagram-feed/widget.js" defer></script>
</Layout>
