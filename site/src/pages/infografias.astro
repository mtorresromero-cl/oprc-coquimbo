---
import Layout from '../layouts/Layout.astro';

// No hay feed sincronizado todavía: requiere credenciales de la API de
// Instagram (Meta Developer, cuenta Business) que solo el equipo de OPRC
// puede generar. Mientras tanto, se van agregando a mano las publicaciones
// reales de @oprcoquimbo con el embed oficial de Instagram — para sumar una
// nueva, solo hace falta el permalink (instagram.com/p/XXXXXXXXX/).
const POSTS_INSTAGRAM = ['https://www.instagram.com/p/DSS70mJjkNP/'];
---

<Layout
	title="Infografías — OPRC"
	description="Infografías del Observatorio Político Región de Coquimbo sobre elecciones, transparencia y participación política."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Infografías</p>
			</div>
			<h1 class="mt-4 max-w-xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Infografías
			</h1>
			<p class="mt-5 max-w-xl text-lg text-slate-300">
				Publicamos infografías con análisis de elecciones, transparencia municipal y participación
				política en <a href="https://instagram.com/oprcoquimbo" target="_blank" rel="noopener" class="text-brand-300 hover:underline">@oprcoquimbo</a>.
				El feed en vivo todavía no está sincronizado en el sitio — mientras tanto, vamos sumando acá
				algunas publicaciones. El resto está directamente en Instagram.
			</p>
			<a
				href="https://instagram.com/oprcoquimbo"
				target="_blank"
				rel="noopener"
				class="mt-6 inline-block rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500"
			>
				Ver en Instagram
			</a>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
			{POSTS_INSTAGRAM.map((url) => (
				<div class="mb-6 break-inside-avoid">
					<blockquote
						class="instagram-media"
						data-instgrm-permalink={`${url}?utm_source=ig_embed&utm_campaign=loading`}
						data-instgrm-version="14"
						style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:0 auto; max-width:540px; min-width:326px; padding:0; width:99%;"
					>
					</blockquote>
				</div>
			))}
		</div>
	</main>

	<script is:inline src="https://www.instagram.com/embed.js" async></script>
</Layout>
