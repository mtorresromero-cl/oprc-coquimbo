---
import Layout from '../../layouts/Layout.astro';
import {
	autoridades,
	comunas,
	CARGOS,
	CARGO_LABEL,
	GRUPO_LABEL,
	nombreComuna,
	composicionPartidoTodos,
	composicionPorGenero,
	composicionPorGeneroYCargo,
	autoridadesPorCargoProvincia,
} from '../../lib/datos';
import TarjetaAutoridad from '../../components/TarjetaAutoridad.astro';

const partidos = [...new Set(autoridades.map((a) => a.partido).filter(Boolean))].sort() as string[];

const composicionPartido = composicionPartidoTodos();
const totalAutoridadesConPartido = composicionPartido.reduce((s, p) => s + p.total, 0);
const maxPartido = Math.max(...composicionPartido.map((p) => p.total), 1);

const composicionGenero = composicionPorGenero();
const totalConGenero = composicionGenero.reduce((s, g) => s + g.total, 0);
const maxGenero = Math.max(...composicionGenero.map((g) => g.total), 1);

const generoPorCargo = composicionPorGeneroYCargo();
const maxGeneroPorCargo = Math.max(...generoPorCargo.flatMap((c) => [c.hombres, c.mujeres]), 1);

const cargoProvincia = autoridadesPorCargoProvincia();

// Orden geográfico real de las comunas (provincias de Elqui, Limarí y
// Choapa, de norte a sur), usado para alcaldes y concejales.
const COMUNA_ORDEN = [
	'la-higuera', 'la-serena', 'coquimbo', 'vicuna', 'paihuano', 'andacollo',
	'rio-hurtado', 'monte-patria', 'ovalle', 'punitaqui', 'combarbala',
	'canela', 'illapel', 'salamanca', 'los-vilos',
];
const ORDEN_COMUNA_IDX = Object.fromEntries(COMUNA_ORDEN.map((id, i) => [id, i]));
const ordenComuna = (a: (typeof autoridades)[number]) => (a.comuna ? (ORDEN_COMUNA_IDX[a.comuna] ?? 99) : 99);

const grupos = CARGOS.map((cargo) => {
	const porComuna = cargo === 'alcalde' || cargo === 'concejal';
	const items = autoridades
		.filter((a) => a.cargo === cargo)
		.sort((a, b) => {
			if (!porComuna) return a.nombre_completo.localeCompare(b.nombre_completo);
			const diff = ordenComuna(a) - ordenComuna(b);
			return diff !== 0 ? diff : a.nombre_completo.localeCompare(b.nombre_completo);
		});

	let subgrupos: { comunaId: string; nombre: string; items: typeof items }[] | null = null;
	if (cargo === 'concejal') {
		const mapa = new Map<string, typeof items>();
		for (const a of items) {
			const key = a.comuna ?? '';
			if (!mapa.has(key)) mapa.set(key, []);
			mapa.get(key)!.push(a);
		}
		subgrupos = [...mapa.entries()].map(([comunaId, its]) => ({
			comunaId,
			nombre: nombreComuna(comunaId) ?? 'Sin comuna',
			items: its,
		}));
	}

	return { cargo, label: GRUPO_LABEL[cargo] ?? cargo, items, subgrupos };
}).filter((g) => g.items.length > 0);

---

<Layout title="Autoridades — OPRC" description="Alcaldes, concejales, consejeros regionales, diputados y senadores de la Región de Coquimbo.">
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">Autoridades</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Listado de {autoridades.length} autoridades políticas de la Región de Coquimbo.
			</p>
		</div>
	</section>

	<section class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">
				Composición por partido — todas las autoridades
			</h2>
			<p class="mt-2 max-w-2xl text-base text-slate-600">
				Las {totalAutoridadesConPartido} autoridades de la Región de Coquimbo con partido
				declarado: alcaldes, concejales, consejeros regionales, el gobernador, diputados y
				senadores.
			</p>
			<div class="mt-8 space-y-3">
				{composicionPartido.map((p) => (
					<div class="flex items-center gap-4">
						<span class="w-56 shrink-0 truncate text-sm font-medium text-slate-700">{p.partido}</span>
						<div class="h-6 flex-1 rounded bg-slate-200">
							<div class="h-6 rounded bg-brand-600" style={`width:${(p.total / maxPartido) * 100}%`}></div>
						</div>
						<span class="w-6 shrink-0 text-right text-sm font-semibold text-slate-900">{p.total}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
				<div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900">Autoridades por provincia</h2>
					<p class="mt-2 text-base text-slate-600">
						Alcaldes y concejales según la provincia de su comuna; consejeros regionales según su
						circunscripción provincial. No incluye senadores, diputados ni al gobernador, que
						representan a toda la región y no a una provincia en particular.
					</p>
					<div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
						<table class="w-full text-sm">
							<thead class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
								<tr>
									<th class="px-4 py-3">Provincia</th>
									<th class="px-4 py-3 text-right">Alcaldes</th>
									<th class="px-4 py-3 text-right">Concejales</th>
									<th class="px-4 py-3 text-right">Consejeros regionales</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100 bg-white">
								{cargoProvincia.map((p) => (
									<tr>
										<td class="px-4 py-3 font-medium text-slate-900">{p.provincia}</td>
										<td class="px-4 py-3 text-right text-slate-700">{p.alcalde}</td>
										<td class="px-4 py-3 text-right text-slate-700">{p.concejal}</td>
										<td class="px-4 py-3 text-right text-slate-700">{p.core}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900">Composición por género</h2>
					<p class="mt-2 text-base text-slate-600">
						Estimación a partir del nombre de cada una de las {totalConGenero} autoridades. No es un
						dato publicado por las fuentes oficiales (SERVEL, BCN, Portal de Transparencia), que no
						registran sexo o género.
					</p>
					<div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="space-y-3">
							{composicionGenero.map((g) => (
								<div class="flex items-center gap-4">
									<span class="w-16 shrink-0 text-sm font-medium text-slate-700">{g.label}</span>
									<div class="h-6 flex-1 rounded bg-slate-200">
										<div class="h-6 rounded bg-brand-600" style={`width:${(g.total / maxGenero) * 100}%`}></div>
									</div>
									<span class="w-24 shrink-0 text-right text-sm font-semibold text-slate-900">
										{g.total} <span class="font-normal text-slate-500">({Math.round((g.total / totalConGenero) * 100)}%)</span>
									</span>
								</div>
							))}
						</div>
					</div>

					<h2 class="mt-12 text-2xl font-bold tracking-tight text-slate-900">Género por cargo</h2>
					<p class="mt-2 text-base text-slate-600">La misma estimación, desglosada por tipo de cargo.</p>
					<div class="mt-8 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
						<div class="mb-4 flex items-center justify-center gap-8 text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-slate-600"></span>Hombres</span>
							<span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-brand-600"></span>Mujeres</span>
						</div>
						<div class="space-y-2.5">
							{generoPorCargo.map((c) => (
								<div class="flex items-center gap-1 sm:gap-2">
									<span class="w-12 shrink-0 text-right text-[10px] font-medium text-slate-600 sm:w-20 sm:text-xs">
										{c.hombres} <span class="text-slate-400">({Math.round(c.hombresPct)}%)</span>
									</span>
									<div class="flex h-4 flex-1 justify-end">
										<div class="h-4 rounded-l bg-slate-600" style={`width:${(c.hombres / maxGeneroPorCargo) * 100}%`}></div>
									</div>
									<span class="w-16 shrink-0 text-center text-[10px] font-semibold text-slate-900 sm:w-28 sm:text-xs">{c.label}</span>
									<div class="flex h-4 flex-1 justify-start">
										<div class="h-4 rounded-r bg-brand-600" style={`width:${(c.mujeres / maxGeneroPorCargo) * 100}%`}></div>
									</div>
									<span class="w-12 shrink-0 text-[10px] font-medium text-slate-600 sm:w-20 sm:text-xs">
										{c.mujeres} <span class="text-slate-400">({Math.round(c.mujeresPct)}%)</span>
									</span>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap gap-3">
			<select id="filtro-cargo" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
				<option value="">Todos los cargos</option>
				{CARGOS.map((c) => <option value={c}>{CARGO_LABEL[c]}</option>)}
			</select>
			<select id="filtro-comuna" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
				<option value="">Todas las comunas</option>
				{comunas.map((c) => <option value={c.id}>{c.nombre}</option>)}
			</select>
			<select id="filtro-partido" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
				<option value="">Todos los partidos</option>
				{partidos.map((p) => <option value={p}>{p}</option>)}
			</select>
			<span id="contador" class="self-center text-sm text-slate-500"></span>
		</div>

		<div id="grupos-autoridades" class="mt-10 space-y-12">
			{grupos.map((g) => (
				<section class="grupo-cargo" data-grupo-cargo={g.cargo}>
					<h2 class="text-lg font-bold tracking-tight text-slate-900">
						{g.label} <span class="font-normal text-slate-400">({g.items.length})</span>
					</h2>

					{g.subgrupos ? (
						<div class="mt-6 space-y-8">
							{g.subgrupos.map((sg) => (
								<div class="subgrupo-comuna" data-subgrupo-comuna={sg.comunaId}>
									<h3 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">
										{sg.nombre} <span class="font-normal text-slate-400">({sg.items.length})</span>
									</h3>
									<ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
										{sg.items.map((a) => <TarjetaAutoridad autoridad={a} />)}
									</ul>
								</div>
							))}
						</div>
					) : (
						<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{g.items.map((a) => <TarjetaAutoridad autoridad={a} />)}
						</ul>
					)}
				</section>
			))}
		</div>

		<p id="sin-resultados" class="mt-8 hidden text-sm text-slate-500">
			No hay autoridades que coincidan con los filtros seleccionados.
		</p>
	</main>

	<script>
		const filtroCargo = document.getElementById('filtro-cargo') as HTMLSelectElement;
		const filtroComuna = document.getElementById('filtro-comuna') as HTMLSelectElement;
		const filtroPartido = document.getElementById('filtro-partido') as HTMLSelectElement;
		const filas = Array.from(document.querySelectorAll<HTMLLIElement>('.fila-autoridad'));
		const grupoSecciones = Array.from(document.querySelectorAll<HTMLElement>('.grupo-cargo'));
		const subgrupoSecciones = Array.from(document.querySelectorAll<HTMLElement>('.subgrupo-comuna'));
		const contador = document.getElementById('contador')!;
		const sinResultados = document.getElementById('sin-resultados')!;

		function aplicarFiltros() {
			const cargo = filtroCargo.value;
			const comuna = filtroComuna.value;
			const partido = filtroPartido.value;
			let visibles = 0;

			for (const fila of filas) {
				const coincide =
					(!cargo || fila.dataset.cargo === cargo) &&
					(!comuna || fila.dataset.comuna === comuna) &&
					(!partido || fila.dataset.partido === partido);
				fila.classList.toggle('hidden', !coincide);
				if (coincide) visibles++;
			}

			for (const seccion of subgrupoSecciones) {
				const tieneVisibles = seccion.querySelectorAll('.fila-autoridad:not(.hidden)').length > 0;
				seccion.classList.toggle('hidden', !tieneVisibles);
			}

			for (const seccion of grupoSecciones) {
				const tieneVisibles = seccion.querySelectorAll('.fila-autoridad:not(.hidden)').length > 0;
				seccion.classList.toggle('hidden', !tieneVisibles);
			}

			contador.textContent = `${visibles} de ${filas.length}`;
			sinResultados.classList.toggle('hidden', visibles !== 0);
		}

		filtroCargo.addEventListener('change', aplicarFiltros);
		filtroComuna.addEventListener('change', aplicarFiltros);
		filtroPartido.addEventListener('change', aplicarFiltros);
		aplicarFiltros();
	</script>
</Layout>
