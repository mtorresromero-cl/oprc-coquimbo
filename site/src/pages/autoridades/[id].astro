---
import Layout from '../../layouts/Layout.astro';
import {
	autoridades,
	cargoDeAutoridad,
	nombreComuna,
	votacionesDeAutoridad,
	VOTO_LABEL,
	mocionesDeAutoridad,
	presupuestoDeComuna,
	declaracionPatrimonioDeAutoridad,
	asistenciaResumenDeAutoridad,
	etiquetaPeriodoAsistencia,
	fotoAutoridad,
	gastoParlamentario,
	CATEGORIA_GASTO,
	nombreMes,
	analisisIntervenciones,
	nombrePartido,
} from '../../lib/datos';

export function getStaticPaths() {
	return autoridades.map((a) => ({
		params: { id: a.id },
		props: { autoridad: a },
	}));
}

const { autoridad } = Astro.props;
const historialVotos = votacionesDeAutoridad(autoridad.id);
const historialMociones = mocionesDeAutoridad(autoridad.id);
const tienePresupuesto = autoridad.comuna ? presupuestoDeComuna(autoridad.comuna).length > 0 : false;
const patrimonio = declaracionPatrimonioDeAutoridad(autoridad.id);
const resumenAsistencia = asistenciaResumenDeAutoridad(autoridad.id);
const foto = fotoAutoridad(autoridad.id);

const asistenciaPct = resumenAsistencia
	? Math.min(100, Math.round((resumenAsistencia.asistencias / resumenAsistencia.sesiones_computables) * 1000) / 10)
	: null;

const CATEGORIAS_GASTO_ORDEN = ['gastos_operacionales', 'personal_apoyo', 'pasajes_aereos', 'asesorias_externas'] as const;

interface DetalleGasto { concepto?: string; monto?: number; nombre?: string; cargo?: string; renta?: number }

const gastoResumen =
	autoridad.cargo === 'diputado'
		? CATEGORIAS_GASTO_ORDEN.map((categoria) => {
				const config = CATEGORIA_GASTO[categoria];
				const registros = gastoParlamentario
					.filter((g) => g.autoridad_id === autoridad.id && g.categoria === categoria)
					.sort((a, b) => b.mes - a.mes);
				// gastos_operacionales en particular puede marcar "publicado" un
				// mes sin items reales (mensaje "sin registros" de camara.cl que
				// suele ser el mes aún no cargado, no un gasto real de cero) —
				// para el resumen del perfil se prefiere el último mes con
				// detalle real antes que ese caso ambiguo. Para las otras
				// categorías un "sin items" real (ej. 0 vuelos) sí es un dato
				// válido y se muestra tal cual, sin este ajuste.
				const publicado =
					categoria === 'gastos_operacionales'
						? (registros.find((r) => r.publicado && (r.monto ?? 0) > 0) ??
							registros.find((r) => r.publicado))
						: registros.find((r) => r.publicado);
				const detalle: DetalleGasto[] = publicado?.detalle ? JSON.parse(publicado.detalle) : [];
				return {
					categoria,
					label: config.label,
					unidad: config.unidad,
					mes: publicado?.mes ?? null,
					valor: publicado ? (publicado[config.campo] ?? null) : null,
					detalle,
					publicado: !!publicado,
				};
			})
		: [];
const hayGastoPublicado = gastoResumen.some((g) => g.publicado);
const itemsGastosOperacionales = gastoResumen
	.find((g) => g.categoria === 'gastos_operacionales')
	?.detalle.filter((d) => (d.monto ?? 0) > 0)
	.sort((a, b) => (b.monto ?? 0) - (a.monto ?? 0))
	.slice(0, 6) ?? [];

const intervencionResumen = analisisIntervenciones.participacion[autoridad.id];
const hayIntervenciones = !!intervencionResumen && intervencionResumen.con_texto > 0;
const topPalabrasAutoridad = hayIntervenciones
	? (analisisIntervenciones.top_palabras_por_autoridad[autoridad.id] ?? []).slice(0, 10)
	: [];

function formatoDuracion(segundos: number) {
	const min = Math.floor(segundos / 60);
	const seg = segundos % 60;
	return `${min}:${String(seg).padStart(2, '0')}`;
}

// aro del donut de asistencia: circunferencia de un círculo r=54
const AROS_CIRCUNFERENCIA = 2 * Math.PI * 54;
const aroRelleno = asistenciaPct !== null ? (asistenciaPct / 100) * AROS_CIRCUNFERENCIA : 0;

function iniciales(nombre: string) {
	const partes = nombre.split(' ').filter(Boolean);
	return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
}

function colorVoto(voto: string) {
	if (voto === 'favor') return 'text-emerald-600';
	if (voto === 'contra') return 'text-red-600';
	return 'text-slate-700';
}

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}

// un color e ícono fijo por tema — mismo sistema del comparador, para que
// el perfil y el comparador se lean como parte de un mismo lenguaje visual
const TEMA = {
	patrimonio: { color: 'var(--color-topic-patrimonio)', icono: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6' },
	asistencia: { color: 'var(--color-topic-asistencia)', icono: 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
	mociones: { color: 'var(--color-topic-mociones)', icono: 'M14 3v5a2 2 0 0 0 2 2h5M6 3h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z' },
	votaciones: { color: 'var(--color-topic-votaciones)', icono: 'm9 12 2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
	gasto: { color: 'var(--color-topic-gasto)', icono: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' },
	discursos: { color: 'var(--color-topic-discursos)', icono: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z' },
};

---

<Layout title={`${autoridad.nombre_completo} — OPRC`}>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-16">
			<a href="/autoridades/" class="text-sm font-medium text-slate-300 hover:text-white">&larr; Autoridades</a>
			<div class="mt-4 flex items-center gap-5">
				{foto ? (
					<img src={foto} alt={autoridad.nombre_completo} class="h-20 w-20 shrink-0 rounded-full border-2 border-white/80 object-cover shadow-sm" />
				) : (
					<span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-2 border-white/80 bg-brand-600 text-2xl font-bold text-white shadow-sm">
						{iniciales(autoridad.nombre_completo)}
					</span>
				)}
				<div class="min-w-0">
					<h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{autoridad.nombre_completo}</h1>
					<p class="mt-1 text-lg text-slate-300">{cargoDeAutoridad(autoridad)}</p>
				</div>
			</div>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="grid grid-cols-1 gap-10 lg:grid-cols-[18rem_1fr]">
			<aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<dl class="space-y-3 text-sm">
						{autoridad.partido && (
							<div>
								<dt class="text-slate-500">Partido</dt>
								<dd class="font-medium text-slate-900">{nombrePartido(autoridad.partido)}</dd>
							</div>
						)}
						{autoridad.pacto && (
							<div>
								<dt class="text-slate-500">Pacto electoral</dt>
								<dd class="font-medium text-slate-900">{autoridad.pacto}</dd>
							</div>
						)}
						{autoridad.comuna && (
							<div>
								<dt class="text-slate-500">Comuna</dt>
								<dd class="font-medium text-slate-900">
									{tienePresupuesto ? (
										<a href={`/municipios/${autoridad.comuna}/`} class="text-brand-600 hover:underline">
											{nombreComuna(autoridad.comuna)} — ver presupuesto
										</a>
									) : (
										nombreComuna(autoridad.comuna)
									)}
								</dd>
							</div>
						)}
						{autoridad.distrito && (
							<div>
								<dt class="text-slate-500">Distrito</dt>
								<dd class="font-medium text-slate-900">{autoridad.distrito}</dd>
							</div>
						)}
						{autoridad.circunscripcion && (
							<div>
								<dt class="text-slate-500">Circunscripción</dt>
								<dd class="font-medium text-slate-900">{autoridad.circunscripcion}</dd>
							</div>
						)}
						{(autoridad.periodo_inicio || autoridad.periodo_fin) && (
							<div>
								<dt class="text-slate-500">Período</dt>
								<dd class="font-medium text-slate-900">
									{autoridad.periodo_inicio ?? '?'} – {autoridad.periodo_fin ?? '?'}
								</dd>
							</div>
						)}
						{autoridad.email && (
							<div>
								<dt class="text-slate-500">Contacto</dt>
								<dd class="font-medium text-slate-900">
									<a href={`mailto:${autoridad.email}`} class="text-brand-600 hover:underline">{autoridad.email}</a>
								</dd>
							</div>
						)}
					</dl>
				</div>

				{autoridad.fuente && (
					<p class="break-all text-xs text-slate-400">
						Fuente: <a href={autoridad.fuente} class="hover:text-brand-600 hover:underline" target="_blank" rel="noopener">
							{autoridad.fuente}
						</a>
					</p>
				)}

				{(patrimonio || resumenAsistencia || historialMociones.length > 0 || historialVotos.length > 0 || hayGastoPublicado || hayIntervenciones) && (
					<nav class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
						<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">En esta página</p>
						<ul class="mt-3 space-y-2">
							{patrimonio && (
								<li><a href="#patrimonio" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.patrimonio.color}`}></span>Declaración de patrimonio e intereses</a></li>
							)}
							{resumenAsistencia && (
								<li><a href="#asistencia" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.asistencia.color}`}></span>Asistencia a sala</a></li>
							)}
							{hayGastoPublicado && (
								<li><a href="#gasto" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.gasto.color}`}></span>Gasto parlamentario</a></li>
							)}
							{hayIntervenciones && (
								<li><a href="#discursos" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.discursos.color}`}></span>Intervenciones en sala</a></li>
							)}
							{historialMociones.length > 0 && (
								<li><a href="#mociones" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.mociones.color}`}></span>Mociones presentadas ({historialMociones.length})</a></li>
							)}
							{historialVotos.length > 0 && (
								<li><a href="#votaciones" class="flex items-center gap-2 text-brand-600 hover:underline"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${TEMA.votaciones.color}`}></span>Historial de votaciones</a></li>
							)}
						</ul>
					</nav>
				)}
			</aside>

			<div>
				{patrimonio && (
					<section id="patrimonio" class="scroll-mt-24">
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.patrimonio.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.patrimonio.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.patrimonio.icono}></path></svg>
							</span>
							Declaración de patrimonio e intereses
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Resumen de la declaración vigente ({patrimonio.tipo_declaracion}, {patrimonio.fecha_declaracion}),
							como {patrimonio.cargo_declarado} de {patrimonio.organismo}. Vía infoprobidad.cl (Consejo para
							la Transparencia / Contraloría General de la República).
						</p>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.patrimonio.color}`}>
								<p class="text-xs text-slate-500">Bienes inmuebles</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.bienes_inmuebles_n}</p>
							</div>
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.patrimonio.color}`}>
								<p class="text-xs text-slate-500">Vehículos</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.vehiculos_n}</p>
							</div>
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.patrimonio.color}`}>
								<p class="text-xs text-slate-500">Sociedades</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.sociedades_n}</p>
							</div>
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.patrimonio.color}`}>
								<p class="text-xs text-slate-500">Pasivos declarados</p>
								<p class="mt-1 text-xl font-bold text-slate-900">
									{patrimonio.pasivos_tiene ? formatoCLP(patrimonio.pasivos_monto) : 'No declara'}
								</p>
							</div>
						</div>
						{patrimonio.valores_monto > 0 && (
							<p class="mt-3 text-base text-slate-600">
								Valores e instrumentos transables declarados: <span class="font-semibold text-slate-900">{formatoCLP(patrimonio.valores_monto)}</span>
							</p>
						)}
						<a href={patrimonio.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
							Ver declaración completa en infoprobidad.cl
						</a>
					</section>
				)}

				{resumenAsistencia && (
					<section id="asistencia" class={`scroll-mt-24 ${patrimonio ? 'mt-10' : ''}`}>
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.asistencia.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.asistencia.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.asistencia.icono}></path></svg>
							</span>
							Asistencia a sala ({etiquetaPeriodoAsistencia(resumenAsistencia)})
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Resumen del período tal como lo calcula la fuente oficial ({resumenAsistencia.camara === 'senado' ? 'senado.cl' : 'camara.cl'}).
							{resumenAsistencia.asistencias > resumenAsistencia.sesiones_computables && (
								<span class="block text-amber-600">
									La fuente reporta más asistencias que sesiones computables — se muestra igual, tal cual la
									publica.
								</span>
							)}
						</p>
						<div class="mt-4 flex flex-col gap-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center">
							{asistenciaPct !== null && (
								<div class="relative h-32 w-32 shrink-0 self-center">
									<svg viewBox="0 0 120 120" class="h-32 w-32 -rotate-90">
										<circle cx="60" cy="60" r="54" fill="none" stroke="#f1f5f9" stroke-width="12" />
										<circle
											cx="60"
											cy="60"
											r="54"
											fill="none"
											stroke={TEMA.asistencia.color}
											stroke-width="12"
											stroke-linecap="round"
											stroke-dasharray={`${aroRelleno} ${AROS_CIRCUNFERENCIA}`}
										/>
									</svg>
									<div class="absolute inset-0 flex flex-col items-center justify-center">
										<span class="text-2xl font-bold text-slate-900">{asistenciaPct}%</span>
										<span class="text-[10px] text-slate-500">asistencia</span>
									</div>
								</div>
							)}
							<div class="grid flex-1 grid-cols-2 gap-3">
								<div class="rounded-lg bg-slate-50 p-3">
									<p class="text-xs text-slate-500">Asistencias</p>
									<p class="mt-1 text-xl font-bold text-slate-900">
										{resumenAsistencia.asistencias} / {resumenAsistencia.sesiones_computables}
									</p>
								</div>
								<div class="rounded-lg bg-slate-50 p-3">
									<p class="text-xs text-slate-500">Total sesiones del período</p>
									<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.total_sesiones}</p>
								</div>
								<div class="rounded-lg bg-slate-50 p-3">
									<p class="text-xs text-slate-500">Ausencias justificadas</p>
									<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.ausencias_justificadas}</p>
								</div>
								<div class="rounded-lg bg-slate-50 p-3">
									<p class="text-xs text-slate-500">Ausencias sin justificar</p>
									<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.ausencias_sin_justificar}</p>
								</div>
							</div>
						</div>
						<a href={resumenAsistencia.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
							Ver fuente completa
						</a>
					</section>
				)}

				{hayGastoPublicado && (
					<section id="gasto" class={`scroll-mt-24 ${patrimonio || resumenAsistencia ? 'mt-10' : ''}`}>
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.gasto.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.gasto.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.gasto.icono}></path></svg>
							</span>
							Gasto parlamentario
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Último mes publicado por categoría, según camara.cl. Historial completo mes a mes en{' '}
							<a href="/parlamentarios/gastos/" class="text-brand-600 hover:underline">la matriz de gasto parlamentario</a>.
						</p>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							{gastoResumen.map((g) => (
								<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.gasto.color}`}>
									<p class="text-xs text-slate-500">{g.label}</p>
									<p class="mt-1 text-xl font-bold text-slate-900">
										{g.publicado
											? g.unidad === '$'
												? formatoCLP(g.valor ?? 0)
												: `${g.valor ?? 0} ${g.unidad}`
											: 'Sin publicar'}
									</p>
									{g.mes && <p class="mt-0.5 text-xs text-slate-400">{nombreMes(g.mes)} 2026</p>}
								</div>
							))}
						</div>

						{itemsGastosOperacionales.length > 0 && (
							<div class="mt-4">
								<p class="text-sm font-semibold text-slate-700">Detalle de gastos operacionales</p>
								<ul class="mt-2 space-y-2">
									{itemsGastosOperacionales.map((item) => (
										<li
											class="flex items-center justify-between rounded-lg border border-l-4 border-slate-200 bg-white px-4 py-2.5 text-sm shadow-sm"
											style={`border-left-color:${TEMA.gasto.color}`}
										>
											<span class="text-slate-700">{item.concepto}</span>
											<span class="font-semibold text-slate-900 tabular-nums">{formatoCLP(item.monto ?? 0)}</span>
										</li>
									))}
								</ul>
							</div>
						)}

						<a href="/parlamentarios/gastos/#personal-apoyo" class="mt-4 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
							Ver el equipo de personal de apoyo y su red →
						</a>
					</section>
				)}

				{hayIntervenciones && (
					<section id="discursos" class={`scroll-mt-24 ${patrimonio || resumenAsistencia || hayGastoPublicado ? 'mt-10' : ''}`}>
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.discursos.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.discursos.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.discursos.icono}></path></svg>
							</span>
							Intervenciones en sala
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Análisis de texto de sus discursos en sala, vía el boletín de sesiones de camara.cl.
							Detalle completo en{' '}
							<a href="/parlamentarios/discursos/" class="text-brand-600 hover:underline">intervenciones en sala</a>.
						</p>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.discursos.color}`}>
								<p class="text-xs text-slate-500">Tiempo hablado</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{formatoDuracion(intervencionResumen.segundos)}</p>
							</div>
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.discursos.color}`}>
								<p class="text-xs text-slate-500">Intervenciones</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{intervencionResumen.intervenciones}</p>
							</div>
							<div class="rounded-xl border border-t-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-top-color:${TEMA.discursos.color}`}>
								<p class="text-xs text-slate-500">Con texto extraído</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{intervencionResumen.con_texto}</p>
							</div>
						</div>

						{topPalabrasAutoridad.length > 0 && (
							<div class="mt-4">
								<p class="text-sm font-semibold text-slate-700">Palabras más usadas</p>
								<div class="mt-2 flex flex-wrap gap-2">
									{topPalabrasAutoridad.map((p) => (
										<span
											class="rounded-full border border-l-4 bg-white px-3 py-1 text-xs text-slate-700 shadow-sm"
											style={`border-color:#e2e8f0;border-left-color:${TEMA.discursos.color}`}
										>
											{p.palabra} <span class="text-slate-400">({p.n})</span>
										</span>
									))}
								</div>
							</div>
						)}
					</section>
				)}

				{historialMociones.length > 0 && (
					<section id="mociones" class={`scroll-mt-24 ${patrimonio || resumenAsistencia || hayGastoPublicado || hayIntervenciones ? 'mt-10' : ''}`}>
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.mociones.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.mociones.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.mociones.icono}></path></svg>
							</span>
							Mociones presentadas ({historialMociones.length})
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Como autor o coautor este año, vía {autoridad.cargo === 'senador' ? 'el buscador de tramitación del Senado' : 'la ficha del diputado/a en camara.cl'}.
						</p>
						<ul class="mt-4 space-y-3">
							{historialMociones.map((m) => (
								<li class="rounded-xl border border-l-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-left-color:${TEMA.mociones.color}`}>
									<div class="flex items-center justify-between text-xs text-slate-500">
										<span>{m.fecha}</span>
										<span>Boletín {m.boletin}</span>
									</div>
									<p class="mt-2 text-base text-slate-800">
										<a href={m.url_bcn} target="_blank" rel="noopener" class="hover:text-brand-600 hover:underline">
											{m.titulo}
										</a>
									</p>
								</li>
							))}
						</ul>
					</section>
				)}

				{historialVotos.length > 0 && (
					<section id="votaciones" class={`scroll-mt-24 ${patrimonio || resumenAsistencia || hayGastoPublicado || hayIntervenciones || historialMociones.length > 0 ? 'mt-10' : ''}`}>
						<h2 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" style={`background:color-mix(in srgb, ${TEMA.votaciones.color} 14%, white)`}>
								<svg viewBox="0 0 24 24" fill="none" stroke={TEMA.votaciones.color} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d={TEMA.votaciones.icono}></path></svg>
							</span>
							Historial de votaciones
						</h2>
						{autoridad.cargo === 'diputado' && (
							<p class="mt-1 text-xs text-slate-500">Vía camara.cl.</p>
						)}
						<ul class="mt-4 space-y-3">
							{historialVotos.map(({ sesion, voto }) => (
								<li class="rounded-xl border border-l-4 border-slate-200 bg-white p-4 shadow-sm" style={`border-left-color:${TEMA.votaciones.color}`}>
									<div class="flex items-center justify-between text-xs text-slate-500">
										<span>{sesion.fecha}</span>
										<span class={`font-medium ${colorVoto(voto!.voto)}`}>
											{VOTO_LABEL[voto!.voto] ?? voto!.voto}
										</span>
									</div>
									<p class="mt-2 text-base text-slate-800">{sesion.descripcion}</p>
								</li>
							))}
						</ul>
					</section>
				)}

				{!patrimonio &&
					historialVotos.length === 0 &&
					historialMociones.length === 0 &&
					!resumenAsistencia &&
					!hayGastoPublicado &&
					!hayIntervenciones && (
						<p class="text-sm text-slate-500">
							Todavía no hay votaciones ni mociones registradas para esta autoridad.
						</p>
					)}
			</div>
		</div>
	</main>
</Layout>
