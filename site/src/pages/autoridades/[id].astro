---
import Layout from '../../layouts/Layout.astro';
import {
	autoridades,
	CARGO_LABEL,
	nombreComuna,
	votacionesDeAutoridad,
	VOTO_LABEL,
	mocionesDeAutoridad,
	presupuestoDeComuna,
	declaracionPatrimonioDeAutoridad,
	asistenciaResumenDeAutoridad,
	etiquetaPeriodoAsistencia,
} from '../../lib/datos';

export function getStaticPaths() {
	return autoridades.map((a) => ({
		params: { id: a.id },
		props: { autoridad: a },
	}));
}

const { autoridad } = Astro.props;
const historialVotos = votacionesDeAutoridad(autoridad.id);
const historialMociones = mocionesDeAutoridad(autoridad.id);
const tienePresupuesto = autoridad.comuna ? presupuestoDeComuna(autoridad.comuna).length > 0 : false;
const patrimonio = declaracionPatrimonioDeAutoridad(autoridad.id);
const resumenAsistencia = asistenciaResumenDeAutoridad(autoridad.id);

function iniciales(nombre: string) {
	const partes = nombre.split(' ').filter(Boolean);
	return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
}

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}
---

<Layout title={`${autoridad.nombre_completo} — OPRC`}>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<a href="/autoridades/" class="text-sm font-medium text-slate-500 hover:text-brand-600">&larr; Autoridades</a>
			<div class="mt-4 flex items-center gap-4">
				<span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-600 text-xl font-bold text-white">
					{iniciales(autoridad.nombre_completo)}
				</span>
				<div>
					<h1 class="text-3xl font-bold tracking-tight text-slate-900">{autoridad.nombre_completo}</h1>
					<p class="mt-1 text-lg text-slate-600">{CARGO_LABEL[autoridad.cargo] ?? autoridad.cargo}</p>
				</div>
			</div>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="grid gap-10 lg:grid-cols-[18rem_1fr]">
			<aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<dl class="space-y-3 text-sm">
						{autoridad.partido && (
							<div>
								<dt class="text-slate-500">Partido</dt>
								<dd class="font-medium text-slate-900">{autoridad.partido}</dd>
							</div>
						)}
						{autoridad.pacto && (
							<div>
								<dt class="text-slate-500">Pacto electoral</dt>
								<dd class="font-medium text-slate-900">{autoridad.pacto}</dd>
							</div>
						)}
						{autoridad.comuna && (
							<div>
								<dt class="text-slate-500">Comuna</dt>
								<dd class="font-medium text-slate-900">
									{tienePresupuesto ? (
										<a href={`/municipios/${autoridad.comuna}/`} class="text-brand-600 hover:underline">
											{nombreComuna(autoridad.comuna)} — ver presupuesto
										</a>
									) : (
										nombreComuna(autoridad.comuna)
									)}
								</dd>
							</div>
						)}
						{autoridad.distrito && (
							<div>
								<dt class="text-slate-500">Distrito</dt>
								<dd class="font-medium text-slate-900">{autoridad.distrito}</dd>
							</div>
						)}
						{autoridad.circunscripcion && (
							<div>
								<dt class="text-slate-500">Circunscripción</dt>
								<dd class="font-medium text-slate-900">{autoridad.circunscripcion}</dd>
							</div>
						)}
						{(autoridad.periodo_inicio || autoridad.periodo_fin) && (
							<div>
								<dt class="text-slate-500">Período</dt>
								<dd class="font-medium text-slate-900">
									{autoridad.periodo_inicio ?? '?'} – {autoridad.periodo_fin ?? '?'}
								</dd>
							</div>
						)}
						{autoridad.email && (
							<div>
								<dt class="text-slate-500">Contacto</dt>
								<dd class="font-medium text-slate-900">
									<a href={`mailto:${autoridad.email}`} class="text-brand-600 hover:underline">{autoridad.email}</a>
								</dd>
							</div>
						)}
					</dl>
				</div>

				{autoridad.fuente && (
					<p class="text-xs text-slate-400">
						Fuente: <a href={autoridad.fuente} class="hover:text-brand-600 hover:underline" target="_blank" rel="noopener">
							{autoridad.fuente}
						</a>
					</p>
				)}
			</aside>

			<div>
				{patrimonio && (
					<section>
						<h2 class="text-lg font-semibold text-slate-900">Declaración de patrimonio e intereses</h2>
						<p class="mt-1 text-xs text-slate-500">
							Resumen de la declaración vigente ({patrimonio.tipo_declaracion}, {patrimonio.fecha_declaracion}),
							como {patrimonio.cargo_declarado} de {patrimonio.organismo}. Vía infoprobidad.cl (Consejo para
							la Transparencia / Contraloría General de la República).
						</p>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Bienes inmuebles</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.bienes_inmuebles_n}</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Vehículos</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.vehiculos_n}</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Sociedades</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{patrimonio.sociedades_n}</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Pasivos declarados</p>
								<p class="mt-1 text-xl font-bold text-slate-900">
									{patrimonio.pasivos_tiene ? formatoCLP(patrimonio.pasivos_monto) : 'No declara'}
								</p>
							</div>
						</div>
						{patrimonio.valores_monto > 0 && (
							<p class="mt-3 text-sm text-slate-600">
								Valores e instrumentos transables declarados: <span class="font-semibold text-slate-900">{formatoCLP(patrimonio.valores_monto)}</span>
							</p>
						)}
						<a href={patrimonio.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
							Ver declaración completa en infoprobidad.cl
						</a>
					</section>
				)}

				{historialVotos.length > 0 && (
					<section class={patrimonio ? 'mt-10' : ''}>
						<h2 class="text-lg font-semibold text-slate-900">Historial de votaciones</h2>
						{autoridad.cargo === 'diputado' && (
							<p class="mt-1 text-xs text-slate-500">
								Vía camara.cl. Se muestran solo las votaciones más recientes, no el historial completo
								del período — la fuente no permite navegar hacia atrás.
							</p>
						)}
						<ul class="mt-4 space-y-3">
							{historialVotos.map(({ sesion, voto }) => (
								<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
									<div class="flex items-center justify-between text-xs text-slate-500">
										<span>{sesion.fecha}</span>
										<span class="font-medium text-slate-700">
											{VOTO_LABEL[voto!.voto] ?? voto!.voto}
										</span>
									</div>
									<p class="mt-2 text-sm text-slate-800">{sesion.descripcion}</p>
								</li>
							))}
						</ul>
					</section>
				)}

				{resumenAsistencia && (
					<section class={patrimonio || historialVotos.length > 0 ? 'mt-10' : ''}>
						<h2 class="text-lg font-semibold text-slate-900">
							Asistencia a sala ({etiquetaPeriodoAsistencia(resumenAsistencia)})
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Resumen del período tal como lo calcula la fuente oficial ({resumenAsistencia.camara === 'senado' ? 'senado.cl' : 'camara.cl'}).
							{resumenAsistencia.asistencias > resumenAsistencia.sesiones_computables && (
								<span class="block text-amber-600">
									La fuente reporta más asistencias que sesiones computables — se muestra igual, tal cual la
									publica.
								</span>
							)}
						</p>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Asistencias</p>
								<p class="mt-1 text-xl font-bold text-slate-900">
									{resumenAsistencia.asistencias} / {resumenAsistencia.sesiones_computables}
								</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Ausencias justificadas</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.ausencias_justificadas}</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Ausencias sin justificar</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.ausencias_sin_justificar}</p>
							</div>
							<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
								<p class="text-xs text-slate-500">Total sesiones del período</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{resumenAsistencia.total_sesiones}</p>
							</div>
						</div>
						<a href={resumenAsistencia.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
							Ver fuente completa
						</a>
					</section>
				)}

				{historialMociones.length > 0 && (
					<section class={patrimonio || historialVotos.length > 0 || resumenAsistencia ? 'mt-10' : ''}>
						<h2 class="text-lg font-semibold text-slate-900">
							Mociones presentadas ({historialMociones.length})
						</h2>
						<p class="mt-1 text-xs text-slate-500">
							Como autor o coautor este año, vía {autoridad.cargo === 'senador' ? 'el buscador de tramitación del Senado' : 'la ficha del diputado/a en camara.cl'}.
						</p>
						<ul class="mt-4 space-y-3">
							{historialMociones.map((m) => (
								<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
									<div class="flex items-center justify-between text-xs text-slate-500">
										<span>{m.fecha}</span>
										<span>Boletín {m.boletin}</span>
									</div>
									<p class="mt-2 text-sm text-slate-800">
										<a href={m.url_bcn} target="_blank" rel="noopener" class="hover:text-brand-600 hover:underline">
											{m.titulo}
										</a>
									</p>
								</li>
							))}
						</ul>
					</section>
				)}

				{!patrimonio &&
					historialVotos.length === 0 &&
					historialMociones.length === 0 &&
					!resumenAsistencia && (
						<p class="text-sm text-slate-500">
							Todavía no hay votaciones ni mociones registradas para esta autoridad.
						</p>
					)}
			</div>
		</div>
	</main>
</Layout>
