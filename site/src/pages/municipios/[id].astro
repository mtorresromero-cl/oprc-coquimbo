---
import Layout from '../../layouts/Layout.astro';
import {
	comunas,
	presupuestoDeComuna,
	personalDeComuna,
	remuneracionAutoridadDeComuna,
	AREA_LABEL,
	TIPO_CONTRATO_LABEL,
	nombreMes,
	periodoDesdeFuenteUrl,
} from '../../lib/datos';

export function getStaticPaths() {
	return comunas
		.filter((c) => presupuestoDeComuna(c.id).length > 0 || personalDeComuna(c.id).length > 0)
		.map((c) => ({ params: { id: c.id }, props: { comuna: c } }));
}

const { comuna } = Astro.props;
const items = presupuestoDeComuna(comuna.id);
const anno = items.length ? Math.max(...items.map((i) => i.anno)) : null;
const delAnno = items.filter((i) => i.anno === anno);
const ingresos = delAnno.filter((i) => i.tipo === 'ingreso').sort((a, b) => b.monto - a.monto);
const gastos = delAnno.filter((i) => i.tipo === 'gasto').sort((a, b) => b.monto - a.monto);
const totalIngresos = ingresos.reduce((s, i) => s + i.monto, 0);
const totalGastos = gastos.reduce((s, i) => s + i.monto, 0);
const fuenteUrl = delAnno[0]?.fuente_url;
const periodoIngresos = periodoDesdeFuenteUrl(ingresos[0]?.fuente_url, anno);
const periodoGastos = periodoDesdeFuenteUrl(gastos[0]?.fuente_url, anno);

const personal = personalDeComuna(comuna.id);
const remuneracionAutoridad = remuneracionAutoridadDeComuna(comuna.id);
const dotacionTotal = personal.reduce((s, p) => s + p.dotacion, 0);
const remuneracionTotalPersonal = personal.reduce((s, p) => s + p.remuneracion_total, 0);
const periodosPersonal = [...new Set(personal.map((p) => `${nombreMes(p.mes)}/${p.anno}`))];
const periodoPersonal = periodosPersonal.length === 1 ? periodosPersonal[0] : null;

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}
---

<Layout title={`${comuna.nombre} — OPRC`} description={`Presupuesto y personal municipal de ${comuna.nombre}, Región de Coquimbo.`}>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<a href="/municipios/" class="text-sm font-medium text-slate-500 hover:text-brand-600">&larr; Municipios</a>
			<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">{comuna.nombre}</h1>
			<p class="mt-1 text-slate-500">{comuna.provincia}</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
			{items.length > 0 && (
				<section class="max-w-xl">
					<h2 class="text-lg font-semibold text-slate-900">Presupuesto {anno}</h2>
					<p class="mt-1 text-base text-slate-500">
						Balance de ejecución presupuestaria acumulado, categorías principales. Cifras según lo
						efectivamente percibido/ejecutado a la fecha del último informe trimestral publicado.
					</p>

					<div class="mt-5 grid grid-cols-2 gap-4">
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Ingresos percibidos</p>
							<p class="mt-1 text-xl font-bold text-emerald-700">
								{ingresos.length > 0 ? formatoCLP(totalIngresos) : 'No publicado'}
							</p>
						</div>
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Gastos ejecutados</p>
							<p class="mt-1 text-xl font-bold text-red-700">
								{gastos.length > 0 ? formatoCLP(totalGastos) : 'No publicado'}
							</p>
						</div>
					</div>

					<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<p class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<span>Ingresos por categoría</span>
							{periodoIngresos && <span class="font-normal normal-case text-slate-400">{periodoIngresos}</span>}
						</p>
						{ingresos.length > 0 ? (
							<ul class="divide-y divide-slate-100 text-sm">
								{ingresos.map((i) => (
									<li class="flex justify-between gap-3 px-4 py-2.5">
										<span class="min-w-0 break-words text-slate-700">{i.categoria}</span>
										<span class="shrink-0 font-medium text-slate-900">{formatoCLP(i.monto)}</span>
									</li>
								))}
							</ul>
						) : (
							<p class="px-4 py-3 text-sm text-slate-400">No publicado por la comuna para {anno}.</p>
						)}
					</div>

					<div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<p class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<span>Gastos por categoría</span>
							{periodoGastos && <span class="font-normal normal-case text-slate-400">{periodoGastos}</span>}
						</p>
						{gastos.length > 0 ? (
							<ul class="divide-y divide-slate-100 text-sm">
								{gastos.map((g) => (
									<li class="flex justify-between gap-3 px-4 py-2.5">
										<span class="min-w-0 break-words text-slate-700">{g.categoria}</span>
										<span class="shrink-0 font-medium text-slate-900">{formatoCLP(g.monto)}</span>
									</li>
								))}
							</ul>
						) : (
							<p class="px-4 py-3 text-sm text-slate-400">No publicado por la comuna para {anno}.</p>
						)}
					</div>

					{fuenteUrl && (
						<p class="mt-4 text-xs text-slate-400">
							Fuente: <a href={fuenteUrl} class="hover:text-brand-600 hover:underline" target="_blank" rel="noopener">
								Balance de ejecución presupuestaria, transparencia municipal
							</a>
						</p>
					)}
				</section>
			)}

			{personal.length > 0 && (
				<section class="max-w-xl">
					<h2 class="text-lg font-semibold text-slate-900">
						Personal municipal{periodoPersonal ? ` (${periodoPersonal})` : ''}
					</h2>
					<p class="mt-1 text-base text-slate-500">
						Totales agregados por tipo de contrato y área — no incluye nombres individuales, salvo
						autoridades electas (ver abajo). Fuente: portaltransparencia.cl.
						{!periodoPersonal && (
							<span class="block">
								No todas las categorías se actualizan el mismo mes: cada fila indica su propio
								período.
							</span>
						)}
					</p>

					<div class="mt-5 grid grid-cols-2 gap-4">
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Dotación total</p>
							<p class="mt-1 text-xl font-bold text-slate-900">
								{dotacionTotal.toLocaleString('es-CL')} personas
							</p>
						</div>
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Remuneraciones totales{periodoPersonal ? ' del mes' : ''}</p>
							<p class="mt-1 text-xl font-bold text-slate-900">
								{formatoCLP(remuneracionTotalPersonal)}
							</p>
						</div>
					</div>

					<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
						<table class="w-full text-sm">
							<thead>
								<tr class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
									<th class="px-4 py-2">Área</th>
									<th class="px-4 py-2">Tipo</th>
									<th class="px-4 py-2 text-right">Dotación</th>
									<th class="px-4 py-2 text-right">Remuneración total</th>
									<th class="px-4 py-2 text-right">Período</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{personal.map((p) => (
									<tr>
										<td class="px-4 py-2.5 text-slate-700">{AREA_LABEL[p.area] ?? p.area}</td>
										<td class="px-4 py-2.5 text-slate-700">
											{TIPO_CONTRATO_LABEL[p.tipo_contrato] ?? p.tipo_contrato}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-900">{p.dotacion.toLocaleString('es-CL')}</td>
										<td class="px-4 py-2.5 text-right font-medium text-slate-900">
											{formatoCLP(p.remuneracion_total)}
										</td>
										<td class="px-4 py-2.5 text-right text-xs text-slate-400">{nombreMes(p.mes)}/{p.anno}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					{remuneracionAutoridad.map((r) => (
						<p class="mt-4 text-base text-slate-700">
							Remuneración bruta de {r.cargo.toLowerCase()} ({nombreMes(r.mes)}/{r.anno}):{' '}
							<span class="font-semibold text-slate-900">{formatoCLP(r.remuneracion_bruta)}</span>
							<span class="mt-1 block max-w-md rounded-md bg-amber-50 px-2 py-1.5 text-xs text-amber-800">
								Cifra bruta de ese mes puntual, no un sueldo base fijo: al revisar
								enero-julio/2026 en toda la región, la mayoría de las comunas tiene meses
								(típicamente mayo y julio) con un salto de hasta 30-70% por bonos o
								asignaciones variables que no se pagan todos los meses.
							</span>
						</p>
					))}
				</section>
			)}
		</div>
	</main>
</Layout>
