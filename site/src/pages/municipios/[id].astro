---
import Layout from '../../layouts/Layout.astro';
import TarjetaAutoridad from '../../components/TarjetaAutoridad.astro';
import {
	comunas,
	autoridades,
	presupuestoDeComuna,
	personalDeComuna,
	remuneracionAutoridadDeComuna,
	fotoAutoridad,
	sexoAutoridad,
	cargoDeAutoridad,
	nombrePartido,
	AREA_LABEL,
	TIPO_CONTRATO_LABEL,
	nombreMes,
	periodoDesdeFuenteUrl,
} from '../../lib/datos';

// azul de la paleta categórica del sitio (mismo orden que usa, por ej.,
// la red de asesores) — resalta al alcalde/sa como la autoridad principal
// de la comuna, sin pisar los colores ya reservados por tema (gasto,
// asistencia, etc.)
const COLOR_ALCALDE = '#2a78d6';

function iniciales(nombre: string) {
	const partes = nombre.split(' ').filter(Boolean);
	return ((partes[0]?.[0] ?? '') + (partes[1]?.[0] ?? '')).toUpperCase();
}

export function getStaticPaths() {
	return comunas
		.filter((c) => presupuestoDeComuna(c.id).length > 0 || personalDeComuna(c.id).length > 0)
		.map((c) => ({ params: { id: c.id }, props: { comuna: c } }));
}

const { comuna } = Astro.props;
const items = presupuestoDeComuna(comuna.id);
const anno = items.length ? Math.max(...items.map((i) => i.anno)) : null;
const delAnno = items.filter((i) => i.anno === anno);
const ingresos = delAnno.filter((i) => i.tipo === 'ingreso').sort((a, b) => b.monto - a.monto);
const gastos = delAnno.filter((i) => i.tipo === 'gasto').sort((a, b) => b.monto - a.monto);
const totalIngresos = ingresos.reduce((s, i) => s + i.monto, 0);
const totalGastos = gastos.reduce((s, i) => s + i.monto, 0);
const fuenteUrl = delAnno[0]?.fuente_url;
const periodoIngresos = periodoDesdeFuenteUrl(ingresos[0]?.fuente_url, anno);
const periodoGastos = periodoDesdeFuenteUrl(gastos[0]?.fuente_url, anno);

const autoridadesComuna = autoridades
	.filter((a) => a.comuna === comuna.id)
	.sort((a, b) => (a.cargo === b.cargo ? a.nombre_completo.localeCompare(b.nombre_completo) : a.cargo === 'alcalde' ? -1 : 1));
const alcalde = autoridadesComuna.find((a) => a.cargo === 'alcalde');
const fotoAlcalde = alcalde ? fotoAutoridad(alcalde.id) : null;
const concejales = autoridadesComuna.filter((a) => a.cargo === 'concejal');

const partidoCounts = new Map<string, number>();
for (const a of autoridadesComuna) {
	const key = a.partido ? nombrePartido(a.partido) : 'Independiente';
	partidoCounts.set(key, (partidoCounts.get(key) ?? 0) + 1);
}
const partidosOrdenados = [...partidoCounts.entries()].sort((a, b) => b[1] - a[1]);
const maxPartido = Math.max(...partidosOrdenados.map(([, n]) => n), 1);

let hombresAutoridades = 0;
let mujeresAutoridades = 0;
for (const a of autoridadesComuna) {
	const s = sexoAutoridad(a.id);
	if (s === 'M') hombresAutoridades++;
	else if (s === 'F') mujeresAutoridades++;
}
const totalConGenero = hombresAutoridades + mujeresAutoridades;

const personal = personalDeComuna(comuna.id);
const remuneracionAutoridad = remuneracionAutoridadDeComuna(comuna.id);
const dotacionTotal = personal.reduce((s, p) => s + p.dotacion, 0);
const remuneracionTotalPersonal = personal.reduce((s, p) => s + p.remuneracion_total, 0);
const periodosPersonal = [...new Set(personal.map((p) => `${nombreMes(p.mes)}/${p.anno}`))];
const periodoPersonal = periodosPersonal.length === 1 ? periodosPersonal[0] : null;
// "SECRETARIA ALCALDE" es un cargo real, pero no es el/la alcalde/sa —
// hay que excluirlo explícitamente para no mostrar el sueldo equivocado
const remuneracionAlcalde = remuneracionAutoridad.find(
	(r) => r.cargo.toUpperCase().includes('ALCALDE') && !r.cargo.toUpperCase().includes('SECRETAR')
);

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}
---

<Layout title={`${comuna.nombre} — OPRC`} description={`Presupuesto y personal municipal de ${comuna.nombre}, Región de Coquimbo.`}>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<a href="/municipios/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white">
				&larr; Municipios
			</a>
			<p class="mt-6 text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">{comuna.nombre}</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">{comuna.provincia}</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		{autoridadesComuna.length > 0 && (
			<section class="mb-12">
				<h2 class="text-lg font-semibold text-slate-900">Autoridades</h2>
				<p class="mt-1 text-base text-slate-500">
					Quién gobierna {comuna.nombre}: alcalde/sa, concejales, y un vistazo al peso político y
					de género.
				</p>

				<div class="mt-5 grid grid-cols-1 gap-6 lg:grid-cols-3">
					<div class="lg:col-span-2">
						{alcalde && (
							<a
								href={`/autoridades/${alcalde.id}/`}
								class="flex items-center gap-4 rounded-xl p-5 text-white shadow-sm transition hover:brightness-110"
								style={`background:${COLOR_ALCALDE}`}
							>
								{fotoAlcalde ? (
									<img src={fotoAlcalde} alt="" class="h-16 w-16 shrink-0 rounded-full border-2 border-white/70 object-cover" />
								) : (
									<span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-2 border-white/70 bg-white/15 text-xl font-bold">
										{iniciales(alcalde.nombre_completo)}
									</span>
								)}
								<div class="min-w-0">
									<p class="text-xs font-semibold tracking-wide text-white/70 uppercase">{cargoDeAutoridad(alcalde)}</p>
									<p class="mt-0.5 text-xl font-bold leading-tight">{alcalde.nombre_completo}</p>
									<p class="mt-1 text-sm text-white/80">{alcalde.partido ? nombrePartido(alcalde.partido) : 'Independiente'}</p>
								</div>
							</a>
						)}

						{concejales.length > 0 && (
							<ul class="mt-4 grid gap-4 sm:grid-cols-2">
								{concejales.map((a) => <TarjetaAutoridad autoridad={a} />)}
							</ul>
						)}
					</div>

					<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
						<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Estadísticas</p>

						{partidosOrdenados.length > 0 && (
							<div class="mt-4">
								<p class="text-sm font-semibold text-slate-700">Peso por partido</p>
								<div class="mt-2 space-y-2">
									{partidosOrdenados.map(([partido, n]) => (
										<div>
											<div class="flex items-center justify-between gap-2 text-xs text-slate-600">
												<span class="min-w-0 truncate">{partido}</span>
												<span class="shrink-0 font-semibold text-slate-900">{n}</span>
											</div>
											<div class="mt-1 h-1.5 rounded bg-slate-100">
												<div class="h-1.5 rounded" style={`width:${(n / maxPartido) * 100}%;background:${COLOR_ALCALDE}`}></div>
											</div>
										</div>
									))}
								</div>
							</div>
						)}

						{totalConGenero > 0 && (
							<div class="mt-5 border-t border-slate-100 pt-4">
								<p class="text-sm font-semibold text-slate-700">Hombres y mujeres</p>
								<div class="mt-2 flex items-center justify-between text-sm text-slate-700">
									<span>Hombres <span class="font-semibold text-slate-900">{hombresAutoridades}</span></span>
									<span>Mujeres <span class="font-semibold text-slate-900">{mujeresAutoridades}</span></span>
								</div>
								<div class="mt-2 flex h-2 overflow-hidden rounded-full bg-slate-100">
									<div class="h-2 bg-slate-600" style={`width:${(hombresAutoridades / totalConGenero) * 100}%`}></div>
									<div class="h-2 bg-brand-600" style={`width:${(mujeresAutoridades / totalConGenero) * 100}%`}></div>
								</div>
							</div>
						)}

						{remuneracionAlcalde && (
							<div class="mt-5 border-t border-slate-100 pt-4">
								<p class="text-sm font-semibold text-slate-700">
								Sueldo {alcalde && sexoAutoridad(alcalde.id) === 'F' ? 'de la' : 'del'} {alcalde ? cargoDeAutoridad(alcalde).toLowerCase() : 'alcalde/sa'}
							</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{formatoCLP(remuneracionAlcalde.remuneracion_bruta)}</p>
								<p class="mt-0.5 text-xs text-slate-400">
									{nombreMes(remuneracionAlcalde.mes)}/{remuneracionAlcalde.anno} — cifra bruta de ese mes, no un sueldo base fijo.
								</p>
							</div>
						)}

						{dotacionTotal > 0 && (
							<div class="mt-5 border-t border-slate-100 pt-4">
								<p class="text-sm font-semibold text-slate-700">Dotación municipal</p>
								<p class="mt-1 text-xl font-bold text-slate-900">{dotacionTotal.toLocaleString('es-CL')} personas</p>
								<p class="mt-0.5 text-xs text-slate-400">dependen de este municipio, entre planta, contrata y honorarios.</p>
							</div>
						)}
					</div>
				</div>
			</section>
		)}

		<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
			{items.length > 0 && (
				<section class="max-w-xl">
					<h2 class="text-lg font-semibold text-slate-900">Presupuesto {anno}</h2>
					<p class="mt-1 text-base text-slate-500">
						Balance de ejecución presupuestaria acumulado, categorías principales. Cifras según lo
						efectivamente percibido/ejecutado a la fecha del último informe trimestral publicado.
					</p>

					<div class="mt-5 grid grid-cols-2 gap-4">
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Ingresos percibidos</p>
							<p class="mt-1 text-xl font-bold text-emerald-700">
								{ingresos.length > 0 ? formatoCLP(totalIngresos) : 'No publicado'}
							</p>
						</div>
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Gastos ejecutados</p>
							<p class="mt-1 text-xl font-bold text-red-700">
								{gastos.length > 0 ? formatoCLP(totalGastos) : 'No publicado'}
							</p>
						</div>
					</div>

					<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<p class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<span>Ingresos por categoría</span>
							{periodoIngresos && <span class="font-normal normal-case text-slate-400">{periodoIngresos}</span>}
						</p>
						{ingresos.length > 0 ? (
							<ul class="divide-y divide-slate-100 text-sm">
								{ingresos.map((i) => (
									<li class="flex justify-between gap-3 px-4 py-2.5">
										<span class="min-w-0 break-words text-slate-700">{i.categoria}</span>
										<span class="shrink-0 font-medium text-slate-900">{formatoCLP(i.monto)}</span>
									</li>
								))}
							</ul>
						) : (
							<p class="px-4 py-3 text-sm text-slate-400">No publicado por la comuna para {anno}.</p>
						)}
					</div>

					<div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<p class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<span>Gastos por categoría</span>
							{periodoGastos && <span class="font-normal normal-case text-slate-400">{periodoGastos}</span>}
						</p>
						{gastos.length > 0 ? (
							<ul class="divide-y divide-slate-100 text-sm">
								{gastos.map((g) => (
									<li class="flex justify-between gap-3 px-4 py-2.5">
										<span class="min-w-0 break-words text-slate-700">{g.categoria}</span>
										<span class="shrink-0 font-medium text-slate-900">{formatoCLP(g.monto)}</span>
									</li>
								))}
							</ul>
						) : (
							<p class="px-4 py-3 text-sm text-slate-400">No publicado por la comuna para {anno}.</p>
						)}
					</div>

					{fuenteUrl && (
						<p class="mt-4 text-xs text-slate-400">
							Fuente: <a href={fuenteUrl} class="hover:text-brand-600 hover:underline" target="_blank" rel="noopener">
								Balance de ejecución presupuestaria, transparencia municipal
							</a>
						</p>
					)}
				</section>
			)}

			{personal.length > 0 && (
				<section class="max-w-xl">
					<h2 class="text-lg font-semibold text-slate-900">
						Personal municipal{periodoPersonal ? ` (${periodoPersonal})` : ''}
					</h2>
					<p class="mt-1 text-base text-slate-500">
						Totales agregados por tipo de contrato y área — no incluye nombres individuales, salvo
						autoridades electas (ver abajo). Fuente: portaltransparencia.cl.
						{!periodoPersonal && (
							<span class="block">
								No todas las categorías se actualizan el mismo mes: cada fila indica su propio
								período.
							</span>
						)}
					</p>

					<div class="mt-5 grid grid-cols-2 gap-4">
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Dotación total</p>
							<p class="mt-1 text-xl font-bold text-slate-900">
								{dotacionTotal.toLocaleString('es-CL')} personas
							</p>
						</div>
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs text-slate-500">Remuneraciones totales{periodoPersonal ? ' del mes' : ''}</p>
							<p class="mt-1 text-xl font-bold text-slate-900">
								{formatoCLP(remuneracionTotalPersonal)}
							</p>
						</div>
					</div>

					<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
						<table class="w-full text-sm">
							<thead>
								<tr class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
									<th class="px-4 py-2">Área</th>
									<th class="px-4 py-2">Tipo</th>
									<th class="px-4 py-2 text-right">Dotación</th>
									<th class="px-4 py-2 text-right">Remuneración total</th>
									<th class="px-4 py-2 text-right">Período</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{personal.map((p) => (
									<tr>
										<td class="px-4 py-2.5 text-slate-700">{AREA_LABEL[p.area] ?? p.area}</td>
										<td class="px-4 py-2.5 text-slate-700">
											{TIPO_CONTRATO_LABEL[p.tipo_contrato] ?? p.tipo_contrato}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-900">{p.dotacion.toLocaleString('es-CL')}</td>
										<td class="px-4 py-2.5 text-right font-medium text-slate-900">
											{formatoCLP(p.remuneracion_total)}
										</td>
										<td class="px-4 py-2.5 text-right text-xs text-slate-400">{nombreMes(p.mes)}/{p.anno}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			)}
		</div>
	</main>
</Layout>
