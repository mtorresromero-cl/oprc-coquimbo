---
import Layout from '../../layouts/Layout.astro';
import {
	comunas,
	personal,
	presupuestoDeComuna,
	personalDeComuna,
	comparativaMunicipal,
	dotacionPorTipoContrato,
	remuneracionAlcaldesPorComuna,
	nombreMes,
} from '../../lib/datos';

const filas = comunas
	.map((c) => ({
		comuna: c,
		tienePresupuesto: presupuestoDeComuna(c.id).length > 0,
		tienePersonal: personalDeComuna(c.id).length > 0,
	}))
	.sort((a, b) => a.comuna.nombre.localeCompare(b.comuna.nombre));

const comparativa = comparativaMunicipal()
	.filter((c) => c.dotacionTotal > 0)
	.sort((a, b) => b.dotacionTotal - a.dotacionTotal);

const dotacionTipo = dotacionPorTipoContrato();
const totalDotacion = dotacionTipo.reduce((s, d) => s + d.dotacion, 0);
const maxDotacionTipo = Math.max(...dotacionTipo.map((d) => d.dotacion), 1);
const municipiosConDotacion = new Set(personal.map((p) => p.comuna_id)).size;
const TIPO_CONTRATO_LABEL: Record<string, string> = {
	planta: 'Planta',
	contrata: 'Contrata',
	honorarios: 'Honorarios',
};

const remuneracionAlcaldes = remuneracionAlcaldesPorComuna();
const comunasSinRemuneracion = comunas
	.filter((c) => !remuneracionAlcaldes.some((r) => r.comunaId === c.id))
	.map((c) => c.nombre);
const maxRemuneracion = Math.max(...remuneracionAlcaldes.map((r) => r.remuneracionBruta), 1);

function formatoCLP(monto: number) {
	return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(
		monto
	);
}

function pctDe(parte: number, total: number) {
	return total > 0 ? Math.round((parte / total) * 100) : 0;
}
---

<Layout title="Municipios — OPRC" description="Presupuesto, dotación y remuneraciones de las 15 comunas de la Región de Coquimbo.">
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">Municipios</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Presupuesto y personal municipal de las 15 comunas de la región, según el Portal de
				Transparencia. La cobertura varía por comuna según lo que cada municipio publica.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<a
			href="/mapa/"
			class="mb-6 flex items-center gap-4 rounded-xl border p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
			style="background:color-mix(in srgb, var(--color-topic-mociones) 8%, white);border-color:color-mix(in srgb, var(--color-topic-mociones) 25%, white)"
		>
			<span
				class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg"
				style="background:color-mix(in srgb, var(--color-topic-mociones) 16%, white);color:var(--color-topic-mociones)"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
				</svg>
			</span>
			<span>
				<span class="font-semibold text-slate-900">Ver mapa interactivo de la región →</span>
				<span class="mt-1 block text-sm text-slate-600">
					Las 15 comunas coloreadas por cobertura de datos o dotación municipal.
				</span>
			</span>
		</a>

		{comparativa.length > 0 && (
			<section class="mb-14">
				<h2 class="text-xl font-semibold text-slate-900">Comparativa entre comunas</h2>
				<p class="mt-1 max-w-2xl text-base text-slate-500">
					Totales absolutos, no per cápita: todavía no tenemos población oficial cargada por
					comuna, así que una comuna más grande va a aparecer arriba en dotación o gasto
					simplemente por tener más habitantes, no porque gestione peor que una comuna chica.
					Cada comuna en su período más reciente informado — los períodos no son iguales entre
					comunas.
				</p>
				<p class="mt-2 max-w-2xl text-base text-slate-500">
					Ingresos y Gastos son lo <strong>efectivamente percibido/ejecutado</strong> en lo que va
					del año, no el presupuesto anual completo. Por eso una comuna chica puede mostrar más
					ingresos que una grande: las transferencias importantes (Fondo Común Municipal, fondos
					regionales, etc.) no llegan parejo mes a mes, así que el orden de esta tabla cambia
					según qué comuna ya recibió sus transferencias grandes a la fecha de su informe y cuál
					todavía las está esperando.
				</p>
				<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
					<table class="w-full min-w-[720px] text-sm">
						<thead>
							<tr class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
								<th class="px-4 py-2 whitespace-nowrap">Comuna</th>
								<th class="px-4 py-2">Período</th>
								<th class="px-4 py-2 text-right">Dotación total</th>
								<th class="px-4 py-2 text-right">Planta</th>
								<th class="px-4 py-2 text-right">Contrata</th>
								<th class="px-4 py-2 text-right">Honorarios</th>
								<th class="px-4 py-2 text-right">Remuneración total/mes</th>
								<th class="px-4 py-2 text-right">Ingresos</th>
								<th class="px-4 py-2 text-right">Gastos</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							{comparativa.map((c) => (
								<tr>
									<td class="px-4 py-2.5 whitespace-nowrap">
										<a href={`/municipios/${c.comuna_id}/`} class="font-medium text-slate-900 hover:text-brand-600 hover:underline">
											{c.nombre}
										</a>
									</td>
									<td class="px-4 py-2.5 text-slate-500">{c.periodoPersonal}</td>
									<td class="px-4 py-2.5 text-right font-semibold text-slate-900">{c.dotacionTotal}</td>
									<td class="px-4 py-2.5 text-right whitespace-nowrap text-slate-700">
										{c.dotacionPlanta} <span class="text-xs text-slate-400">({pctDe(c.dotacionPlanta, c.dotacionTotal)}%)</span>
									</td>
									<td class="px-4 py-2.5 text-right whitespace-nowrap text-slate-700">
										{c.dotacionContrata} <span class="text-xs text-slate-400">({pctDe(c.dotacionContrata, c.dotacionTotal)}%)</span>
									</td>
									<td class="px-4 py-2.5 text-right whitespace-nowrap text-slate-700">
										{c.dotacionHonorarios} <span class="text-xs text-slate-400">({pctDe(c.dotacionHonorarios, c.dotacionTotal)}%)</span>
									</td>
									<td class="px-4 py-2.5 text-right text-slate-700">{formatoCLP(c.remuneracionTotal)}</td>
									<td class="px-4 py-2.5 text-right text-slate-700">
										{c.tieneIngresos ? formatoCLP(c.ingresosTotal) : <span class="text-slate-300">—</span>}
									</td>
									<td class="px-4 py-2.5 text-right text-slate-700">
										{c.tieneGastos ? formatoCLP(c.gastosTotal) : <span class="text-slate-300">—</span>}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="mt-3 text-sm text-slate-500">
					Las comunas con "—" en Ingresos o Gastos sí publican esa información, pero de una forma
					que no podemos leer automáticamente todavía: algunas la publican como una imagen
					escaneada en vez de texto, otras usan un formato contable distinto al del resto, y en
					un par de casos el sitio del municipio bloquea el acceso automatizado. No es que falte
					el dato en la fuente — es que por ahora no logramos extraerlo de ahí.
				</p>
			</section>
		)}

		<section class="mb-14 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
			<div>
				<h2 class="text-xl font-semibold text-slate-900">Las 15 comunas</h2>
				<p class="mt-1 max-w-md text-base text-slate-500">
					Cobertura de datos de transparencia por comuna — entra a cada una para el detalle.
				</p>
				<ul class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
					{filas.map(({ comuna, tienePresupuesto, tienePersonal }) => {
						const tieneDatos = tienePresupuesto || tienePersonal;
						const contenido = (
							<>
								<div>
									<p class="font-semibold text-slate-900">{comuna.nombre}</p>
									<p class="text-xs text-slate-500">{comuna.provincia}</p>
								</div>
								<div class="flex shrink-0 flex-wrap justify-end gap-1.5">
									{tienePresupuesto && (
										<span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
											Presupuesto
										</span>
									)}
									{tienePersonal && (
										<span class="rounded-full bg-brand-50 px-2 py-0.5 text-[11px] font-medium text-brand-700">
											Personal
										</span>
									)}
									{!tieneDatos && (
										<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-500">
											Sin datos aún
										</span>
									)}
								</div>
							</>
						);

						return tieneDatos ? (
							<li>
								<a
									href={`/municipios/${comuna.id}/`}
									class="flex items-center justify-between gap-3 px-4 py-3 transition hover:bg-slate-50"
								>
									{contenido}
								</a>
							</li>
						) : (
							<li class="flex items-center justify-between gap-3 px-4 py-3 opacity-60">{contenido}</li>
						);
					})}
				</ul>
			</div>

			<div>
				<h2 class="text-xl font-semibold text-slate-900">Dotación por tipo de contrato</h2>
				<p class="mt-1 max-w-md text-base text-slate-500">
					Suma regional de las {totalDotacion} personas que trabajan en los {municipiosConDotacion}{' '}
					municipios con datos publicados.
				</p>
				<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
					<div class="space-y-3">
						{dotacionTipo.map((d) => (
							<div class="flex items-center gap-4">
								<span class="w-24 shrink-0 text-sm font-medium text-slate-700">{TIPO_CONTRATO_LABEL[d.tipoContrato] ?? d.tipoContrato}</span>
								<div class="h-6 flex-1 rounded bg-slate-200">
									<div class="h-6 rounded bg-brand-600" style={`width:${(d.dotacion / maxDotacionTipo) * 100}%`}></div>
								</div>
								<span class="w-14 shrink-0 text-right text-sm font-semibold text-slate-900">{d.dotacion}</span>
							</div>
						))}
					</div>
				</div>

				<h2 class="mt-12 text-xl font-semibold text-slate-900">Remuneración de alcaldes/as por comuna</h2>
				<p class="mt-1 max-w-md text-base text-slate-500">
					Remuneración bruta del mes más reciente publicado por cada comuna (indicado junto a cada
					barra) según el Portal de Transparencia. No incluye a concejales.
					{comunasSinRemuneracion.length > 0 && (
						<>{' '}Falta{comunasSinRemuneracion.length === 1 ? '' : 'n'} {comunasSinRemuneracion.join(' y ')}, sin registro disponible.</>
					)}
				</p>
				<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
					<div class="space-y-2.5">
						{remuneracionAlcaldes.map((r) => (
							<div class="flex items-center gap-4">
								<span class="w-28 shrink-0 truncate text-sm font-medium text-slate-700">{r.nombreComuna}</span>
								<div class="h-5 flex-1 rounded bg-slate-200">
									<div class="h-5 rounded bg-brand-600" style={`width:${(r.remuneracionBruta / maxRemuneracion) * 100}%`}></div>
								</div>
								<span class="w-32 shrink-0 text-right text-xs font-semibold text-slate-900">
									{formatoCLP(r.remuneracionBruta)}
									<span class="block font-normal text-slate-400">{nombreMes(r.mes)}/{r.anno}</span>
								</span>
							</div>
						))}
					</div>
				</div>
				<p class="mt-4 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800">
					<strong>Por qué varía tanto entre comunas:</strong> revisamos el histórico enero-julio
					2026 de las 15 comunas y en la mayoría hay un salto de 30-70% en mayo y julio sobre su
					línea base de otros meses — compatible con algún bono o asignación variable que no se
					paga todos los meses. No es parejo: algunas comunas (Paihuano, Salamanca, Combarbalá,
					Canela, La Higuera) se mantienen planas todo el semestre. Por eso esta cifra no es un
					sueldo base comparable 1 a 1 entre comunas, sino el monto bruto de ese mes puntual.
				</p>
			</div>
		</section>
	</main>
</Layout>
