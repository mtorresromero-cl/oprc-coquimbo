---
import Layout from '../../layouts/Layout.astro';
import { autoridades, votacionesCore, indiceVotaciones, VOTO_LABEL } from '../../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}

const coreIds = autoridades.filter((a) => a.cargo === 'core' || a.cargo === 'gobernador').map((a) => a.id);
const indiceCore = indiceVotaciones(votacionesCore, coreIds);

function metricsDe(i: (typeof indiceCore)[number]) {
	return {
		participacionPct: i.participacionPct,
		alineamientoPct: i.alineamientoPct,
		favor: i.favor,
		abstencion: i.abstencion,
		ausente: i.ausente,
		inhabilitado: i.inhabilitado,
	};
}

// El gobernador regional vota los mismos acuerdos que el Consejo, pero no es
// consejero -- se muestra aparte, no mezclado en el ranking de consejeros.
const indiceGobernador = indiceCore.find((i) => i.cargo === 'gobernador');
const gobernador = indiceGobernador && {
	id: indiceGobernador.autoridad_id,
	nombre: indiceGobernador.nombre,
	metrics: metricsDe(indiceGobernador),
};

const grupo = indiceCore
	.filter((i) => i.cargo !== 'gobernador')
	.map((i) => ({
		id: i.autoridad_id,
		nombre: i.nombre,
		metrics: metricsDe(i),
	}));

const acuerdosCore = [...votacionesCore].sort((a, b) => b.fecha.localeCompare(a.fecha));
const acuerdosRechazados = votacionesCore.filter((v) => v.resultado === 'rechazado').length;

function esUnanime(v: (typeof votacionesCore)[number]) {
	return v.votos.length > 0 && v.votos.every((voto) => voto.voto === 'favor');
}

function formatoValorEstatico(key: string, valor: number | null) {
	if (valor === null) return 'Sin datos comparables';
	return key.endsWith('Pct') ? `${valor.toFixed(1)}%` : String(valor);
}

const METRICAS: [string, string][] = [
	['participacionPct', 'Participación'],
	['alineamientoPct', 'Alineamiento'],
	['favor', 'A favor'],
	['abstencion', 'Abstención'],
	['ausente', 'Ausente'],
	['inhabilitado', 'Inhabilitado'],
];
---

<Layout
	title="Consejo Regional — OPRC"
	description="Ranking de participación y acuerdos recientes de los consejeros regionales y el gobernador de la Región de Coquimbo."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Datos</p>
			<h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Consejo Regional
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-slate-300">
				Ranking de participación y acuerdos recientes de los 16 consejeros regionales. El
				gobernador regional participa de los mismos acuerdos, pero no es consejero — sus datos se
				muestran aparte.
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-10">
		{gobernador && (
			<section class="rounded-xl border border-amber-200 bg-amber-50 p-5 shadow-sm">
				<div class="flex items-center gap-2">
					<span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700">
						Gobernador/a Regional
					</span>
					<a href={`/autoridades/${gobernador.id}/`} class="font-semibold text-slate-900 hover:text-brand-600 hover:underline">
						{gobernador.nombre}
					</a>
				</div>
				<p class="mt-2 text-base text-slate-600">
					No es consejero/a, pero participa de los mismos acuerdos del Consejo Regional.
				</p>
				<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
					{METRICAS.map(([key, label]) => (
						<div class="rounded-lg border border-amber-200 bg-white p-3">
							<p class="text-xs text-slate-500">{label}</p>
							<p class="mt-1 font-bold text-slate-900">{formatoValorEstatico(key, gobernador.metrics[key as keyof typeof gobernador.metrics])}</p>
						</div>
					))}
				</div>
			</section>
		)}

		<section class="mt-14">
			<h2 class="text-xl font-semibold text-slate-900">Ranking — Consejeros Regionales</h2>
			<div id="metricas" class="mt-3 flex flex-wrap gap-2"></div>
			<p id="metrica-definicion" class="mt-2 max-w-2xl text-sm text-slate-500"></p>

			<div id="chart" class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"></div>

			<div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
				<table class="w-full text-sm">
					<thead id="tabla-head" class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase"></thead>
					<tbody id="tabla-body" class="divide-y divide-slate-100"></tbody>
				</table>
			</div>
		</section>

		<section class="mt-14">
			<h2 class="text-xl font-semibold text-slate-900">Acuerdos recientes</h2>
			<p class="mt-1 max-w-2xl text-base text-slate-500">
				Sobre los {votacionesCore.length} acuerdos registrados de los últimos 45 días
				({acuerdosRechazados === 0 ? 'ninguno fue rechazado en este período' : `${acuerdosRechazados} fueron rechazados`}).
			</p>
			{acuerdosCore.length === 0 && (
				<p class="mt-6 text-base text-slate-500">Todavía no hay acuerdos registrados.</p>
			)}
			<ul class="mt-6 grid gap-4 lg:grid-cols-2">
				{acuerdosCore.map((v) => {
					const unanime = esUnanime(v);
					return (
						<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<div class="flex items-center justify-between text-xs text-slate-500">
								<span>{v.fecha}{v.numero_sesion && ` · Sesión N°${v.numero_sesion}`}</span>
								<span class="font-medium text-emerald-600">
									{v.votos_favor} a favor
									{(v.votos_contra ?? 0) > 0 && ` / ${v.votos_contra} en contra`}
									{(v.abstenciones ?? 0) > 0 && ` / ${v.abstenciones} abstención`}
								</span>
							</div>
							<p class="mt-2 text-base text-slate-800">{v.descripcion}</p>
							{unanime ? (
								<p class="mt-3 text-xs text-slate-500">Aprobado por unanimidad.</p>
							) : (
								<ul class="mt-3 flex flex-wrap gap-2">
									{v.votos.map((voto) => (
										<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
											<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
												{nombreAutoridad(voto.autoridad_id)}
											</a>
											: {VOTO_LABEL[voto.voto] ?? voto.voto}
										</li>
									))}
								</ul>
							)}
							{v.fuente_url && (
								<a href={v.fuente_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline">
									Ver acuerdo completo
								</a>
							)}
						</li>
					);
				})}
			</ul>
		</section>
	</main>

	<script type="application/json" id="grupo-data" set:html={JSON.stringify(grupo)} />
	<script type="application/json" id="metricas-data" set:html={JSON.stringify(METRICAS)} />

	<script>
		interface Item {
			id: string;
			nombre: string;
			metrics: Record<string, number | null>;
		}

		const grupo: Item[] = JSON.parse(document.getElementById('grupo-data')!.textContent!);
		const METRICAS: [string, string][] = JSON.parse(document.getElementById('metricas-data')!.textContent!);

		const DEFINICIONES: Record<string, string> = {
			participacionPct:
				'% de votaciones en las que emitió un voto real (a favor, en contra, abstención o pareo). No aparecer en una votación cuenta como no participada.',
			alineamientoPct:
				'De sus votos a favor o en contra, % que coincidió con el resultado final de la votación (si se aprobó o se rechazó).',
			favor: 'Cantidad de votaciones en las que votó a favor.',
			abstencion: 'Cantidad de votaciones en las que se abstuvo.',
			ausente: 'Cantidad de acuerdos a los que no asistió o en los que no emitió voto.',
			inhabilitado: 'Cantidad de acuerdos en los que se inhabilitó por conflicto de interés.',
		};

		function esPct(metricKey: string) {
			return metricKey.endsWith('Pct');
		}

		function formatoValor(metricKey: string, valor: number | null) {
			if (valor === null) return 'Sin datos comparables';
			return esPct(metricKey) ? `${valor.toFixed(1)}%` : String(valor);
		}

		let metricaActiva = METRICAS[0][0];

		function renderMetricas() {
			const cont = document.getElementById('metricas')!;
			cont.innerHTML = METRICAS.map(
				([key, label]) =>
					`<button type="button" data-metrica="${key}" class="metrica-btn cursor-pointer rounded-full px-3 py-1 text-xs font-medium ${
						key === metricaActiva ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
					}">${label}</button>`
			).join('');
			cont.querySelectorAll<HTMLButtonElement>('.metrica-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					metricaActiva = btn.dataset.metrica!;
					renderMetricas();
					render();
				});
			});
			document.getElementById('metrica-definicion')!.textContent = DEFINICIONES[metricaActiva] ?? '';
		}

		function etiquetaNombre(i: Item) {
			return `<span class="min-w-0 truncate">${i.nombre}</span>`;
		}

		function render() {
			const ordenados = [...grupo].sort((a, b) => (b.metrics[metricaActiva] ?? -1) - (a.metrics[metricaActiva] ?? -1));
			const max = Math.max(...ordenados.map((i) => i.metrics[metricaActiva] ?? 0), 1);

			const chart = document.getElementById('chart')!;
			chart.innerHTML = ordenados
				.map((i) => {
					const valor = i.metrics[metricaActiva];
					const anchoPct = valor === null ? 0 : (valor / max) * 100;
					return `
						<div class="flex items-center gap-2 py-1.5 sm:gap-3">
							<a href="/autoridades/${i.id}/" class="flex w-24 shrink-0 items-center gap-1.5 text-sm text-slate-700 hover:text-brand-600 hover:underline sm:w-64">${etiquetaNombre(i)}</a>
							<div class="h-5 flex-1 rounded bg-slate-100">
								<div class="h-5 rounded bg-brand-600" style="width:${anchoPct}%"></div>
							</div>
							<span class="w-16 shrink-0 text-right text-sm font-medium text-slate-900 sm:w-32">${formatoValor(metricaActiva, valor)}</span>
						</div>`;
				})
				.join('');

			const head = document.getElementById('tabla-head')!;
			head.innerHTML =
				'<tr><th class="px-4 py-2">Nombre</th>' +
				METRICAS.map(([, label]) => `<th class="px-4 py-2 text-right">${label}</th>`).join('') +
				'</tr>';

			const body = document.getElementById('tabla-body')!;
			body.innerHTML = ordenados
				.map(
					(i) =>
						`<tr><td class="px-4 py-2.5"><a href="/autoridades/${i.id}/" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-brand-600 hover:underline">${etiquetaNombre(i)}</a></td>` +
						METRICAS.map(([key]) => `<td class="px-4 py-2.5 text-right text-slate-700">${formatoValor(key, i.metrics[key])}</td>`)
							.join('') +
						'</tr>'
				)
				.join('');
		}

		renderMetricas();
		render();
	</script>
</Layout>
