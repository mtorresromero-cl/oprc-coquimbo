---
import Layout from '../../layouts/Layout.astro';
import { votacionesCore, autoridades, VOTO_LABEL, indiceVotaciones } from '../../lib/datos';

function nombreAutoridad(id: string) {
	return autoridades.find((a) => a.id === id)?.nombre_completo ?? id;
}

const votacionesOrdenadas = [...votacionesCore].sort((a, b) => b.fecha.localeCompare(a.fecha));

function esUnanime(v: (typeof votacionesCore)[number]) {
	return v.votos.length > 0 && v.votos.every((voto) => voto.voto === 'favor');
}

const coreIds = autoridades.filter((a) => a.cargo === 'core' || a.cargo === 'gobernador').map((a) => a.id);
const indiceCore = indiceVotaciones(votacionesCore, coreIds).sort(
	(a, b) => b.participacionPct - a.participacionPct
);
const acuerdosRechazados = votacionesCore.filter((v) => v.resultado === 'rechazado').length;

function formatoPct(valor: number | null) {
	return valor === null ? '—' : `${valor.toFixed(1)}%`;
}
---

<Layout
	title="Consejo Regional (CORE) — OPRC"
	description="Votaciones del Consejo Regional de Coquimbo (CORE) y del gobernador regional."
>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Consejo Regional (CORE)</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				Votaciones de los 16 consejeros regionales y el gobernador de la Región de Coquimbo en
				los acuerdos del CORE, vía el buscador oficial de acuerdos. Se muestran los acuerdos de
				los últimos 45 días — el detalle completo de cada uno está disponible en la fuente oficial.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<section>
			<h2 class="text-xl font-semibold text-slate-900">Índice de participación</h2>
			<p class="mt-1 max-w-2xl text-sm text-slate-500">
				Sobre los {votacionesCore.length} acuerdos registrados
				({acuerdosRechazados === 0
					? 'ninguno fue rechazado en este período'
					: `${acuerdosRechazados} fueron rechazados`}).{' '}
				<strong>Participación</strong>: % de acuerdos con voto real (a favor, en contra o
				abstención). <strong>Alineamiento</strong>: de sus votos a favor/en contra, % que
				coincidió con el resultado final del acuerdo. No calculamos un puntaje único: mezclar
				participación y alineamiento requeriría ponderarlos de forma arbitraria.
			</p>
			<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
				<table class="w-full min-w-[640px] text-sm">
					<thead>
						<tr class="bg-slate-50 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
							<th class="px-4 py-2">Consejero/a</th>
							<th class="px-4 py-2 text-right">Participación</th>
							<th class="px-4 py-2 text-right">Alineamiento</th>
							<th class="px-4 py-2 text-right">A favor</th>
							<th class="px-4 py-2 text-right">Abstención</th>
							<th class="px-4 py-2 text-right">Ausente</th>
							<th class="px-4 py-2 text-right">Inhabilitado</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						{indiceCore.map((i) => (
							<tr>
								<td class="px-4 py-2.5">
									<a href={`/autoridades/${i.autoridad_id}/`} class="font-medium text-slate-900 hover:text-brand-600 hover:underline">
										{i.nombre}
									</a>
								</td>
								<td class="px-4 py-2.5 text-right font-medium text-slate-900">{formatoPct(i.participacionPct)}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{formatoPct(i.alineamientoPct)}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.favor}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.abstencion}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.ausente}</td>
								<td class="px-4 py-2.5 text-right text-slate-700">{i.inhabilitado}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<h2 class="mt-14 text-xl font-semibold text-slate-900">Acuerdos recientes</h2>

		{votacionesOrdenadas.length === 0 && (
			<p class="text-sm text-slate-500">Todavía no hay acuerdos registrados.</p>
		)}

		<ul class="mt-6 grid gap-4 lg:grid-cols-2">
			{votacionesOrdenadas.map((v) => {
				const unanime = esUnanime(v);
				return (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="flex items-center justify-between text-xs text-slate-500">
							<span>{v.fecha}{v.numero_sesion && ` · Sesión N°${v.numero_sesion}`}</span>
							<span class="font-medium text-emerald-600">
								{v.votos_favor} a favor
								{(v.votos_contra ?? 0) > 0 && ` / ${v.votos_contra} en contra`}
								{(v.abstenciones ?? 0) > 0 && ` / ${v.abstenciones} abstención`}
							</span>
						</div>
						<p class="mt-2 text-sm text-slate-800">{v.descripcion}</p>
						{unanime ? (
							<p class="mt-3 text-xs text-slate-500">Aprobado por unanimidad.</p>
						) : (
							<ul class="mt-3 flex flex-wrap gap-2">
								{v.votos.map((voto) => (
									<li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">
										<a href={`/autoridades/${voto.autoridad_id}/`} class="font-medium hover:text-brand-600 hover:underline">
											{nombreAutoridad(voto.autoridad_id)}
										</a>
										: {VOTO_LABEL[voto.voto] ?? voto.voto}
									</li>
								))}
							</ul>
						)}
						{v.fuente_url && (
							<a
								href={v.fuente_url}
								target="_blank"
								rel="noopener"
								class="mt-3 inline-block text-xs text-slate-400 hover:text-brand-600 hover:underline"
							>
								Ver acuerdo completo
							</a>
						)}
					</li>
				);
			})}
		</ul>
	</main>
</Layout>
