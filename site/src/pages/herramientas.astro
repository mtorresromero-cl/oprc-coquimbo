---
import Layout from '../layouts/Layout.astro';

const recursos = [
	{
		titulo: 'Guía de Fiscalización Ciudadana',
		descripcion:
			'Recurso educativo orientado al monitoreo y evaluación del desempeño de autoridades locales y regionales, para ejercer tu derecho a la transparencia y el control ciudadano.',
		tipo: 'PDF',
		url: '/docs/guia-fiscalizacion-ciudadana.pdf',
	},
];
---

<Layout
	title="Herramientas — OPRC"
	description="Guías, recursos y explicaciones para entender y participar en los procesos políticos de la Región de Coquimbo."
>
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Herramientas</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				En esta sección encontrarás guías, recursos y explicaciones claras para entender y
				participar activamente en los procesos políticos de la Región de Coquimbo: seguimiento de
				autoridades, análisis electoral y proyectos legislativos, con énfasis en ejercer derechos
				de transparencia y supervisión ciudadana.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-14">
		{recursos.map((r) => (
			<div class="mx-auto max-w-2xl rounded-xl border border-slate-200 bg-white p-8 shadow-sm sm:flex sm:items-start sm:gap-6">
				<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
						<path d="M14 3v5a2 2 0 0 0 2 2h5M6 3h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
						<path d="M9 13h6M9 17h4"></path>
					</svg>
				</div>
				<div class="mt-5 sm:mt-0">
					<span class="inline-block rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
						{r.tipo}
					</span>
					<h2 class="mt-3 text-lg font-semibold text-slate-900">{r.titulo}</h2>
					<p class="mt-2 leading-relaxed text-slate-600">{r.descripcion}</p>
					<a
						href={r.url}
						target="_blank"
						rel="noopener"
						class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
					>
						Descargar guía
					</a>
				</div>
			</div>
		))}
	</main>
</Layout>
