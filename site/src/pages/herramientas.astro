---
import Layout from '../layouts/Layout.astro';

const recursos = [
	{
		titulo: 'Guía de Fiscalización Ciudadana',
		descripcion:
			'Recurso educativo orientado al monitoreo y evaluación del desempeño de autoridades locales y regionales, para ejercer tu derecho a la transparencia y el control ciudadano.',
		tipo: 'PDF',
		url: '/docs/guia-fiscalizacion-ciudadana.pdf',
	},
];

const interactivas = [
	{
		titulo: '¿Quién me representa?',
		descripcion:
			'Elige tu comuna y mira de una vez a tu alcalde/sa, concejales, consejero/a regional, diputados, senadores y el gobernador regional.',
		url: '/herramientas/quien-me-representa/',
		icono: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
	},
	{
		titulo: 'Archivo Electoral',
		descripcion:
			'Resultados candidato por candidato, participación, plebiscitos, historia por comuna, comparador y padrón — todo lo que sabemos de las elecciones desde 1989.',
		url: '/herramientas/electoral/',
		icono: 'M21 8v13H3V8 M1 3h22v5H1Z M10 12h4',
	},
	{
		titulo: 'Comparador',
		descripcion:
			'Un duelo cara a cara entre 2 diputados o senadores de la región, o una tabla de hasta 3: asistencia, votaciones, alineamiento y mociones.',
		url: '/parlamentarios/comparador/',
		icono: 'M8 3 4 7l4 4 M4 7h16 M16 21l4-4-4-4 M20 17H4',
	},
];

// Categorías reales que ya puedes fiscalizar con los datos del sitio (no es
// contenido decorativo inventado: cada una enlaza a datos que existen hoy).
const fiscaliza = [
	{ icono: 'presupuesto', titulo: 'Presupuesto municipal', href: '/municipios/' },
	{ icono: 'votaciones', titulo: 'Votaciones y acuerdos', href: '/parlamentarios/' },
	{ icono: 'asistencia', titulo: 'Asistencia a sesiones', href: '/parlamentarios/' },
	{ icono: 'patrimonio', titulo: 'Declaraciones patrimoniales', href: '/autoridades/' },
];

const ICONOS_FISCALIZA: Record<string, string> = {
	presupuesto: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
	votaciones: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
	asistencia: 'M16 2v4M8 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z',
	patrimonio: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6',
};
---

<Layout
	title="Herramientas — OPRC"
	description="Guías, recursos y explicaciones para entender y participar en los procesos políticos de la Región de Coquimbo."
>
	<section class="relative overflow-hidden bg-slate-900">
		<div class="pointer-events-none absolute -right-32 -top-32 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-40 left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-800/30 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-20">
			<div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-center">
				<div>
					<p class="text-sm font-semibold tracking-widest text-brand-300 uppercase">Herramientas</p>
					<h1 class="mt-4 max-w-xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
						Herramientas
					</h1>
					<p class="mt-5 max-w-xl text-lg text-slate-300">
						Guías, recursos y explicaciones claras para entender y participar activamente en los
						procesos políticos de la Región de Coquimbo, con énfasis en ejercer derechos de
						transparencia y supervisión ciudadana.
					</p>
				</div>

				<div class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
					<p class="text-xs font-semibold tracking-wide text-brand-300 uppercase">Ya puedes fiscalizar</p>
					<ul class="mt-4 space-y-3">
						{fiscaliza.map((f) => (
							<li>
								<a href={f.href} class="group flex items-center gap-3 text-sm text-slate-200 hover:text-white">
									<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-brand-300 group-hover:bg-white/15">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
											<path d={ICONOS_FISCALIZA[f.icono]}></path>
										</svg>
									</span>
									{f.titulo}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<main class="mx-auto max-w-6xl px-6 py-14">
		<h2 class="text-xl font-semibold text-slate-900">Herramientas interactivas</h2>
		<div class="mt-4 grid gap-6 sm:grid-cols-2">
			{interactivas.map((h) => (
				<a
					href={h.url}
					class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md sm:flex sm:items-start sm:gap-5"
				>
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d={h.icono}></path>
						</svg>
					</div>
					<div class="mt-4 sm:mt-0">
						<h3 class="font-semibold text-slate-900 group-hover:text-brand-700">{h.titulo}</h3>
						<p class="mt-2 text-base leading-relaxed text-slate-600">{h.descripcion}</p>
						<span class="mt-4 inline-block text-sm font-semibold text-brand-600">Abrir herramienta &rarr;</span>
					</div>
				</a>
			))}
		</div>

		<h2 class="mt-14 text-xl font-semibold text-slate-900">Guías descargables</h2>
		<div class="mt-4 grid gap-6 sm:grid-cols-2">
			{recursos.map((r) => (
				<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:flex sm:items-start sm:gap-5">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
							<path d="M14 3v5a2 2 0 0 0 2 2h5M6 3h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
							<path d="M9 13h6M9 17h4"></path>
						</svg>
					</div>
					<div class="mt-4 sm:mt-0">
						<span class="inline-block rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
							{r.tipo}
						</span>
						<h2 class="mt-3 font-semibold text-slate-900">{r.titulo}</h2>
						<p class="mt-2 text-base leading-relaxed text-slate-600">{r.descripcion}</p>
						<a
							href={r.url}
							target="_blank"
							rel="noopener"
							class="mt-4 inline-flex items-center gap-1.5 rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
						>
							Descargar guía
						</a>
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>
