---
import Layout from '../layouts/Layout.astro';

const redes = [
	{ nombre: 'Instagram', url: 'https://instagram.com/oprcoquimbo' },
	{ nombre: 'Facebook', url: 'https://facebook.com/oprcoquimbo' },
	{ nombre: 'Twitter', url: 'https://twitter.com/oprcoquimbo' },
];
---

<Layout title="Contacto — OPRC" description="Contacto del Observatorio Político Región de Coquimbo.">
	<main class="mx-auto max-w-xl px-6 py-12">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900">Contacto</h1>
		<p class="mt-3 text-slate-700">
			Brindamos información y herramientas de análisis, seguimiento e investigación en materia
			política, trabajo de autoridades, elecciones y partidos políticos de la Región de Coquimbo.
		</p>

		<div class="mt-8 rounded-lg border border-slate-200 p-5">
			<p class="text-sm text-slate-500">Correo electrónico</p>
			<a href="mailto:contacto@oprcoquimbo.cl" class="text-lg font-semibold text-brand-600 hover:underline">
				contacto@oprcoquimbo.cl
			</a>
		</div>

		<div class="mt-4 flex gap-3">
			{redes.map((r) => (
				<a
					href={r.url}
					target="_blank"
					rel="noopener"
					class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900 hover:border-brand-300 hover:bg-brand-50"
				>
					{r.nombre}
				</a>
			))}
		</div>
	</main>
</Layout>
