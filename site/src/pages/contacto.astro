---
import Layout from '../layouts/Layout.astro';

const redes = [
	{ nombre: 'Instagram', url: 'https://instagram.com/oprcoquimbo' },
	{ nombre: 'Facebook', url: 'https://facebook.com/oprcoquimbo' },
	{ nombre: 'Twitter', url: 'https://twitter.com/oprcoquimbo' },
];
---

<Layout title="Contacto — OPRC" description="Contacto del Observatorio Político Región de Coquimbo.">
	<div class="border-b border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900">Contacto</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				Brindamos información y herramientas de análisis, seguimiento e investigación en materia
				política, trabajo de autoridades, elecciones y partidos políticos de la Región de Coquimbo.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-10">
		<div class="grid gap-4 sm:grid-cols-2 lg:max-w-2xl">
			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:col-span-2">
				<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Correo electrónico</p>
				<a href="mailto:contacto@oprcoquimbo.cl" class="mt-2 block text-xl font-bold text-brand-600 hover:underline">
					contacto@oprcoquimbo.cl
				</a>
			</div>
			{redes.map((r) => (
				<a
					href={r.url}
					target="_blank"
					rel="noopener"
					class="rounded-xl border border-slate-200 bg-white p-4 text-center font-medium text-slate-900 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
				>
					{r.nombre}
				</a>
			))}
		</div>
	</main>
</Layout>
