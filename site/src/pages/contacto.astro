---
import Layout from '../layouts/Layout.astro';

const redes = [
	{ nombre: 'Instagram', url: 'https://instagram.com/oprcoquimbo' },
	{ nombre: 'Facebook', url: 'https://facebook.com/oprcoquimbo' },
	{ nombre: 'Twitter', url: 'https://twitter.com/oprcoquimbo' },
];

// Público por diseño (Cloudflare Turnstile funciona con un site key
// visible en el HTML, la clave privada vive solo en la Function).
const TURNSTILE_SITE_KEY = '0x4AAAAAAEcSbMqJvOAlX1zo';
---

<Layout title="Contacto — OPRC" description="Escríbenos al Observatorio Político Región de Coquimbo.">
	<div class="relative overflow-hidden bg-brand-50">
		<div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-brand-100/70 blur-3xl"></div>
		<div class="relative mx-auto max-w-6xl px-6 py-16">
			<p class="text-sm font-semibold tracking-widest text-brand-600 uppercase">Contacto</p>
			<h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
				¿Tienes un dato, una alerta o una consulta?
			</h1>
			<p class="mt-4 max-w-xl text-lg text-slate-600">
				Escríbenos. Ya sea una corrección a un dato, una idea para el observatorio o algo que
				creas que deberíamos estar mirando en tu comuna — te leemos.
			</p>
		</div>
	</div>

	<main class="mx-auto max-w-6xl px-6 py-14">
		<div class="grid gap-12 lg:grid-cols-[1fr_22rem]">
			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
				<form id="form-contacto">
					<h2 class="text-lg font-semibold text-slate-900">Escríbenos</h2>
					<p class="mt-1 text-sm text-slate-500">
						Si tienes problemas con el formulario, escríbenos directo a{' '}
						<a href="mailto:contacto@oprcoquimbo.cl" class="font-medium text-brand-600 hover:underline">contacto@oprcoquimbo.cl</a>.
					</p>

					<div class="mt-6 grid gap-5 sm:grid-cols-2">
						<div>
							<label for="nombre" class="block text-sm font-medium text-slate-700">Tu nombre</label>
							<input
								type="text"
								name="nombre"
								id="nombre"
								required
								class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
							/>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-slate-700">Tu correo electrónico</label>
							<input
								type="email"
								name="email"
								id="email"
								required
								class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
							/>
						</div>
						<div class="sm:col-span-2">
							<label for="asunto" class="block text-sm font-medium text-slate-700">Asunto</label>
							<input
								type="text"
								name="asunto"
								id="asunto"
								required
								class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
							/>
						</div>
						<div class="sm:col-span-2">
							<label for="mensaje" class="block text-sm font-medium text-slate-700">Tu mensaje</label>
							<textarea
								name="mensaje"
								id="mensaje"
								rows="5"
								required
								class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
							></textarea>
						</div>
					</div>

					<div class="cf-turnstile mt-5" data-sitekey={TURNSTILE_SITE_KEY}></div>

					<p id="form-error" class="mt-4 hidden text-sm font-medium text-red-600"></p>

					<button
						id="form-submit"
						type="submit"
						class="mt-6 inline-flex items-center rounded-md bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
					>
						Enviar mensaje
					</button>
				</form>

				<div id="form-exito" class="hidden py-6 text-center">
					<p class="text-lg font-semibold text-slate-900">¡Gracias! Tu mensaje fue enviado.</p>
					<p class="mt-1 text-sm text-slate-500">Te vamos a responder al correo que dejaste.</p>
				</div>
			</div>

			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			<script>
				const form = document.getElementById('form-contacto') as HTMLFormElement;
				const boton = document.getElementById('form-submit') as HTMLButtonElement;
				const error = document.getElementById('form-error')!;
				const exito = document.getElementById('form-exito')!;

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					error.classList.add('hidden');
					boton.disabled = true;
					boton.textContent = 'Enviando…';

					try {
						const resp = await fetch('/api/contacto', { method: 'POST', body: new FormData(form) });
						const datos = await resp.json();
						if (resp.ok && datos.ok) {
							form.classList.add('hidden');
							exito.classList.remove('hidden');
						} else {
							throw new Error(datos.error || 'error desconocido');
						}
					} catch (err) {
						error.textContent = 'No se pudo enviar el mensaje. Intenta de nuevo o escríbenos directo a contacto@oprcoquimbo.cl.';
						error.classList.remove('hidden');
						boton.disabled = false;
						boton.textContent = 'Enviar mensaje';
						console.error(err);
					}
				});
			</script>

			<aside class="space-y-6">
				<img
					src="/contacto-ilustracion.jpg"
					alt="Ilustración de personas revisando documentos y datos"
					class="w-full rounded-2xl"
				/>

				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Correo electrónico</p>
					<a href="mailto:contacto@oprcoquimbo.cl" class="mt-2 block text-lg font-bold text-brand-600 hover:underline">
						contacto@oprcoquimbo.cl
					</a>
				</div>

				<div class="grid grid-cols-3 gap-3">
					{redes.map((r) => (
						<a
							href={r.url}
							target="_blank"
							rel="noopener"
							class="rounded-xl border border-slate-200 bg-white p-3 text-center text-sm font-medium text-slate-900 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
						>
							{r.nombre}
						</a>
					))}
				</div>
			</aside>
		</div>
	</main>
</Layout>
